+    /// <summary>
+    /// Bottom-left build version so players can tell Mega / Probe / patched installs apart.
+    /// Uses <see cref="Application.version"/> (Player Settings), not a hardcoded string.
+    /// </summary>
+    private void CreateBuildVersionLabel(RectTransform canvasRt)
+    {
+        if (canvasRt == null)
+            return;
+
+        Transform existing = canvasRt.Find("BuildVersionLabel");
+        if (existing != null)
+            Destroy(existing.gameObject);
+
+        string appVersion = Application.version;
+        if (string.IsNullOrWhiteSpace(appVersion))
+            appVersion = ManafallIdentity.Version;
+
+        string lastApplied = PlayerPrefs.GetString("Manafall.Patch.LastApplied", string.Empty).Trim();
+        string label = "v" + appVersion.Trim();
+        if (!string.IsNullOrEmpty(lastApplied)
+            && !string.Equals(lastApplied, appVersion.Trim(), System.StringComparison.OrdinalIgnoreCase))
+        {
+            label += "  (patched " + lastApplied + ")";
+        }
+
+#if DEVELOPMENT_BUILD
+        label += "  DEV";
+#endif
+
+        var go = new GameObject("BuildVersionLabel", typeof(RectTransform));
+        go.transform.SetParent(canvasRt, false);
+        RectTransform rt = go.GetComponent<RectTransform>();
+        rt.anchorMin = new Vector2(0f, 0f);
+        rt.anchorMax = new Vector2(0f, 0f);
+        rt.pivot = new Vector2(0f, 0f);
+        rt.anchoredPosition = new Vector2(touchMenu ? 18f : 24f, touchMenu ? 14f : 18f);
+        rt.sizeDelta = new Vector2(touchMenu ? 420f : 520f, touchMenu ? 28f : 26f);
+
+        TextMeshProUGUI tmp = go.AddComponent<TextMeshProUGUI>();
+        tmp.text = label;
+        tmp.fontSize = touchMenu ? 18f : 16f;
+        tmp.alignment = TextAlignmentOptions.Left;
+        tmp.color = new Color(1f, 0.96f, 0.86f, 0.72f);
+        tmp.raycastTarget = false;
+        if (TMP_Settings.defaultFontAsset != null)
+            tmp.font = TMP_Settings.defaultFontAsset;
+
+        Debug.Log("[MainMenu] Build version label: " + label
+            + "  identity=" + ManafallIdentity.Version
+            + "  unity=" + Application.unityVersion);
+    }
+
