@@ -0,0 +1,260 @@
+using System.Collections.Generic;
+using InventoryFramework;
+using Mirror;
+using UnityEngine;
+
+/// <summary>
+/// Druclad death loot. Every item is rolled by <see cref="MarketItemRarity"/> tier —
+/// Abundant/Common often, Epic almost never. Optional entry.weight overrides are multipliers only.
+/// </summary>
+[CreateAssetMenu(fileName = "DrucladLootTable", menuName = "Manafall/Creatures/Druclad Loot Table")]
+public sealed class DrucladLootTable : ScriptableObject
+{
+    private const string DefaultItemDatabasePath = "Assets/ScriptableObjects/Items/ManafallItemDatabase.asset";
+
+    [System.Serializable]
+    public struct Entry
+    {
+        public Item item;
+        [Tooltip("0 = use MarketItemRarity tier weight. >0 multiplies the tier weight.")]
+        [Min(0f)] public float weightMul;
+        [Min(1)] public int minAmount;
+        [Min(1)] public int maxAmount;
+    }
+
+    public struct ResolvedDrop
+    {
+        public Item item;
+        public int amount;
+    }
+
+    private struct WeightedCandidate
+    {
+        public Item item;
+        public float weight;
+        public int minAmount;
+        public int maxAmount;
+    }
+
+    [Header("Boss-themed pool (tier from MarketItemRarity)")]
+    public Entry[] bossPool;
+    [Min(0)] public int minBossRolls = 2;
+    [Min(0)] public int maxBossRolls = 4;
+
+    [Header("Bonus generic rolls (also tier-weighted)")]
+    public bool includeGenericTier = true;
+    public ItemDatabase itemDatabase;
+    [Min(0)] public int minGenericRolls = 1;
+    [Min(0)] public int maxGenericRolls = 2;
+    [Tooltip("Highest tier allowed in the generic bonus pool.")]
+    public MarketItemRarity.Tier maxGenericTier = MarketItemRarity.Tier.Rare;
+    [Min(1)] public int genericMinAmount = 1;
+    [Min(1)] public int genericMaxAmount = 2;
+
+    [Header("Spread")]
+    [Min(0.08f)] public float dropSpacing = 0.65f;
+
+    public bool TrySpawnDrops(Transform origin, GameObject lootBagPrefab)
+    {
+        if (origin == null || lootBagPrefab == null)
+            return false;
+
+        bool networked = NetworkServer.active || NetworkClient.active;
+        if (networked && !NetworkServer.active)
+            return false;
+
+        CreatureLevelLootScaling.Context ctx = CreatureLevelLootScaling.Begin(origin);
+        IReadOnlyList<ResolvedDrop> drops = RollDrops();
+        Vector3 dropOrigin = origin.position + Vector3.up * 0.12f;
+        int dropIndex = 0;
+
+        for (int i = 0; i < drops.Count; i++)
+        {
+            ResolvedDrop drop = drops[i];
+            if (drop.item == null || drop.amount <= 0)
+                continue;
+
+            float angle = (360f / Mathf.Max(1, drops.Count)) * dropIndex;
+            Vector3 offset = Quaternion.Euler(0f, angle, 0f) * Vector3.forward * dropSpacing;
+            CreatureLevelLootScaling.TrySpawnDrop(
+                ref ctx,
+                lootBagPrefab,
+                drop.item,
+                drop.amount,
+                dropOrigin + offset,
+                origin);
+            dropIndex++;
+        }
+
+        bool finishedLoot = CreatureLevelLootScaling.TryFinishDeathLoot(ref ctx, origin, lootBagPrefab);
+        return dropIndex > 0 || finishedLoot;
+    }
+
+    public IReadOnlyList<ResolvedDrop> RollDrops()
+    {
+        var results = new List<ResolvedDrop>(8);
+        var pickedIds = new HashSet<int>();
+        MarketCatalog catalog = MarketCatalog.Resolve(null);
+
+        RollBossPool(pickedIds, results);
+        if (includeGenericTier)
+            RollGenericByTier(catalog, pickedIds, results);
+
+        return results;
+    }
+
+    private void RollBossPool(HashSet<int> pickedIds, List<ResolvedDrop> outDrops)
+    {
+        if (bossPool == null || bossPool.Length == 0)
+            return;
+
+        var candidates = new List<WeightedCandidate>(bossPool.Length);
+        for (int i = 0; i < bossPool.Length; i++)
+        {
+            Entry row = bossPool[i];
+            if (row.item == null || row.item.id <= 0 || pickedIds.Contains(row.item.id))
+                continue;
+
+            float mul = row.weightMul > 0.001f ? row.weightMul : 1f;
+            float weight = ItemLootRarity.ResolveLootWeight(row.item, relativeMul: mul);
+            if (weight <= 0.001f)
+                continue;
+
+            int lo = Mathf.Max(1, Mathf.Min(row.minAmount, row.maxAmount));
+            int hi = Mathf.Max(lo, Mathf.Max(row.minAmount, row.maxAmount));
+            candidates.Add(new WeightedCandidate
+            {
+                item = row.item,
+                weight = weight,
+                minAmount = lo,
+                maxAmount = hi,
+            });
+        }
+
+        PickDistinct(candidates, minBossRolls, maxBossRolls, pickedIds, outDrops);
+    }
+
+    private void RollGenericByTier(MarketCatalog catalog, HashSet<int> pickedIds, List<ResolvedDrop> outDrops)
+    {
+        ItemDatabase db = ResolveItemDatabase();
+        if (db?.items == null || db.items.Count == 0)
+            return;
+
+        var candidates = new List<WeightedCandidate>(64);
+        for (int i = 0; i < db.items.Count; i++)
+        {
+            Item item = db.items[i];
+            if (item == null || item.id <= 0 || pickedIds.Contains(item.id))
+                continue;
+            if (IsDrucladThemed(item))
+                continue;
+            if (!ItemLootRarity.CanDropFromCreatureBonusLoot(item, catalog))
+                continue;
+
+            MarketItemRarity.Profile profile = MarketItemRarity.GetProfile(item);
+            if (profile.Tier > maxGenericTier)
+                continue;
+
+            float weight = ItemLootRarity.ResolveLootWeight(item);
+            if (weight <= 0.001f)
+                continue;
+
+            int maxAmount = Mathf.Max(1, Mathf.Min(genericMaxAmount, item.maxStack));
+            int minAmount = Mathf.Clamp(genericMinAmount, 1, maxAmount);
+            candidates.Add(new WeightedCandidate
+            {
+                item = item,
+                weight = weight,
+                minAmount = minAmount,
+                maxAmount = maxAmount,
+            });
+        }
+
+        PickDistinct(candidates, minGenericRolls, maxGenericRolls, pickedIds, outDrops);
+    }
+
+    private static void PickDistinct(
+        List<WeightedCandidate> candidates,
+        int minRolls,
+        int maxRolls,
+        HashSet<int> pickedIds,
+        List<ResolvedDrop> outDrops)
+    {
+        if (candidates.Count == 0)
+            return;
+
+        int lo = Mathf.Clamp(minRolls, 0, candidates.Count);
+        int hi = Mathf.Clamp(Mathf.Max(minRolls, maxRolls), 0, candidates.Count);
+        int picks = Random.Range(lo, hi + 1);
+
+        for (int pick = 0; pick < picks; pick++)
+        {
+            int index = PickWeightedIndex(candidates);
+            if (index < 0)
+                break;
+
+            WeightedCandidate chosen = candidates[index];
+            candidates.RemoveAt(index);
+            pickedIds.Add(chosen.item.id);
+
+            int amount = Random.Range(chosen.minAmount, chosen.maxAmount + 1);
+            if (amount <= 0)
+                continue;
+
+            outDrops.Add(new ResolvedDrop { item = chosen.item, amount = amount });
+        }
+    }
+
+    private static int PickWeightedIndex(List<WeightedCandidate> candidates)
+    {
+        float total = 0f;
+        for (int i = 0; i < candidates.Count; i++)
+            total += candidates[i].weight;
+
+        if (total <= 0f)
+            return -1;
+
+        float roll = Random.Range(0f, total);
+        float cumulative = 0f;
+        for (int i = 0; i < candidates.Count; i++)
+        {
+            cumulative += candidates[i].weight;
+            if (roll <= cumulative)
+                return i;
+        }
+
+        return candidates.Count - 1;
+    }
+
+    private static bool IsDrucladThemed(Item item)
+    {
+        if (item == null)
+            return false;
+        string n = item.itemName ?? string.Empty;
+        return n.IndexOf("druclad", System.StringComparison.OrdinalIgnoreCase) >= 0
+               || n.IndexOf("abyss", System.StringComparison.OrdinalIgnoreCase) >= 0
+               || n.IndexOf("abyssal", System.StringComparison.OrdinalIgnoreCase) >= 0
+               || n.IndexOf("void cinder", System.StringComparison.OrdinalIgnoreCase) >= 0;
+    }
+
+    private ItemDatabase ResolveItemDatabase()
+    {
+        if (itemDatabase != null)
+            return itemDatabase;
+
+#if UNITY_EDITOR
+        itemDatabase = UnityEditor.AssetDatabase.LoadAssetAtPath<ItemDatabase>(DefaultItemDatabasePath);
+        if (itemDatabase != null)
+            return itemDatabase;
+#endif
+
+        ItemDatabase[] all = Resources.FindObjectsOfTypeAll<ItemDatabase>();
+        for (int i = 0; i < all.Length; i++)
+        {
+            if (all[i] != null && all[i].name.IndexOf("Manafall", System.StringComparison.OrdinalIgnoreCase) >= 0)
+                return all[i];
+        }
+
+        return all.Length > 0 ? all[0] : null;
+    }
+}
