diff --git a/Assets/Scripts/Creatures/Druclad/DrucladFirePresentation.cs b/Assets/Scripts/Creatures/Druclad/DrucladFirePresentation.cs
new file mode 100644
index 000000000..2eb7c8ef2
--- /dev/null
+++ b/Assets/Scripts/Creatures/Druclad/DrucladFirePresentation.cs
@@ -0,0 +1,320 @@
+using InventoryFramework;
+using UnityEngine;
+
+/// <summary>
+/// Hellhound-style body fire for Druclad: persistent flames scale with HP, flare on roar/hurt/attacks.
+/// </summary>
+[DisallowMultipleComponent]
+public sealed class DrucladFirePresentation : MonoBehaviour
+{
+    public const string HellhoundBodyFirePrefabPath =
+        "Assets/GameObjects/Prefabs/VFX/HellhoundBodyFire.prefab";
+    public const string EmbeddedChildName = "DrucladBodyFire";
+
+    [Header("Anchors")]
+    [SerializeField] private Transform bodyAnchor;
+    [SerializeField] private AudioSource bodyAudio;
+
+    [Header("Fire VFX")]
+    [Tooltip("Child on the Druclad prefab (preferred).")]
+    [SerializeField] private Transform bodyFireInstance;
+    [Tooltip("Usually the HellhoundBodyFire prefab, scaled up for the boss.")]
+    [SerializeField] private GameObject bodyFirePrefab;
+    [SerializeField] private Vector3 bodyFireLocalOffset = new Vector3(0f, 1.15f, 0.1f);
+    [SerializeField] private float bodyFireBaseScale = 1.85f;
+
+    [Header("Fire palette")]
+    [SerializeField] private Color healthyFireColor = new Color(1.4f, 0.68f, 0.16f, 1f);
+    [SerializeField] private Color woundedFireColor = new Color(1.05f, 0.3f, 0.05f, 1f);
+    [SerializeField] private Color dyingFireColor = new Color(0.48f, 0.12f, 0.04f, 1f);
+
+    [Header("Flares")]
+    [SerializeField] private float roarFlareDuration = 0.85f;
+    [SerializeField] private float attackFlareDuration = 0.55f;
+    [SerializeField] private float hurtFlareDuration = 0.9f;
+    [SerializeField] private float hurtFlareStrength = 1.5f;
+    [SerializeField] private float phaseEnrageFlareDuration = 1.15f;
+    [SerializeField] private float vocalPitchBoost = 0.18f;
+    [SerializeField] private float vocalVolumeBoost = 0.32f;
+
+    private Transform bodyFireRoot;
+    private DrucladBodyFireVfx bodyFireVfx;
+    private HellhoundBodyFireVfx hellhoundBodyFireVfx;
+    private Light bodyGlow;
+    private float healthRatio = 1f;
+    private float flareTimer;
+    private float flareStrength;
+    private float hurtFlareTimer;
+    private float hurtFlareStrengthActive;
+    private float enrageFlareTimer;
+    private float baseAudioPitch = 1f;
+    private float baseAudioVolume = 1f;
+    private bool bodyHidden;
+
+    public void Bind(Transform anchor, AudioSource audio)
+    {
+        bodyAnchor = anchor != null ? anchor : transform;
+        bodyAudio = audio;
+        if (bodyAudio != null)
+        {
+            baseAudioPitch = bodyAudio.pitch;
+            baseAudioVolume = bodyAudio.volume;
+        }
+
+        EnsureBuilt();
+    }
+
+    public void SetHealthRatio(float ratio) => healthRatio = Mathf.Clamp01(ratio);
+
+    public void TriggerRoarFlare()
+    {
+        flareTimer = roarFlareDuration;
+        flareStrength = 1f;
+        EnsureFireVisible();
+    }
+
+    public void TriggerAttackFlare()
+    {
+        flareTimer = Mathf.Max(flareTimer, attackFlareDuration);
+        flareStrength = Mathf.Max(flareStrength, 0.85f);
+        EnsureFireVisible();
+    }
+
+    public void TriggerHurtFlare()
+    {
+        hurtFlareTimer = hurtFlareDuration;
+        hurtFlareStrengthActive = hurtFlareStrength;
+        flareTimer = Mathf.Max(flareTimer, hurtFlareDuration * 0.85f);
+        flareStrength = Mathf.Max(flareStrength, hurtFlareStrength);
+        EnsureFireVisible();
+    }
+
+    public void TriggerPhaseEnrageFlare()
+    {
+        enrageFlareTimer = phaseEnrageFlareDuration;
+        TriggerRoarFlare();
+    }
+
+    public void BeginDeathSmolder()
+    {
+        healthRatio = 0f;
+        TriggerHurtFlare();
+        if (bodyFireRoot != null)
+        {
+            SpellFocusVefectsBridge.PlayFireCast(
+                bodyFireRoot.position,
+                Quaternion.identity,
+                bodyFireBaseScale * 1.1f);
+        }
+    }
+
+    private void Awake()
+    {
+        if (bodyAnchor == null)
+            bodyAnchor = transform;
+        EnsureBuilt();
+    }
+
+    private void Update()
+    {
+        float dt = Time.deltaTime;
+
+        if (flareTimer > 0f)
+        {
+            flareTimer -= dt;
+            flareStrength = Mathf.Clamp01(flareTimer / Mathf.Max(0.05f, roarFlareDuration));
+        }
+        else
+        {
+            flareStrength = 0f;
+        }
+
+        if (hurtFlareTimer > 0f)
+        {
+            hurtFlareTimer -= dt;
+            hurtFlareStrengthActive = hurtFlareStrength * Mathf.Clamp01(
+                hurtFlareTimer / Mathf.Max(0.05f, hurtFlareDuration));
+        }
+        else
+        {
+            hurtFlareStrengthActive = 0f;
+        }
+
+        if (enrageFlareTimer > 0f)
+            enrageFlareTimer -= dt;
+
+        if (!bodyHidden)
+            ApplyBodyFirePresentation();
+
+        ApplyAudioFlare();
+    }
+
+    private void ApplyBodyFirePresentation()
+    {
+        float combinedFlare = Mathf.Max(flareStrength, hurtFlareStrengthActive);
+        bool enrage = enrageFlareTimer > 0.01f;
+
+        if (bodyFireVfx != null)
+        {
+            bodyFireVfx.ApplyPresentation(healthRatio, combinedFlare, enrage);
+            return;
+        }
+
+        if (hellhoundBodyFireVfx != null)
+        {
+            hellhoundBodyFireVfx.ApplyPresentation(healthRatio, combinedFlare, enrage);
+            if (bodyFireRoot != null)
+                bodyFireRoot.localScale = Vector3.one * bodyFireBaseScale;
+            return;
+        }
+
+        Color baseCol = healthRatio > 0.55f
+            ? Color.Lerp(woundedFireColor, healthyFireColor, (healthRatio - 0.55f) / 0.45f)
+            : Color.Lerp(dyingFireColor, woundedFireColor, healthRatio / 0.55f);
+
+        float flareMul = 1f + combinedFlare * 1.7f;
+        if (enrage)
+            flareMul = Mathf.Max(flareMul, 1.9f);
+
+        float scale = bodyFireBaseScale * (0.55f + healthRatio * 0.7f) * flareMul;
+        if (bodyFireRoot != null)
+            bodyFireRoot.localScale = Vector3.one * scale;
+
+        if (bodyGlow != null)
+        {
+            bodyGlow.color = baseCol;
+            bodyGlow.intensity = (1.6f + healthRatio * 3.4f) * flareMul;
+            bodyGlow.range = 6f + healthRatio * 4f + (enrage ? 3f : 0f);
+        }
+    }
+
+    private void ApplyAudioFlare()
+    {
+        if (bodyAudio == null)
+            return;
+
+        bodyAudio.pitch = baseAudioPitch * (1f + flareStrength * vocalPitchBoost);
+        bodyAudio.volume = Mathf.Clamp01(baseAudioVolume * (1f + flareStrength * vocalVolumeBoost));
+    }
+
+    private void EnsureFireVisible()
+    {
+        if (bodyFireRoot != null && !bodyFireRoot.gameObject.activeSelf && !bodyHidden)
+            bodyFireRoot.gameObject.SetActive(true);
+    }
+
+    private void EnsureBuilt()
+    {
+        if (bodyFireRoot != null)
+            return;
+
+        Transform anchor = bodyAnchor != null ? bodyAnchor : transform;
+
+        if (TryUseEmbeddedBodyFire(anchor))
+        {
+            ApplyBaseScale();
+            return;
+        }
+
+        GameObject prefab = bodyFirePrefab;
+#if UNITY_EDITOR
+        if (prefab == null)
+            prefab = UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(HellhoundBodyFirePrefabPath);
+#endif
+        if (prefab == null)
+            prefab = Resources.Load<GameObject>("HellhoundBodyFire");
+
+        if (prefab != null)
+        {
+            GameObject fire = Instantiate(prefab, anchor);
+            fire.name = EmbeddedChildName;
+            bodyFireRoot = fire.transform;
+            bodyFireRoot.localPosition = bodyFireLocalOffset;
+            bodyFireRoot.localRotation = Quaternion.identity;
+            CacheBodyFireComponents(fire);
+            ApplyBaseScale();
+            EnsureDrucladDriver(fire);
+            return;
+        }
+
+        BuildFallbackFire(anchor);
+    }
+
+    private bool TryUseEmbeddedBodyFire(Transform anchor)
+    {
+        Transform embedded = bodyFireInstance;
+        if (embedded == null)
+        {
+            embedded = transform.Find(EmbeddedChildName);
+            if (embedded == null)
+                embedded = transform.Find("HellhoundBodyFire");
+            if (embedded == null && anchor != transform)
+            {
+                embedded = anchor.Find(EmbeddedChildName)
+                    ?? anchor.Find("HellhoundBodyFire");
+            }
+        }
+
+        if (embedded == null)
+            return false;
+
+        bodyFireRoot = embedded;
+        CacheBodyFireComponents(embedded.gameObject);
+        EnsureDrucladDriver(embedded.gameObject);
+        return true;
+    }
+
+    private void CacheBodyFireComponents(GameObject fire)
+    {
+        bodyFireVfx = fire.GetComponent<DrucladBodyFireVfx>();
+        hellhoundBodyFireVfx = fire.GetComponent<HellhoundBodyFireVfx>();
+        bodyGlow = fire.GetComponentInChildren<Light>(true);
+    }
+
+    private void EnsureDrucladDriver(GameObject fire)
+    {
+        if (bodyFireVfx != null)
+            return;
+
+        bodyFireVfx = fire.AddComponent<DrucladBodyFireVfx>();
+        hellhoundBodyFireVfx = null;
+        if (bodyGlow == null)
+            bodyGlow = fire.GetComponentInChildren<Light>(true);
+    }
+
+    private void ApplyBaseScale()
+    {
+        if (bodyFireRoot != null)
+            bodyFireRoot.localScale = Vector3.one * bodyFireBaseScale;
+    }
+
+    private void BuildFallbackFire(Transform anchor)
+    {
+        var fireGo = new GameObject(EmbeddedChildName);
+        bodyFireRoot = fireGo.transform;
+        bodyFireRoot.SetParent(anchor, false);
+        bodyFireRoot.localPosition = bodyFireLocalOffset;
+        bodyFireRoot.localRotation = Quaternion.identity;
+        bodyFireRoot.localScale = Vector3.one * bodyFireBaseScale;
+
+        var lightGo = new GameObject("BodyGlow");
+        lightGo.transform.SetParent(bodyFireRoot, false);
+        lightGo.transform.localPosition = new Vector3(0f, 0.4f, 0f);
+        bodyGlow = lightGo.AddComponent<Light>();
+        bodyGlow.type = LightType.Point;
+        bodyGlow.shadows = LightShadows.None;
+        bodyGlow.range = 8f;
+        bodyGlow.intensity = 3.2f;
+        bodyGlow.color = healthyFireColor;
+
+        bodyFireVfx = fireGo.AddComponent<DrucladBodyFireVfx>();
+
+        // Seed a few looping Vefects bursts as a stand-in when the Hellhound prefab is missing.
+        SpellFocusVefectsBridge.PlayFireCast(bodyFireRoot.position, Quaternion.identity, 1.2f);
+        CreatureHovlBridge.TryAttachLoop(
+            CreatureHovlId.Hellhound,
+            CreatureHovlPhase.Aura,
+            bodyFireRoot,
+            1.05f);
+    }
+}
