+    /// <summary>
+    /// 0–1 membership on the separate void island. Missing YAML still places one opposite the volcano.
+    /// </summary>
+    public static float SampleVoidDomain01(int worldX, int worldZ, int seed, BiomeSettings settings)
+    {
+        if (settings == null)
+            settings = DefaultSettings;
+
+        EnsureVoidSettingsDefaults(settings);
+        ResolveVoidLayout(settings, out Vector2 voidCenter, out float radius, out float strength);
+        if (strength <= 0.001f || radius <= 1f)
+            return 0f;
+
+        float edge = Mathf.Clamp(settings.voidDomainEdgeMeters <= 0.001f ? 36f : settings.voidDomainEdgeMeters, 10f, 80f);
+        float dx = worldX - voidCenter.x;
+        float dz = worldZ - voidCenter.y;
+        float dist = Mathf.Sqrt(dx * dx + dz * dz);
+        float outer = radius + edge * 0.35f;
+        float inner = Mathf.Max(0f, radius - edge);
+        // GLSL-style edge falloff — Mathf.SmoothStep is a lerp and zeros the disc center.
+        float membership = 1f - smoothstep(inner, outer, dist);
+        if (membership <= 0.001f)
+            return 0f;
+
+        // Only block paint that would still sit on the main landmass. The void center itself
+        // must never be zeroed — a stale / oversized islandRadius used to reject the pad.
+        float mainDx = worldX - s_islandCenter.x;
+        float mainDz = worldZ - s_islandCenter.y;
+        float mainDist = Mathf.Sqrt(mainDx * mainDx + mainDz * mainDz);
+        if (dist > radius * 0.35f && mainDist <= s_islandRadius * 0.98f)
+            return 0f;
+
+        return Mathf.Clamp01(membership * strength);
+    }
+
+    /// <summary>
+    /// Gravity scale at a world XZ: 1 outside the void, <see cref="BiomeSettings.voidGravityMultiplier"/>
