+float ManafallStarHash21(float2 p)
+{
+    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
+}
+
+// One sharp point-star layer. density = cells across spherical UV.
+// thresh = minimum hash to keep a star (lower = denser). radius = hard core size in cell space.
+half ManafallStarLayer(float2 uv, float density, float thresh, float radius, float intensity)
+{
+    float2 grid = uv * density;
+    float2 cell = floor(grid);
+    float2 f = frac(grid);
+    float h = ManafallStarHash21(cell);
+    float keep = saturate((h - thresh) / max(1e-3, 1.0 - thresh));
+    if (keep <= 0.0)
+        return 0.0h;
+
+    float2 offset = float2(
+        ManafallStarHash21(cell + float2(19.1, 7.3)),
+        ManafallStarHash21(cell + float2(3.7, 41.2)));
+    // Keep the disc inside the cell so adjacent cells do not clip into squares.
+    offset = 0.22 + offset * 0.56;
+
+    float dist = length(f - offset);
+    // Tight size range — wide variation made bright stars into soft halos.
+    float size = radius * lerp(0.85, 1.15, ManafallStarHash21(cell + float2(8.9, 2.1)));
+    float t = saturate(1.0 - dist / max(size, 1e-4));
+    // Hard core (pow 6) with a tiny secondary spike so gems still punch, not bloom.
+    float core = t * t * t;
+    core *= core;
+    float spike = saturate(1.0 - dist / max(size * 0.35, 1e-4));
+    spike = spike * spike * spike;
+
+    float mag = intensity * lerp(0.55, 1.0, ManafallStarHash21(cell + float2(5.5, 13.7)));
+    return (half)((core * 0.65 + spike * 0.35) * mag * keep);
