+    private static void RegisterItemInDatabase(StringBuilder log, Item item)
+    {
+        if (item == null)
+            return;
+
+        ItemDatabase db = AssetDatabase.LoadAssetAtPath<ItemDatabase>(ItemDatabasePath);
+        if (db == null)
+        {
+            log.AppendLine($"  WARN: ItemDatabase missing at {ItemDatabasePath}");
+            return;
+        }
+
+        if (db.items == null)
+            db.items = new List<Item>();
+
+        for (int i = db.items.Count - 1; i >= 0; i--)
+        {
+            if (db.items[i] == null)
+                db.items.RemoveAt(i);
+        }
+
+        bool already = false;
+        for (int i = 0; i < db.items.Count; i++)
+        {
+            Item existing = db.items[i];
+            if (existing == item || (existing != null && existing.id == item.id))
+            {
+                db.items[i] = item;
+                already = true;
+                break;
+            }
+        }
+
+        if (!already)
+        {
+            db.items.Add(item);
+            log.AppendLine($"  Registered item '{item.itemName}' (id={item.id}) in database.");
+        }
+
+        EditorUtility.SetDirty(db);
+    }
