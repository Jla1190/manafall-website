+    private static bool ChunkIsVoidFloatingIslandHost(
+        int seed,
+        Vector2Int chunkCoord,
+        int chunkSize,
+        FoliageSettings settings)
+    {
+        float cellSize = Mathf.Max(120f, settings.voidFloatingIslandCellSizeMeters);
+        float chance = Mathf.Clamp01(settings.voidFloatingIslandChunkSpawnChance);
+
+        float chunkCenterX = (chunkCoord.x + 0.5f) * chunkSize;
+        float chunkCenterZ = (chunkCoord.y + 0.5f) * chunkSize;
+        int cellX = Mathf.FloorToInt(chunkCenterX / cellSize);
+        int cellZ = Mathf.FloorToInt(chunkCenterZ / cellSize);
+
+        var cellRng = new System.Random(HashChunkSlot(seed, cellX, cellZ, 0, 7741));
+        if (cellRng.NextDouble() >= chance)
+            return false;
+
+        int chunksPerCell = Mathf.Max(1, Mathf.RoundToInt(cellSize / Mathf.Max(1, chunkSize)));
+        int hostLocalX = cellRng.Next(0, chunksPerCell);
+        int hostLocalZ = cellRng.Next(0, chunksPerCell);
+        int cellOriginChunkX = Mathf.FloorToInt((cellX * cellSize) / chunkSize);
+        int cellOriginChunkZ = Mathf.FloorToInt((cellZ * cellSize) / chunkSize);
+        int hostChunkX = cellOriginChunkX + hostLocalX;
+        int hostChunkZ = cellOriginChunkZ + hostLocalZ;
+        return chunkCoord.x == hostChunkX && chunkCoord.y == hostChunkZ;
+    }
