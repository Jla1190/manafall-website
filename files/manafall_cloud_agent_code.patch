diff --git a/Assets/Scripts/Disease/PlayerDiseaseRuntime.cs b/Assets/Scripts/Disease/PlayerDiseaseRuntime.cs
new file mode 100644
index 000000000..309a940ef
--- /dev/null
+++ b/Assets/Scripts/Disease/PlayerDiseaseRuntime.cs
@@ -0,0 +1,428 @@
+using System;
+using System.Text;
+using Mirror;
+using UnityEngine;
+
+/// <summary>
+/// Server/offline-authoritative active disease set (up to <see cref="DiseaseCatalog.MaxConcurrent"/>).
+/// </summary>
+[DisallowMultipleComponent]
+public sealed class PlayerDiseaseRuntime : MonoBehaviour
+{
+    private const float TickIntervalSeconds = 0.5f;
+
+    [Serializable]
+    public struct ActiveDisease
+    {
+        public DiseaseId Id;
+        public float ExpiresAt;
+    }
+
+    [Serializable]
+    public struct SaveSnapshot
+    {
+        public byte[] ids;
+        public float[] remainingSeconds;
+    }
+
+    private readonly ActiveDisease[] slots = new ActiveDisease[DiseaseCatalog.MaxConcurrent];
+    private int count;
+    private float nextTickAt;
+    private bool hudSickTint;
+
+    private PlayerHealth health;
+    private FPSStamina stamina;
+    private PlayerHunger hunger;
+    private PlayerWetnessSystem wetness;
+    private ActiveHotbarConsume hotbarConsume;
+    private WorldGenerator worldGenerator;
+
+    public int ActiveCount => count;
+    public bool HasAny => count > 0;
+
+    public static PlayerDiseaseRuntime EnsureOn(GameObject player)
+    {
+        if (player == null)
+            return null;
+
+        PlayerDiseaseRuntime existing = player.GetComponent<PlayerDiseaseRuntime>()
+            ?? player.GetComponentInChildren<PlayerDiseaseRuntime>(true);
+        if (existing == null)
+            existing = player.AddComponent<PlayerDiseaseRuntime>();
+        DiseaseAmbientDriver.EnsureOn(player);
+        return existing;
+    }
+
+    public bool Has(DiseaseId id)
+    {
+        for (int i = 0; i < count; i++)
+        {
+            if (slots[i].Id == id && Time.time < slots[i].ExpiresAt)
+                return true;
+        }
+
+        return false;
+    }
+
+    public bool HasSymptom(DiseaseSymptomKind kind)
+    {
+        for (int i = 0; i < count; i++)
+        {
+            if (Time.time >= slots[i].ExpiresAt)
+                continue;
+            if (!DiseaseCatalog.TryGet(slots[i].Id, out DiseaseCatalog.Definition def))
+                continue;
+            if (def.Symptom == kind)
+                return true;
+        }
+
+        return false;
+    }
+
+    public float GetMoveSpeedMultiplier()
+    {
+        return HasSymptom(DiseaseSymptomKind.MoveSlow) ? 0.82f : 1f;
+    }
+
+    public float GetStaminaRegenMultiplier()
+    {
+        return HasSymptom(DiseaseSymptomKind.StaminaRegenCut) ? 0.55f : 1f;
+    }
+
+    public float GetHungerDrainMultiplier()
+    {
+        return HasSymptom(DiseaseSymptomKind.HungerDrain) ? 1.65f : 1f;
+    }
+
+    public float GetIncomingHealMultiplier()
+    {
+        return HasSymptom(DiseaseSymptomKind.HealTakenCut) ? 0.55f : 1f;
+    }
+
+    public float GetIncomingDamageMultiplier()
+    {
+        float mul = 1f;
+        if (HasSymptom(DiseaseSymptomKind.DamageTakenUp))
+            mul *= 1.12f;
+        if (HasSymptom(DiseaseSymptomKind.ColdVulnerability))
+            mul *= 1.08f;
+        return mul;
+    }
+
+    public float GetColdDamageMultiplier()
+    {
+        return HasSymptom(DiseaseSymptomKind.ColdVulnerability) ? 1.35f : 1f;
+    }
+
+    public float GetSprintStaminaCostMultiplier()
+    {
+        return HasSymptom(DiseaseSymptomKind.SprintCostSpike) ? 1.75f : 1f;
+    }
+
+    public float GetMaxHealthMultiplier()
+    {
+        return HasSymptom(DiseaseSymptomKind.RotDotMaxHp) ? 0.85f : 1f;
+    }
+
+    /// <summary>
+    /// Product of active disease strength multipliers (carry / swim Strength level and melee output).
+    /// </summary>
+    public float GetStrengthMultiplier()
+    {
+        float mul = 1f;
+        for (int i = 0; i < count; i++)
+        {
+            if (Time.time >= slots[i].ExpiresAt)
+                continue;
+            if (!DiseaseCatalog.TryGet(slots[i].Id, out DiseaseCatalog.Definition def))
+                continue;
+            mul *= def.StrengthMultiplier;
+        }
+
+        return Mathf.Clamp(mul, 0.35f, 1f);
+    }
+
+    /// <summary>Server/offline: begin or refresh a disease. Returns false if capped or already present.</summary>
+    public bool ServerTryInfect(DiseaseId id, float durationOverride = -1f)
+    {
+        if (!HasAuthority() || id == DiseaseId.None)
+            return false;
+        if (!DiseaseCatalog.TryGet(id, out DiseaseCatalog.Definition def))
+            return false;
+
+        CompactExpired();
+        if (Has(id))
+            return false;
+        if (count >= DiseaseCatalog.MaxConcurrent)
+            return false;
+
+        float duration = durationOverride > 0f ? durationOverride : DiseaseCatalog.RollDuration(def);
+        slots[count++] = new ActiveDisease
+        {
+            Id = id,
+            ExpiresAt = Time.time + duration,
+        };
+        nextTickAt = Time.time;
+        RefreshHud();
+        Debug.Log($"[Disease] Infected with {def.DisplayName} ({duration:0}s).");
+        return true;
+    }
+
+    public bool ServerTryCure(DiseaseId id)
+    {
+        if (!HasAuthority() || id == DiseaseId.None)
+            return false;
+
+        bool removed = false;
+        for (int i = count - 1; i >= 0; i--)
+        {
+            if (slots[i].Id != id)
+                continue;
+            RemoveAt(i);
+            removed = true;
+        }
+
+        if (removed)
+            RefreshHud();
+        return removed;
+    }
+
+    public bool ServerTryCureAll(out int curedCount, out int totalPrice)
+    {
+        curedCount = 0;
+        totalPrice = 0;
+        if (!HasAuthority())
+            return false;
+
+        CompactExpired();
+        for (int i = count - 1; i >= 0; i--)
+        {
+            if (!DiseaseCatalog.TryGet(slots[i].Id, out DiseaseCatalog.Definition def))
+            {
+                RemoveAt(i);
+                continue;
+            }
+
+            totalPrice += def.HealerCoinPrice;
+            curedCount++;
+            RemoveAt(i);
+        }
+
+        RefreshHud();
+        return curedCount > 0;
+    }
+
+    public int GetHealerTotalPrice()
+    {
+        CompactExpired();
+        int total = 0;
+        for (int i = 0; i < count; i++)
+        {
+            if (DiseaseCatalog.TryGet(slots[i].Id, out DiseaseCatalog.Definition def))
+                total += def.HealerCoinPrice;
+        }
+
+        return total;
+    }
+
+    public string BuildActiveNamesList()
+    {
+        CompactExpired();
+        if (count <= 0)
+            return string.Empty;
+
+        var sb = new StringBuilder();
+        for (int i = 0; i < count; i++)
+        {
+            if (!DiseaseCatalog.TryGet(slots[i].Id, out DiseaseCatalog.Definition def))
+                continue;
+            if (sb.Length > 0)
+                sb.Append(", ");
+            sb.Append(def.DisplayName);
+        }
+
+        return sb.ToString();
+    }
+
+    public void ClearForRespawn()
+    {
+        count = 0;
+        nextTickAt = 0f;
+        RefreshHud();
+    }
+
+    public SaveSnapshot CaptureSave()
+    {
+        CompactExpired();
+        var snap = new SaveSnapshot
+        {
+            ids = new byte[count],
+            remainingSeconds = new float[count],
+        };
+        for (int i = 0; i < count; i++)
+        {
+            snap.ids[i] = (byte)slots[i].Id;
+            snap.remainingSeconds[i] = Mathf.Max(0f, slots[i].ExpiresAt - Time.time);
+        }
+
+        return snap;
+    }
+
+    public void ApplySave(SaveSnapshot snap)
+    {
+        count = 0;
+        if (snap.ids == null || snap.remainingSeconds == null)
+        {
+            RefreshHud();
+            return;
+        }
+
+        int n = Mathf.Min(snap.ids.Length, snap.remainingSeconds.Length);
+        n = Mathf.Min(n, DiseaseCatalog.MaxConcurrent);
+        for (int i = 0; i < n; i++)
+        {
+            DiseaseId id = (DiseaseId)snap.ids[i];
+            if (id == DiseaseId.None || !DiseaseCatalog.TryGet(id, out _))
+                continue;
+            float remaining = Mathf.Max(1f, snap.remainingSeconds[i]);
+            slots[count++] = new ActiveDisease
+            {
+                Id = id,
+                ExpiresAt = Time.time + remaining,
+            };
+        }
+
+        nextTickAt = Time.time;
+        RefreshHud();
+    }
+
+    private void Awake()
+    {
+        CacheRefs();
+    }
+
+    private void Update()
+    {
+        if (!HasAuthority())
+            return;
+
+        CompactExpired();
+        if (count <= 0)
+            return;
+
+        if (Time.time < nextTickAt)
+            return;
+
+        nextTickAt = Time.time + TickIntervalSeconds;
+        CacheRefs();
+        TickSymptoms(TickIntervalSeconds);
+        ClampHealthToDiseaseMax();
+    }
+
+    private void ClampHealthToDiseaseMax()
+    {
+        if (health == null || !HasSymptom(DiseaseSymptomKind.RotDotMaxHp))
+            return;
+
+        float softMax = health.maxHealth * GetMaxHealthMultiplier();
+        if (health.currentHealth > softMax + 0.01f)
+            health.TakeDamageFromEffect(health.currentHealth - softMax, transform.position);
+    }
+
+    private void OnDisable()
+    {
+        if (hudSickTint)
+            ApplySickTint(false);
+    }
+
+    private void TickSymptoms(float dt)
+    {
+        health ??= GetComponent<PlayerHealth>();
+        bool wet = wetness != null && wetness.IsWet;
+
+        for (int i = 0; i < count; i++)
+        {
+            if (!DiseaseCatalog.TryGet(slots[i].Id, out DiseaseCatalog.Definition def))
+                continue;
+
+            switch (def.Symptom)
+            {
+                case DiseaseSymptomKind.PaleDot:
+                    health?.TakeDamageFromEffect(0.85f * dt, transform.position);
+                    break;
+                case DiseaseSymptomKind.FeverDot:
+                    health?.TakeDamageFromEffect(1.1f * dt, transform.position);
+                    break;
+                case DiseaseSymptomKind.WetScratchDot:
+                    if (wet)
+                        health?.TakeDamageFromEffect(0.7f * dt, transform.position);
+                    break;
+                case DiseaseSymptomKind.RotDotMaxHp:
+                    health?.TakeDamageFromEffect(1.6f * dt, transform.position);
+                    break;
+                case DiseaseSymptomKind.StaminaSpikeDrain:
+                    if (stamina != null && (Time.frameCount % 20) == 0)
+                        stamina.TryUseAttackStamina(Mathf.Lerp(4f, 9f, UnityEngine.Random.value));
+                    break;
+            }
+        }
+    }
+
+    private void CompactExpired()
+    {
+        bool changed = false;
+        for (int i = count - 1; i >= 0; i--)
+        {
+            if (Time.time < slots[i].ExpiresAt)
+                continue;
+            RemoveAt(i);
+            changed = true;
+        }
+
+        if (changed)
+            RefreshHud();
+    }
+
+    private void RemoveAt(int index)
+    {
+        for (int j = index; j < count - 1; j++)
+            slots[j] = slots[j + 1];
+        count--;
+    }
+
+    private void RefreshHud()
+    {
+        bool wantTint = HasSymptom(DiseaseSymptomKind.PaleDot) || HasSymptom(DiseaseSymptomKind.RotDotMaxHp);
+        ApplySickTint(wantTint);
+    }
+
+    private void ApplySickTint(bool enable)
+    {
+        hudSickTint = enable;
+        hotbarConsume ??= GetComponent<ActiveHotbarConsume>();
+        if (hotbarConsume != null)
+        {
+            hotbarConsume.NotifyMushroomSicknessHud(enable);
+            return;
+        }
+
+        PlayerStatusRuntimeHud.EnsureOn(gameObject)?.SetHealthBarSickTint(enable);
+    }
+
+    private void CacheRefs()
+    {
+        health ??= GetComponent<PlayerHealth>();
+        stamina ??= GetComponent<FPSStamina>();
+        hunger ??= GetComponent<PlayerHunger>();
+        wetness ??= GetComponent<PlayerWetnessSystem>() ?? GetComponentInChildren<PlayerWetnessSystem>(true);
+        hotbarConsume ??= GetComponent<ActiveHotbarConsume>();
+        if (worldGenerator == null)
+            worldGenerator = FindFirstObjectByType<WorldGenerator>();
+    }
+
+    private bool HasAuthority()
+    {
+        return NetworkServer.active
+            || (!NetworkClient.active && OfflinePlayMode.IsActive(true));
+    }
+}
