diff --git a/tools/test_disease.py b/tools/test_disease.py
new file mode 100644
index 000000000..befe1726c
--- /dev/null
+++ b/tools/test_disease.py
@@ -0,0 +1,106 @@
+#!/usr/bin/env python3
+"""Headless checks that the twelve disease cures and catalog stay wired."""
+
+from __future__ import annotations
+
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def read(rel: str) -> str:
+    return (ROOT / rel).read_text(encoding="utf-8", errors="replace")
+
+
+def main() -> int:
+    catalog = read("Assets/Scripts/Disease/DiseaseCatalog.cs")
+    effects = read("Assets/Scripts/Alchemy/AlchemySignatureEffectKind.cs")
+    recipes = read("Assets/Scripts/Alchemy/AlchemySignatureBrewCatalog.cs")
+    ingredients = read("Assets/Scripts/Alchemy/AlchemyCatalog.cs")
+
+    disease_ids = [
+        "RawcapGut",
+        "MarshCough",
+        "Frogitch",
+        "WoundFever",
+        "Mirefoot",
+        "BlackwaterBelly",
+        "Leechblood",
+        "BoneChillAgue",
+        "SwampRot",
+        "RedscalePox",
+        "GraveDamp",
+        "HollowLung",
+    ]
+    cure_effects = [f"Cure{name}" for name in disease_ids]
+
+    errors: list[str] = []
+
+    for name in disease_ids:
+        if f"DiseaseId.{name}" not in catalog and f"({name}" not in catalog:
+            # catalog uses DiseaseId.X in Definitions
+            if f"DiseaseId.{name}" not in catalog:
+                errors.append(f"DiseaseCatalog missing DiseaseId.{name}")
+
+    for effect in cure_effects:
+        if effect not in effects:
+            errors.append(f"AlchemySignatureEffectKind missing {effect}")
+        if effect not in recipes:
+            errors.append(f"AlchemySignatureBrewCatalog missing {effect}")
+
+    if "RecipeCount = 63" not in recipes:
+        errors.append("AlchemySignatureBrewCatalog.RecipeCount should be 63")
+
+    for key in (
+        "rawcap_bitterleaf",
+        "rotveil_spore",
+        "poxiron_flake",
+        "gravedamp_lichen",
+        "hollow_lungwort",
+    ):
+        if key not in ingredients:
+            errors.append(f"AlchemyCatalog missing ingredient {key}")
+        if key not in recipes:
+            errors.append(f"Signature recipes missing key {key}")
+
+    for recipe_id in range(52, 64):
+        if f"new({recipe_id}," not in recipes and f"new({recipe_id}, " not in recipes:
+            errors.append(f"Missing signature recipe id {recipe_id}")
+
+    runtime = read("Assets/Scripts/Disease/PlayerDiseaseRuntime.cs")
+    if "MaxConcurrent" not in runtime:
+        errors.append("PlayerDiseaseRuntime missing MaxConcurrent usage")
+
+    health = read("Assets/Scripts/Combat/PlayerHealth.cs")
+    if "DiseaseInfectionService.ServerTryInfectFromCreatureHit" not in health:
+        errors.append("PlayerHealth missing combat disease hook")
+
+    strength = read("Assets/Scripts/Practice/StrengthTraining.cs")
+    if "GetStrengthMultiplier" not in strength:
+        errors.append("StrengthTraining missing disease strength drain")
+
+    melee = read("Assets/Scripts/Combat/PlayerMeleeCombat.cs")
+    if "GetStrengthMultiplier" not in melee:
+        errors.append("PlayerMeleeCombat missing disease strength drain")
+
+    healer = read("Assets/Scripts/World/Village/ChurchHealerDiseaseService.cs")
+    if "TryConsumeCoins" not in healer:
+        errors.append("ChurchHealerDiseaseService missing coin charge")
+
+    if "strengthMultiplier: 0.7f" not in catalog:
+        errors.append("Swamp Rot should drain strength (0.7)")
+
+    if errors:
+        print("FAIL")
+        for e in errors:
+            print(" -", e)
+        return 1
+
+    print("OK: 12 diseases, cures 52-63, combat hook, healer pay, rare reagents present")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
