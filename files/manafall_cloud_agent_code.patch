+#if UNITY_EDITOR
+using InventoryFramework;
+using UnityEditor;
+using UnityEngine;
+
+/// <summary>Play Mode helpers for the twelve mundane diseases.</summary>
+public static class DiseaseDebugEditorTools
+{
+    private const string AlchemyPotionItemPath =
+        "Assets/Jinxish/Drag & Drop Inventory & Hotbar Framework/ScriptableObjects/Items/Alchemy/Alchemy Potion.asset";
+
+    [MenuItem("Manafall/Disease/Infect Local Player With All (capped to 3)")]
+    public static void InfectThreeSample()
+    {
+        if (!TryGetLocalPlayer(out GameObject player))
+            return;
+
+        PlayerDiseaseRuntime runtime = PlayerDiseaseRuntime.EnsureOn(player);
+        DiseaseAmbientDriver.EnsureOn(player);
+        runtime.ClearForRespawn();
+        runtime.ServerTryInfect(DiseaseId.RawcapGut);
+        runtime.ServerTryInfect(DiseaseId.MarshCough);
+        runtime.ServerTryInfect(DiseaseId.WoundFever);
+        Debug.Log($"[Disease] Active: {runtime.BuildActiveNamesList()} price={runtime.GetHealerTotalPrice()}");
+    }
+
+    [MenuItem("Manafall/Disease/Infect Local Player — Swamp Rot")]
+    public static void InfectSwampRot()
+    {
+        if (!TryGetLocalPlayer(out GameObject player))
+            return;
+        PlayerDiseaseRuntime.EnsureOn(player)?.ServerTryInfect(DiseaseId.SwampRot);
+    }
+
+    [MenuItem("Manafall/Disease/Clear All Diseases On Local Player")]
+    public static void ClearAll()
+    {
+        if (!TryGetLocalPlayer(out GameObject player))
+            return;
+        PlayerDiseaseRuntime.EnsureOn(player)?.ClearForRespawn();
+        Debug.Log("[Disease] Cleared.");
+    }
+
+    [MenuItem("Manafall/Disease/Grant All Disease Cure Potions")]
+    public static void GrantCurePotions()
+    {
+        if (!Application.isPlaying)
+        {
+            EditorUtility.DisplayDialog("Disease Cures", "Enter Play Mode first.", "OK");
+            return;
+        }
+
+        if (!TryGetLocalPlayer(out GameObject player))
+            return;
+
+        Item potionItem = AssetDatabase.LoadAssetAtPath<Item>(AlchemyPotionItemPath);
+        if (potionItem == null)
+        {
+            EditorUtility.DisplayDialog("Disease Cures", "Alchemy Potion item missing.", "OK");
+            return;
+        }
+
+        Hotbar hotbar = player.GetComponentInChildren<Hotbar>(true);
+        Inventory inventory = player.GetComponentInChildren<Inventory>(true);
+        int granted = 0;
+        for (int id = 52; id <= 63; id++)
+        {
+            if (!AlchemySignatureBrewCatalog.TryGetRecipe(id, out _))
+                continue;
+
+            float meta = AlchemyPotionEncoding.PackSignature(
+                id,
+                potencyTier: 22,
+                durationTier: 20,
+                instabilityTier: 2,
+                AlchemyBrewFlags.Stabilized,
+                purified: false);
+
+            if (ItemGrantService.TryGiveItem(hotbar, inventory, potionItem, 1, meta))
+                granted++;
+        }
+
+        inventory?.TriggerUpdate();
+        ItemGrantService.RefreshUI(hotbar, inventory);
+        Debug.Log($"[Disease] Granted {granted} cure potions.");
+        EditorUtility.DisplayDialog("Disease Cures", $"Granted {granted} cure potions.", "OK");
+    }
+
+    [MenuItem("Manafall/Disease/Validate Catalog (Editor)")]
+    public static void ValidateCatalog()
+    {
+        var seen = new System.Collections.Generic.HashSet<int>();
+        int ok = 0;
+        for (byte i = 1; i <= DiseaseCatalog.DiseaseCount; i++)
+        {
+            DiseaseId id = (DiseaseId)i;
+            if (!DiseaseCatalog.TryGet(id, out DiseaseCatalog.Definition def))
+            {
+                Debug.LogError($"[DiseaseValidate] Missing def {id}");
+                continue;
+            }
+
+            if (def.CureSignatureRecipeId < 52 || def.CureSignatureRecipeId > 63)
+                Debug.LogError($"[DiseaseValidate] {id} recipe {def.CureSignatureRecipeId} out of range");
+            if (!seen.Add(def.CureSignatureRecipeId))
+                Debug.LogError($"[DiseaseValidate] Duplicate recipe {def.CureSignatureRecipeId}");
+            if (!AlchemySignatureBrewCatalog.TryGetRecipe(def.CureSignatureRecipeId, out _))
+                Debug.LogError($"[DiseaseValidate] Missing signature recipe {def.CureSignatureRecipeId}");
+            if (DiseaseCatalog.DiseaseForCureRecipe(def.CureSignatureRecipeId) != id)
+                Debug.LogError($"[DiseaseValidate] Cure recipe map mismatch for {id}");
+            ok++;
+        }
+
+        string msg = $"Validated {ok}/{DiseaseCatalog.DiseaseCount} diseases, {seen.Count} unique cure recipes.";
+        Debug.Log("[DiseaseValidate] " + msg);
+        EditorUtility.DisplayDialog("Disease Validate", msg, "OK");
+    }
+
+    [MenuItem("Manafall/Disease/Smoke — Infect, Wrong Cure, Right Cure")]
+    public static void SmokeInfectCure()
+    {
+        if (!TryGetLocalPlayer(out GameObject player))
+            return;
+
+        PlayerDiseaseRuntime runtime = PlayerDiseaseRuntime.EnsureOn(player);
+        runtime.ClearForRespawn();
+        bool infected = runtime.ServerTryInfect(DiseaseId.WoundFever);
+        bool wrong = runtime.ServerTryCure(DiseaseId.RawcapGut);
+        bool right = runtime.ServerTryCure(DiseaseId.WoundFever);
+        bool gone = !runtime.Has(DiseaseId.WoundFever);
+        Debug.Log(
+            $"[DiseaseSmoke] infected={infected} wrongCure={wrong} rightCure={right} cleared={gone}");
+        EditorUtility.DisplayDialog(
+            "Disease Smoke",
+            $"infected={infected}\nwrongCure(should false)={wrong}\nrightCure={right}\ncleared={gone}",
+            "OK");
+    }
+
+    private static bool TryGetLocalPlayer(out GameObject player)
+    {
+        player = null;
+        if (!Application.isPlaying)
+        {
+            EditorUtility.DisplayDialog("Disease", "Enter Play Mode first.", "OK");
+            return false;
+        }
+
+        if (Mirror.NetworkClient.localPlayer != null)
+            player = Mirror.NetworkClient.localPlayer.gameObject;
+        if (player == null)
+            player = Object.FindFirstObjectByType<FPSNetworkMovement>()?.gameObject;
+        if (player == null)
+        {
+            EditorUtility.DisplayDialog("Disease", "No local player found.", "OK");
+            return false;
+        }
+
+        return true;
+    }
+}
+#endif
