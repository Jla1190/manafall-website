+    private static void AddAttackState(
+        AnimatorStateMachine sm,
+        AnimatorState loco,
+        string stateName,
+        AnimationClip clip,
+        DrucladAnimCatalog.AttackId id)
+    {
+        if (!DrucladAnimCatalog.TryGet(id, out DrucladAnimCatalog.AttackDef def))
+            return;
+
+        AnimatorState state = AddState(sm, stateName, clip, new Vector3(420f, 40f + (int)id * 36f, 0f));
+        AddTriggerAny(sm, def.TriggerName, state, loco, def.RecoveryNormalized);
+    }
+
+    private static AnimatorState AddState(AnimatorStateMachine sm, string name, AnimationClip clip, Vector3 pos)
+    {
+        AnimatorState state = sm.AddState(name, pos);
+        state.motion = clip;
+        state.writeDefaultValues = true;
+        return state;
+    }
+
+    private static void AddTriggerAny(
+        AnimatorStateMachine sm,
+        string trigger,
+        AnimatorState dst,
+        AnimatorState backTo,
+        float exitTime,
+        bool exitOnly = false)
+    {
+        AnimatorStateTransition any = sm.AddAnyStateTransition(dst);
+        any.AddCondition(AnimatorConditionMode.If, 0f, trigger);
+        if (!exitOnly)
+            any.AddCondition(AnimatorConditionMode.IfNot, 0f, DrucladAnimCatalog.DeadBool);
+        any.hasExitTime = false;
+        any.duration = 0.08f;
+        any.canTransitionToSelf = false;
+
+        if (backTo == null || exitOnly)
+            return;
+
+        AnimatorStateTransition back = dst.AddTransition(backTo);
+        back.hasExitTime = true;
+        back.exitTime = Mathf.Clamp01(exitTime);
+        back.duration = 0.1f;
+        back.hasFixedDuration = true;
+    }
+
+    private static Dictionary<string, AnimationClip> LoadClipsFromFolder()
+    {
+        var map = new Dictionary<string, AnimationClip>(StringComparer.OrdinalIgnoreCase);
+        string[] guids = AssetDatabase.FindAssets("t:AnimationClip", new[] { ClipsFolder });
+        for (int i = 0; i < guids.Length; i++)
+        {
+            string path = AssetDatabase.GUIDToAssetPath(guids[i]);
+            foreach (Object sub in AssetDatabase.LoadAllAssetsAtPath(path))
+            {
+                if (sub is not AnimationClip clip || clip.name.StartsWith("__", StringComparison.Ordinal))
+                    continue;
+                if (!map.ContainsKey(clip.name))
+                    map.Add(clip.name, clip);
+                string fileKey = Path.GetFileNameWithoutExtension(path);
+                if (!map.ContainsKey(fileKey))
+                    map.Add(fileKey, clip);
+            }
+        }
+
+        return map;
+    }
+
+    private static AnimationClip FindClip(Dictionary<string, AnimationClip> clips, params string[] keys)
+    {
+        foreach (KeyValuePair<string, AnimationClip> pair in clips)
+        {
+            string n = pair.Key.ToLowerInvariant();
+            for (int i = 0; i < keys.Length; i++)
+            {
+                if (n.Contains(keys[i].ToLowerInvariant()))
+                    return pair.Value;
+            }
+        }
+
+        return null;
+    }
+
+    private static AnimationClip FirstClip(Dictionary<string, AnimationClip> clips)
+    {
+        foreach (KeyValuePair<string, AnimationClip> pair in clips)
+            return pair.Value;
+        return null;
+    }
