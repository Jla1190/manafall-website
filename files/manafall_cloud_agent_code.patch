+    private static void AssignNetworkAssetId(GameObject prefab, uint assetId, StringBuilder log)
+    {
+        if (prefab == null)
+            return;
+
+        string path = AssetDatabase.GetAssetPath(prefab);
+        GameObject instance = PrefabUtility.LoadPrefabContents(path);
+        try
+        {
+            NetworkIdentity identity = instance.GetComponent<NetworkIdentity>();
+            if (identity == null)
+                identity = instance.AddComponent<NetworkIdentity>();
+
+            SerializedObject so = new SerializedObject(identity);
+            SerializedProperty assetIdProp = so.FindProperty("assetId");
+            if (assetIdProp != null)
+            {
+                // Mirror stores assetId as uint via serialized field name variations.
+                assetIdProp.longValue = assetId;
+                so.ApplyModifiedPropertiesWithoutUndo();
+            }
+
+            PrefabUtility.SaveAsPrefabAsset(instance, path);
+            log.AppendLine($"  NetworkIdentity assetId={assetId}");
+        }
+        finally
+        {
+            PrefabUtility.UnloadPrefabContents(instance);
+        }
+    }
+
+    private static void MirrorResourcesCopy(StringBuilder log)
+    {
+        GameObject prefab = AssetDatabase.LoadAssetAtPath<GameObject>(PrefabPath);
+        if (prefab == null)
+            return;
+
+        if (File.Exists(ResourcesPrefabPath))
+            AssetDatabase.DeleteAsset(ResourcesPrefabPath);
+        if (AssetDatabase.CopyAsset(PrefabPath, ResourcesPrefabPath))
+            log.AppendLine($"  Mirrored Resources/{Path.GetFileName(ResourcesPrefabPath)}");
+    }
+
+    private static void RegisterSpawnablePrefab(StringBuilder log, GameObject prefab)
+    {
+        if (prefab == null)
+            return;
+
+        GameObject nmPrefab = AssetDatabase.LoadAssetAtPath<GameObject>(NetworkManagerPath);
+        if (nmPrefab == null)
+        {
+            log?.AppendLine("  WARN: NetworkManager prefab missing — spawn list not updated.");
+            return;
+        }
+
+        string path = AssetDatabase.GetAssetPath(nmPrefab);
+        GameObject instance = PrefabUtility.LoadPrefabContents(path);
+        try
+        {
+            NetworkManager manager = instance.GetComponent<NetworkManager>();
+            if (manager == null)
+                return;
+
+            manager.spawnPrefabs ??= new List<GameObject>();
+            if (!manager.spawnPrefabs.Contains(prefab))
+            {
+                manager.spawnPrefabs.Add(prefab);
+                log?.AppendLine("  Registered Druclad on NetworkManager spawn list.");
+            }
+
+            PrefabUtility.SaveAsPrefabAsset(instance, path);
+        }
+        finally
+        {
+            PrefabUtility.UnloadPrefabContents(instance);
+        }
+    }
+
+    private static void EnsureFolder(string path)
+    {
+        if (AssetDatabase.IsValidFolder(path))
+            return;
+
+        string[] parts = path.Split('/');
+        string cur = parts[0];
+        for (int i = 1; i < parts.Length; i++)
+        {
+            string next = cur + "/" + parts[i];
+            if (!AssetDatabase.IsValidFolder(next))
+                AssetDatabase.CreateFolder(cur, parts[i]);
+            cur = next;
+        }
+    }
+}
