+    private static void WireRootComponents(
+        GameObject root,
+        RuntimeAnimatorController animator,
+        DrucladLootTable lootTable,
+        StringBuilder log)
+    {
+        if (root.GetComponent<NetworkIdentity>() == null)
+            root.AddComponent<NetworkIdentity>();
+        if (root.GetComponent<NetworkTransformUnreliable>() == null)
+            root.AddComponent<NetworkTransformUnreliable>();
+        if (root.GetComponent<NetworkAnimator>() == null)
+            root.AddComponent<NetworkAnimator>();
+
+        CharacterController cc = root.GetComponent<CharacterController>();
+        if (cc == null)
+            cc = root.AddComponent<CharacterController>();
+        cc.height = 3.8f;
+        cc.radius = 1.05f;
+        cc.center = new Vector3(0f, 1.9f, 0f);
+        cc.slopeLimit = 50f;
+        cc.stepOffset = 0.55f;
+
+        Health health = root.GetComponent<Health>();
+        if (health == null)
+            health = root.AddComponent<Health>();
+        health.ConfigureMaxHealth(BossMaxHealth, healToFull: true);
+        health.DestroyOnDeath = false;
+
+        EnsureHurtboxChild(root.transform);
+
+        AudioSource audio = root.GetComponent<AudioSource>();
+        if (audio == null)
+            audio = root.AddComponent<AudioSource>();
+        audio.spatialBlend = 1f;
+        audio.playOnAwake = false;
+        audio.maxDistance = 48f;
+
+        DrucladFirePresentation firePresentation = root.GetComponent<DrucladFirePresentation>();
+        if (firePresentation == null)
+            firePresentation = root.AddComponent<DrucladFirePresentation>();
+
+        Transform bodyFire = EnsureBodyFireChild(root.transform);
+
+        Animator anim = root.GetComponentInChildren<Animator>(true);
+        if (anim == null)
+            anim = root.AddComponent<Animator>();
+        if (animator != null)
+            anim.runtimeAnimatorController = animator;
+        Avatar avatar = LoadDrucladAvatar();
+        if (avatar != null)
+            anim.avatar = avatar;
+        anim.applyRootMotion = false;
+        anim.cullingMode = AnimatorCullingMode.AlwaysAnimate;
+
+        NetworkAnimator netAnim = root.GetComponent<NetworkAnimator>();
+        if (netAnim != null)
+            netAnim.animator = anim;
+
+        DrucladController controller = root.GetComponent<DrucladController>();
+        if (controller == null)
+            controller = root.AddComponent<DrucladController>();
+
+        DrucladFireBreathVolume breath = root.GetComponent<DrucladFireBreathVolume>();
+        if (breath == null)
+            breath = root.AddComponent<DrucladFireBreathVolume>();
+
+        SerializedObject so = new SerializedObject(controller);
+        so.FindProperty("characterController").objectReferenceValue = cc;
+        so.FindProperty("health").objectReferenceValue = health;
+        so.FindProperty("animator").objectReferenceValue = anim;
+        so.FindProperty("defaultRuntimeAnimatorController").objectReferenceValue = animator;
+        so.FindProperty("breathVolume").objectReferenceValue = breath;
+        so.FindProperty("firePresentation").objectReferenceValue = firePresentation;
+        so.FindProperty("bodyAudio").objectReferenceValue = audio;
+        so.FindProperty("deathLootTable").objectReferenceValue = lootTable;
+        GameObject lootBag = AssetDatabase.LoadAssetAtPath<GameObject>(LootBagPath);
+        if (lootBag != null)
+            so.FindProperty("lootBagPrefab").objectReferenceValue = lootBag;
+        so.FindProperty("maxHealthBoss").floatValue = BossMaxHealth;
+        so.ApplyModifiedPropertiesWithoutUndo();
+
+        SerializedObject fireSo = new SerializedObject(firePresentation);
+        fireSo.FindProperty("bodyAnchor").objectReferenceValue = root.transform;
+        fireSo.FindProperty("bodyAudio").objectReferenceValue = audio;
+        fireSo.FindProperty("bodyFireInstance").objectReferenceValue = bodyFire;
+        GameObject bodyFirePrefab = AssetDatabase.LoadAssetAtPath<GameObject>(BodyFirePrefabPath);
+        if (bodyFirePrefab != null)
+            fireSo.FindProperty("bodyFirePrefab").objectReferenceValue = bodyFirePrefab;
+        fireSo.FindProperty("bodyFireLocalOffset").vector3Value = new Vector3(0f, 1.15f, 0.1f);
+        fireSo.FindProperty("bodyFireBaseScale").floatValue = 1.85f;
+        fireSo.ApplyModifiedPropertiesWithoutUndo();
+
+        if (root.GetComponent<CreatureLevel>() == null)
+            root.AddComponent<CreatureLevel>();
+
+        log.AppendLine("  Wired DrucladController / body fire / Health / Hurtbox / CharacterController / Network*.");
+    }
