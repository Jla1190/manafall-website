+using System;
+using System.IO;
+using Mirror;
+using UnityEngine;
+
+/// <summary>
+/// Once-per-world-seed Druclad encounter flags (alive fled / permanently dead).
+/// Persisted next to world-entities.json as <c>druclad.json</c> for host/offline saves.
+/// </summary>
+public static class DrucladWorldFlags
+{
+    private const string FileName = "druclad.json";
+    private const int Version = 1;
+
+    [Serializable]
+    public sealed class FileBlob
+    {
+        public int version = Version;
+        public int worldSeed;
+        public bool hasAwakened;
+        public bool isAlive;
+        public bool isDead;
+    }
+
+    private static FileBlob cached;
+    private static bool loaded;
+
+    public static string FilePath() =>
+        Path.Combine(HostWorldSave.SlotRootDirectory(), FileName);
+
+    public static void NotifySessionEnded()
+    {
+        cached = null;
+        loaded = false;
+    }
+
+    public static FileBlob Get()
+    {
+        EnsureLoaded();
+        return cached;
+    }
+
+    public static bool IsPermanentlyDead()
+    {
+        EnsureLoaded();
+        return cached != null && cached.isDead;
+    }
+
+    public static bool CanSpawn(int worldSeed)
+    {
+        EnsureLoaded();
+        if (cached == null)
+            return true;
+
+        if (cached.worldSeed != 0 && cached.worldSeed != worldSeed)
+        {
+            // Different seed slot — treat as fresh.
+            cached = new FileBlob { worldSeed = worldSeed };
+            return true;
+        }
+
+        return !cached.isDead;
+    }
+
+    public static void MarkAwakened(int worldSeed)
+    {
+        EnsureLoaded();
+        cached.worldSeed = worldSeed;
+        cached.hasAwakened = true;
+        cached.isAlive = true;
+        cached.isDead = false;
+        Persist();
+    }
+
+    public static void MarkAliveFled()
+    {
+        EnsureLoaded();
+        cached.isAlive = true;
+        cached.isDead = false;
+        cached.hasAwakened = true;
+        Persist();
+    }
+
+    public static void MarkDead()
+    {
+        EnsureLoaded();
+        cached.isAlive = false;
+        cached.isDead = true;
+        cached.hasAwakened = true;
+        Persist();
+    }
+
+    public static void ServerCapture()
+    {
+        if (!NetworkServer.active || !OfflineSoloSession.WorldPersistenceActive)
+            return;
+        if (!loaded || cached == null)
+            return;
+        Persist();
+    }
+
+    public static void ServerRestore()
+    {
+        loaded = false;
+        cached = null;
+        EnsureLoaded();
+    }
+
+    private static void EnsureLoaded()
+    {
+        if (loaded && cached != null)
+            return;
+
+        loaded = true;
+        cached = new FileBlob();
+
+        try
+        {
+            SaveFileWriter.Flush();
+            string path = FilePath();
+            if (!File.Exists(path))
+                return;
+
+            string json = File.ReadAllText(path);
+            if (string.IsNullOrWhiteSpace(json))
+                return;
+
+            FileBlob blob = JsonUtility.FromJson<FileBlob>(json);
+            if (blob != null)
+                cached = blob;
+        }
+        catch (Exception ex)
+        {
+            Debug.LogWarning("[DrucladWorldFlags] Load failed: " + ex.Message);
+        }
+    }
+
+    private static void Persist()
+    {
+        if (cached == null)
+            return;
+
+        try
+        {
+            Directory.CreateDirectory(HostWorldSave.SlotRootDirectory());
+            string json = JsonUtility.ToJson(cached, true);
+            if (NetworkServer.active && OfflineSoloSession.WorldPersistenceActive)
+                SaveFileWriter.Enqueue(FilePath(), json);
+            else
+                SaveFileWriter.WriteNow(FilePath(), json);
+        }
+        catch (Exception ex)
+        {
+            Debug.LogWarning("[DrucladWorldFlags] Persist failed: " + ex.Message);
+        }
+    }
+}
