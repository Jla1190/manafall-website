+    /// </summary>
+    public static void EnsureVoidSettingsDefaults(BiomeSettings settings)
+    {
+        if (settings == null)
+            return;
+
+        if (settings.voidDomainStrength <= 0.001f)
+            settings.voidDomainStrength = 1f;
+        if (settings.voidDomainRadiusMeters < 40f || settings.voidDomainRadiusMeters > 280f)
+            settings.voidDomainRadiusMeters = 160f;
+        if (settings.voidIslandGapMeters < 80f)
+            settings.voidIslandGapMeters = 140f;
+        if (settings.voidDomainEdgeMeters < 10f || settings.voidDomainEdgeMeters > 80f)
+            settings.voidDomainEdgeMeters = 36f;
+        if (settings.voidIslandBearingDegrees <= 0.001f)
+        {
+            float volcanoBearing = settings.volcanoIslandBearingDegrees > 0.001f
+                ? settings.volcanoIslandBearingDegrees
+                : 90f;
+            settings.voidIslandBearingDegrees = Mathf.Repeat(volcanoBearing + 180f, 360f);
+            if (settings.voidIslandBearingDegrees <= 0.001f)
+                settings.voidIslandBearingDegrees = 270f;
+        }
+        if (settings.voidPlateauAboveSea01 < 0.02f || settings.voidPlateauAboveSea01 > 0.14f)
+            settings.voidPlateauAboveSea01 = 0.055f;
+        if (settings.voidPeakLift01 < 0.18f || settings.voidPeakLift01 > 0.55f)
+            settings.voidPeakLift01 = 0.44f;
+        if (settings.voidHeightExaggeration < 1.05f || settings.voidHeightExaggeration > 4.5f)
+            settings.voidHeightExaggeration = 3.15f;
+        if (settings.voidGravityMultiplier < 0.05f || settings.voidGravityMultiplier > 1f)
+            settings.voidGravityMultiplier = 0.3333333f;
+        if (settings.voidGravityBlendWiden < 1f || settings.voidGravityBlendWiden > 2.5f)
+            settings.voidGravityBlendWiden = 2.1f;
+    }
