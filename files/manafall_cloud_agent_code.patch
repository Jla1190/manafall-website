@@ -0,0 +1,96 @@
+using UnityEngine;
+
+/// <summary>
+/// Boss-scale body fire driver (Hellhound-style). Prefers Hovl hellhound aura loop,
+/// otherwise keeps embedded Vefects layers and scales/tints with health + flares.
+/// </summary>
+[DisallowMultipleComponent]
+public sealed class DrucladBodyFireVfx : MonoBehaviour
+{
+    [SerializeField] private Light glowLight;
+    [SerializeField] private float minScale = 0.55f;
+    [SerializeField] private float maxScale = 1.35f;
+    [SerializeField] private float minLightIntensity = 1.4f;
+    [SerializeField] private float maxLightIntensity = 6.5f;
+    [SerializeField] private float enrageFlareFireMultiplier = 1.85f;
+    [SerializeField] private float enrageFlareLightMultiplier = 1.7f;
+    [SerializeField] private float enrageFlareRangeBoost = 3.2f;
+    [SerializeField] private Color healthyTint = new Color(1.4f, 0.68f, 0.16f, 1f);
+    [SerializeField] private Color woundedTint = new Color(1.05f, 0.3f, 0.05f, 1f);
+    [SerializeField] private Color dyingTint = new Color(0.48f, 0.12f, 0.04f, 1f);
+
+    private GameObject hovlBodyFire;
+    private bool usingHovlBodyFire;
+
+    public void ApplyPresentation(float healthRatio, float flareStrength, bool enrageFlare = false)
+    {
+        healthRatio = Mathf.Clamp01(healthRatio);
+        flareStrength = Mathf.Clamp01(flareStrength);
+
+        float flareMul = 1f + flareStrength * 0.95f;
+        if (enrageFlare)
+            flareMul = Mathf.Max(flareMul, enrageFlareFireMultiplier);
+
+        float scale = Mathf.Lerp(minScale, maxScale, healthRatio) * flareMul;
+        transform.localScale = Vector3.one * scale;
+
+        if (glowLight == null)
+            return;
+
+        Color tint = healthRatio > 0.55f
+            ? Color.Lerp(woundedTint, healthyTint, (healthRatio - 0.55f) / 0.45f)
+            : Color.Lerp(dyingTint, woundedTint, healthRatio / 0.55f);
+
+        glowLight.color = tint;
+        float intensity = Mathf.Lerp(minLightIntensity, maxLightIntensity, healthRatio) * flareMul;
+        float range = 5.5f + healthRatio * 4.5f;
+        if (enrageFlare)
+        {
+            intensity *= enrageFlareLightMultiplier;
+            range += enrageFlareRangeBoost;
+        }
+
+        glowLight.intensity = intensity;
+        glowLight.range = range;
+    }
+
+    private void Awake()
+    {
+        if (glowLight == null)
+            glowLight = GetComponentInChildren<Light>(true);
+        TryAttachHovlBodyFire();
+    }
+
+    private void TryAttachHovlBodyFire()
+    {
+        if (usingHovlBodyFire)
+            return;
+
+        // Reuse hellhound aura pack — same fire look the player already knows.
+        hovlBodyFire = CreatureHovlBridge.TryAttachLoop(
+            CreatureHovlId.Hellhound,
+            CreatureHovlPhase.Aura,
+            transform,
+            0.95f);
+        if (hovlBodyFire == null)
+            return;
+
+        usingHovlBodyFire = true;
+        DisableLegacyFireParticles();
+    }
+
+    private void DisableLegacyFireParticles()
+    {
+        ParticleSystem[] systems = GetComponentsInChildren<ParticleSystem>(true);
+        for (int i = 0; i < systems.Length; i++)
+        {
+            ParticleSystem ps = systems[i];
+            if (ps == null || (hovlBodyFire != null && ps.transform.IsChildOf(hovlBodyFire.transform)))
+                continue;
+
+            ParticleSystemRenderer renderer = ps.GetComponent<ParticleSystemRenderer>();
+            if (renderer != null)
+                renderer.enabled = false;
+        }
+    }
+}
