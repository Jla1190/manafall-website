+        public readonly float MaxDurationSeconds;
+        public readonly float CombatWeight;
+        public readonly float AmbientWeight;
+        public readonly float SwampMultiplier;
+        public readonly bool PrefersColdBiome;
+        public readonly bool PrefersUndead;
+        /// <summary>1 = no strength drain. Multiplies effective Strength level and melee output.</summary>
+        public readonly float StrengthMultiplier;
+
+        public Definition(
+            DiseaseId id,
+            string displayName,
+            Severity severity,
+            DiseaseSymptomKind symptom,
+            int healerCoinPrice,
+            int cureSignatureRecipeId,
+            float minDurationSeconds,
+            float maxDurationSeconds,
+            float combatWeight,
+            float ambientWeight,
+            float swampMultiplier,
+            bool prefersColdBiome = false,
+            bool prefersUndead = false,
+            float strengthMultiplier = 1f)
+        {
+            Id = id;
+            DisplayName = displayName;
+            Severity = severity;
+            Symptom = symptom;
+            HealerCoinPrice = healerCoinPrice;
+            CureSignatureRecipeId = cureSignatureRecipeId;
+            MinDurationSeconds = minDurationSeconds;
+            MaxDurationSeconds = maxDurationSeconds;
+            CombatWeight = combatWeight;
+            AmbientWeight = ambientWeight;
+            SwampMultiplier = swampMultiplier;
+            PrefersColdBiome = prefersColdBiome;
+            PrefersUndead = prefersUndead;
+            StrengthMultiplier = Mathf.Clamp(strengthMultiplier, 0.35f, 1f);
+        }
+    }
+
+    private static readonly Definition[] Definitions =
+    {
+        new(DiseaseId.RawcapGut, "Rawcap Gut", Severity.Mild, DiseaseSymptomKind.PaleDot,
+            90, 52, 95f, 150f, 0f, 0f, 1f),
+        new(DiseaseId.MarshCough, "Marsh Cough", Severity.Mild, DiseaseSymptomKind.StaminaRegenCut,
+            110, 53, 120f, 220f, 0.15f, 1.4f, 8f),
+        new(DiseaseId.Frogitch, "Frogitch", Severity.Mild, DiseaseSymptomKind.WetScratchDot,
+            100, 54, 100f, 180f, 0.2f, 1.1f, 6f),
+        new(DiseaseId.WoundFever, "Wound Fever", Severity.Moderate, DiseaseSymptomKind.FeverDot,
+            200, 55, 140f, 260f, 1.2f, 0.05f, 3f, strengthMultiplier: 0.85f),
+        new(DiseaseId.Mirefoot, "Mirefoot", Severity.Moderate, DiseaseSymptomKind.MoveSlow,
+            180, 56, 150f, 280f, 0.1f, 1.3f, 8f),
+        new(DiseaseId.BlackwaterBelly, "Blackwater Belly", Severity.Moderate, DiseaseSymptomKind.HungerDrain,
+            220, 57, 140f, 250f, 0.9f, 0.4f, 7f, strengthMultiplier: 0.9f),
+        new(DiseaseId.Leechblood, "Leechblood", Severity.Moderate, DiseaseSymptomKind.HealTakenCut,
+            240, 58, 160f, 280f, 1.1f, 0.05f, 7f, strengthMultiplier: 0.8f),
+        new(DiseaseId.BoneChillAgue, "Bone Chill Ague", Severity.Moderate, DiseaseSymptomKind.ColdVulnerability,
+            210, 59, 150f, 270f, 1.0f, 0.05f, 0.35f, prefersColdBiome: true, strengthMultiplier: 0.85f),
+        new(DiseaseId.SwampRot, "Swamp Rot", Severity.Severe, DiseaseSymptomKind.RotDotMaxHp,
+            420, 60, 200f, 360f, 0.7f, 0.55f, 8f, strengthMultiplier: 0.7f),
+        new(DiseaseId.RedscalePox, "Redscale Pox", Severity.Severe, DiseaseSymptomKind.DamageTakenUp,
+            380, 61, 180f, 320f, 0.85f, 0.02f, 3f, strengthMultiplier: 0.8f),
+        new(DiseaseId.GraveDamp, "Grave Damp", Severity.Severe, DiseaseSymptomKind.StaminaSpikeDrain,
+            400, 62, 180f, 340f, 0.75f, 0.02f, 1.5f, prefersUndead: true, strengthMultiplier: 0.75f),
+        new(DiseaseId.HollowLung, "Hollow Lung", Severity.Severe, DiseaseSymptomKind.SprintCostSpike,
+            480, 63, 200f, 380f, 0.45f, 0.15f, 5f),
+    };
+
+    public static bool TryGet(DiseaseId id, out Definition def)
+    {
+        int index = (int)id - 1;
+        if (index < 0 || index >= Definitions.Length)
+        {
+            def = default;
+            return false;
+        }
+
+        def = Definitions[index];
+        return def.Id == id;
+    }
+
+    public static Definition Get(DiseaseId id)
+    {
+        if (!TryGet(id, out Definition def))
+            throw new ArgumentOutOfRangeException(nameof(id), id, "Unknown disease.");
+        return def;
+    }
+
+    public static DiseaseId DiseaseForCureRecipe(int signatureRecipeId)
+    {
+        for (int i = 0; i < Definitions.Length; i++)
+        {
+            if (Definitions[i].CureSignatureRecipeId == signatureRecipeId)
+                return Definitions[i].Id;
+        }
+
+        return DiseaseId.None;
+    }
+
+    public static AlchemySignatureEffectKind CureEffectFor(DiseaseId id)
+    {
+        return id switch
+        {
+            DiseaseId.RawcapGut => AlchemySignatureEffectKind.CureRawcapGut,
+            DiseaseId.MarshCough => AlchemySignatureEffectKind.CureMarshCough,
+            DiseaseId.Frogitch => AlchemySignatureEffectKind.CureFrogitch,
+            DiseaseId.WoundFever => AlchemySignatureEffectKind.CureWoundFever,
+            DiseaseId.Mirefoot => AlchemySignatureEffectKind.CureMirefoot,
+            DiseaseId.BlackwaterBelly => AlchemySignatureEffectKind.CureBlackwaterBelly,
+            DiseaseId.Leechblood => AlchemySignatureEffectKind.CureLeechblood,
+            DiseaseId.BoneChillAgue => AlchemySignatureEffectKind.CureBoneChillAgue,
+            DiseaseId.SwampRot => AlchemySignatureEffectKind.CureSwampRot,
+            DiseaseId.RedscalePox => AlchemySignatureEffectKind.CureRedscalePox,
+            DiseaseId.GraveDamp => AlchemySignatureEffectKind.CureGraveDamp,
+            DiseaseId.HollowLung => AlchemySignatureEffectKind.CureHollowLung,
+            _ => AlchemySignatureEffectKind.None,
+        };
+    }
+
+    public static DiseaseId DiseaseForCureEffect(AlchemySignatureEffectKind effect)
+    {
+        return effect switch
+        {
+            AlchemySignatureEffectKind.CureRawcapGut => DiseaseId.RawcapGut,
+            AlchemySignatureEffectKind.CureMarshCough => DiseaseId.MarshCough,
+            AlchemySignatureEffectKind.CureFrogitch => DiseaseId.Frogitch,
+            AlchemySignatureEffectKind.CureWoundFever => DiseaseId.WoundFever,
+            AlchemySignatureEffectKind.CureMirefoot => DiseaseId.Mirefoot,
+            AlchemySignatureEffectKind.CureBlackwaterBelly => DiseaseId.BlackwaterBelly,
+            AlchemySignatureEffectKind.CureLeechblood => DiseaseId.Leechblood,
+            AlchemySignatureEffectKind.CureBoneChillAgue => DiseaseId.BoneChillAgue,
+            AlchemySignatureEffectKind.CureSwampRot => DiseaseId.SwampRot,
+            AlchemySignatureEffectKind.CureRedscalePox => DiseaseId.RedscalePox,
+            AlchemySignatureEffectKind.CureGraveDamp => DiseaseId.GraveDamp,
+            AlchemySignatureEffectKind.CureHollowLung => DiseaseId.HollowLung,
+            _ => DiseaseId.None,
+        };
+    }
+
+    public static float RollDuration(in Definition def) =>
+        UnityEngine.Random.Range(def.MinDurationSeconds, def.MaxDurationSeconds);
+
+    public static bool IsColdBiome(BiomeType biome) =>
+        biome is BiomeType.Snow or BiomeType.Tundra or BiomeType.Mountain;
+}
