@@ -0,0 +1,885 @@
+#if UNITY_EDITOR
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text;
+using InventoryFramework;
+using Mirror;
+using UnityEditor;
+using UnityEditor.Animations;
+using UnityEngine;
+using Object = UnityEngine.Object;
+
+[InitializeOnLoad]
+internal static class DrucladAutoSetupOnLoad
+{
+    static DrucladAutoSetupOnLoad()
+    {
+        DrucladSetupEditorTools.ResetAutoSetupPass();
+        EditorApplication.delayCall += DrucladSetupEditorTools.AutoSetupIfNeeded;
+        UnityEditor.Compilation.CompilationPipeline.compilationFinished += _ =>
+        {
+            DrucladSetupEditorTools.ResetAutoSetupPass();
+            EditorApplication.delayCall += DrucladSetupEditorTools.AutoSetupIfNeeded;
+        };
+    }
+}
+
+/// <summary>
+/// One-click Druclad setup: Humanoid retarget from Mixamo (or project fallbacks),
+/// animator controller, networked prefab, spawn registration.
+/// </summary>
+public static class DrucladSetupEditorTools
+{
+    private const string ModelPath = DrucladAnimCatalog.RiggedModelPath;
+    private const string PrefabPath = DrucladWorldSpawner.PrefabAssetPath;
+    private const string AnimatorPath = DrucladAnimCatalog.AnimatorPath;
+    private const string ClipsFolder = DrucladAnimCatalog.ClipsFolder;
+    private const string LootTablePath = "Assets/Data/Creatures/DrucladLootTable.asset";
+    private const string LootBagPath = "Assets/GameObjects/Prefabs/Networked/Loot Bag_Object.prefab";
+    private const string NetworkManagerPath = "Assets/GameObjects/Prefabs/NetworkManager.prefab";
+    private const string ResourcesPrefabPath = "Assets/Resources/Druclad.prefab";
+    private const string BodyFirePrefabPath = DrucladFirePresentation.HellhoundBodyFirePrefabPath;
+    private const string ItemDatabasePath = "Assets/ScriptableObjects/Items/ManafallItemDatabase.asset";
+    private const string EmberAshPath = "Assets/ScriptableObjects/Items/Abyssal Ember Ash.asset";
+    private const string CinderScalePath = "Assets/ScriptableObjects/Items/Void Cinder Scale.asset";
+    private const string HornShardPath = "Assets/ScriptableObjects/Items/Druclad Horn Shard.asset";
+    private const string FireHeartPath = "Assets/ScriptableObjects/Items/Abyss Fire Heart.asset";
+    private const int EmberAshId = 7820;
+    private const int CinderScaleId = 7821;
+    private const int HornShardId = 7822;
+    private const int FireHeartId = 7823;
+
+    private const float ModelScale = 3.35f;
+    private const uint NetworkAssetId = 4182736501u;
+    private const float BossMaxHealth = 4200f;
+
+    private static bool isRunningSetup;
+    private static bool autoSetupAttemptedThisPass;
+
+    [MenuItem("Manafall/Creatures/Setup Druclad", priority = 54)]
+    public static void SetupDrucladFullMenu() => SetupDrucladFull();
+
+    [MenuItem("Manafall/Creatures/Setup Druclad Animations Only", priority = 55)]
+    public static void SetupDrucladAnimationsOnlyMenu() => SetupDrucladAnimationsOnly();
+
+    public static void ResetAutoSetupPass() => autoSetupAttemptedThisPass = false;
+
+    public static void AutoSetupIfNeeded()
+    {
+        if (ManafallEditorPlayMode.BlocksAutoSetup)
+            return;
+        if (!File.Exists(ModelPath))
+            return;
+        if (isRunningSetup || autoSetupAttemptedThisPass)
+            return;
+
+        try
+        {
+            isRunningSetup = true;
+            if (NeedsSetupPass())
+                SetupDrucladFull();
+            else
+                RegisterSpawnablePrefab(null, AssetDatabase.LoadAssetAtPath<GameObject>(PrefabPath));
+        }
+        catch (Exception ex)
+        {
+            Debug.LogWarning($"Manafall: Druclad auto-setup failed this pass. Reason: {ex.Message}");
+        }
+        finally
+        {
+            autoSetupAttemptedThisPass = true;
+            isRunningSetup = false;
+        }
+    }
+
+    public static void SetupDrucladFull()
+    {
+        var log = new StringBuilder();
+        log.AppendLine("=== Manafall: Setup Druclad ===");
+
+        EnsureFolder("Assets/Animation");
+        EnsureFolder("Assets/Data/Creatures");
+        EnsureFolder("Assets/GameObjects/Prefabs/Networked");
+        EnsureFolder("Assets/ScriptableObjects/Items");
+        EnsureFolder(ClipsFolder);
+        EnsureFolder("Assets/Resources");
+
+        ConfigureHumanoidModel(log);
+        EnsureFallbackClipCopies(log);
+        ConfigureClipHumanoids(log);
+
+        Item emberAsh = EnsureItem(EmberAshPath, EmberAshId, "Abyssal Ember Ash",
+            "Fine ash that still smolders with void heat.", 30);
+        Item cinderScale = EnsureItem(CinderScalePath, CinderScaleId, "Void Cinder Scale",
+            "A plate of cooled magma from Druclad's hide.", 12);
+        Item hornShard = EnsureItem(HornShardPath, HornShardId, "Druclad Horn Shard",
+            "A jagged horn fragment glowing with abyss fire.", 4);
+        Item fireHeart = EnsureItem(FireHeartPath, FireHeartId, "Abyss Fire Heart",
+            "The rare core of the void fire boss — still pulsing heat.", 1);
+
+        RegisterItemInDatabase(log, emberAsh);
+        RegisterItemInDatabase(log, cinderScale);
+        RegisterItemInDatabase(log, hornShard);
+        RegisterItemInDatabase(log, fireHeart);
+
+        DrucladLootTable lootTable = EnsureLootTable(log, emberAsh, cinderScale, hornShard, fireHeart);
+        RuntimeAnimatorController animator = BuildAnimatorController(log);
+        RecreatePrefab(log, animator, lootTable);
+        RegisterSpawnablePrefab(log, AssetDatabase.LoadAssetAtPath<GameObject>(PrefabPath));
+
+        AssetDatabase.SaveAssets();
+        AssetDatabase.Refresh();
+        Debug.Log(log.ToString());
+    }
+
+    public static void SetupDrucladAnimationsOnly()
+    {
+        var log = new StringBuilder();
+        log.AppendLine("=== Manafall: Setup Druclad Animations ===");
+        ConfigureHumanoidModel(log);
+        EnsureFallbackClipCopies(log);
+        ConfigureClipHumanoids(log);
+        RuntimeAnimatorController animator = BuildAnimatorController(log);
+        GameObject prefab = AssetDatabase.LoadAssetAtPath<GameObject>(PrefabPath);
+        if (prefab != null && animator != null)
+        {
+            DrucladLootTable loot = AssetDatabase.LoadAssetAtPath<DrucladLootTable>(LootTablePath);
+            WireExistingPrefab(prefab, animator, loot, log);
+        }
+
+        AssetDatabase.SaveAssets();
+        AssetDatabase.Refresh();
+        Debug.Log(log.ToString());
+    }
+
+    public static void RunBatchSetupFromCommandLine()
+    {
+        AutoSetupIfNeeded();
+        SetupDrucladFull();
+        AssetDatabase.SaveAssets();
+        AssetDatabase.Refresh();
+        EditorApplication.Exit(0);
+    }
+
+    private static bool NeedsSetupPass()
+    {
+        GameObject prefabAsset = AssetDatabase.LoadAssetAtPath<GameObject>(PrefabPath);
+        if (prefabAsset == null)
+            return true;
+        if (prefabAsset.GetComponent<DrucladController>() == null)
+            return true;
+        if (prefabAsset.GetComponent<Health>() == null)
+            return true;
+        if (prefabAsset.GetComponent<CharacterController>() == null)
+            return true;
+        if (AssetDatabase.LoadAssetAtPath<RuntimeAnimatorController>(AnimatorPath) == null)
+            return true;
+        return false;
+    }
+
+    private static void ConfigureHumanoidModel(StringBuilder log)
+    {
+        var importer = AssetImporter.GetAtPath(ModelPath) as ModelImporter;
+        if (importer == null)
+        {
+            log.AppendLine($"  ERROR: missing model importer at {ModelPath}");
+            return;
+        }
+
+        bool dirty = false;
+        if (importer.animationType != ModelImporterAnimationType.Human)
+        {
+            importer.animationType = ModelImporterAnimationType.Human;
+            dirty = true;
+        }
+
+        if (importer.avatarSetup != ModelImporterAvatarSetup.CreateFromThisModel)
+        {
+            importer.avatarSetup = ModelImporterAvatarSetup.CreateFromThisModel;
+            dirty = true;
+        }
+
+        importer.globalScale = 1f;
+        if (dirty)
+        {
+            importer.SaveAndReimport();
+            log.AppendLine("  Configured Druclad_MixamoRigged as Humanoid.");
+        }
+        else
+        {
+            log.AppendLine("  Druclad Humanoid already configured.");
+        }
+    }
+
+    private static Avatar LoadDrucladAvatar()
+    {
+        foreach (Object sub in AssetDatabase.LoadAllAssetsAtPath(ModelPath))
+        {
+            if (sub is Avatar avatar)
+                return avatar;
+        }
+
+        return null;
+    }
+
+    private static void EnsureFallbackClipCopies(StringBuilder log)
+    {
+        EnsureFolder(ClipsFolder);
+        CopyClipIfMissing(DrucladAnimCatalog.IdlePreferred, DrucladAnimCatalog.IdleFallback, log);
+        CopyClipIfMissing(DrucladAnimCatalog.WalkPreferred, DrucladAnimCatalog.WalkFallback, log);
+        CopyClipIfMissing(DrucladAnimCatalog.RunPreferred, DrucladAnimCatalog.RunFallback, log);
+        CopyClipIfMissing(DrucladAnimCatalog.RoarPreferred, DrucladAnimCatalog.RoarFallback, log);
+        CopyClipIfMissing(DrucladAnimCatalog.HitPreferred, DrucladAnimCatalog.HitFallback, log);
+        CopyClipIfMissing(DrucladAnimCatalog.DeathPreferred, DrucladAnimCatalog.DeathFallback, log);
+        CopyClipIfMissing(DrucladAnimCatalog.SwipeLPreferred, DrucladAnimCatalog.SwipeLFallback, log);
+        CopyClipIfMissing(DrucladAnimCatalog.SwipeRPreferred, DrucladAnimCatalog.SwipeRFallback, log);
+        CopyClipIfMissing(DrucladAnimCatalog.OverheadPreferred, DrucladAnimCatalog.OverheadFallback, log);
+        CopyClipIfMissing(DrucladAnimCatalog.StompPreferred, DrucladAnimCatalog.StompFallback, log);
+        CopyClipIfMissing(DrucladAnimCatalog.BreathWindupPreferred, DrucladAnimCatalog.BreathWindupFallback, log);
+        CopyClipIfMissing(DrucladAnimCatalog.HurlPreferred, DrucladAnimCatalog.HurlFallback, log);
+        CopyClipIfMissing(DrucladAnimCatalog.ClapPreferred, DrucladAnimCatalog.ClapFallback, log);
+    }
+
+    private static void CopyClipIfMissing(string preferredFileName, string fallbackPath, StringBuilder log)
+    {
+        string dest = $"{ClipsFolder}/{preferredFileName}";
+        if (File.Exists(dest))
+            return;
+
+        if (!File.Exists(fallbackPath))
+        {
+            log.AppendLine($"  WARN: fallback missing for {preferredFileName}: {fallbackPath}");
+            return;
+        }
+
+        EnsureFolder(ClipsFolder);
+        if (AssetDatabase.CopyAsset(fallbackPath, dest))
+            log.AppendLine($"  Copied clip {preferredFileName}");
+        else
+            log.AppendLine($"  WARN: failed to copy {fallbackPath} → {dest}");
+    }
+
+    private static void ConfigureClipHumanoids(StringBuilder log)
+    {
+        Avatar avatar = LoadDrucladAvatar();
+        if (avatar == null)
+        {
+            log.AppendLine("  WARN: Druclad Avatar missing — clip retarget skipped.");
+            return;
+        }
+
+        string[] guids = AssetDatabase.FindAssets("t:Model", new[] { ClipsFolder });
+        for (int i = 0; i < guids.Length; i++)
+        {
+            string path = AssetDatabase.GUIDToAssetPath(guids[i]);
+            if (!path.EndsWith(".fbx", StringComparison.OrdinalIgnoreCase))
+                continue;
+
+            var importer = AssetImporter.GetAtPath(path) as ModelImporter;
+            if (importer == null)
+                continue;
+
+            importer.animationType = ModelImporterAnimationType.Human;
+            importer.avatarSetup = ModelImporterAvatarSetup.CopyFromOther;
+            importer.sourceAvatar = avatar;
+            importer.SaveAndReimport();
+            log.AppendLine($"  Retargeted {Path.GetFileName(path)} → Druclad Avatar");
+        }
+    }
+
+    private static RuntimeAnimatorController BuildAnimatorController(StringBuilder log)
+    {
+        Dictionary<string, AnimationClip> clips = LoadClipsFromFolder();
+        if (clips.Count == 0)
+        {
+            log.AppendLine("  WARN: no Druclad clips found — animator not built.");
+            return null;
+        }
+
+        AnimationClip idle = FindClip(clips, "idle", "monster") ?? FirstClip(clips);
+        AnimationClip walk = FindClip(clips, "walk", "zombie walk") ?? idle;
+        AnimationClip run = FindClip(clips, "run") ?? walk;
+        AnimationClip roar = FindClip(clips, "roar") ?? FindClip(clips, "attack") ?? idle;
+        AnimationClip hit = FindClip(clips, "impact", "hit", "reaction") ?? idle;
+        AnimationClip die = FindClip(clips, "dying", "death", "die") ?? hit;
+        AnimationClip swipeL = FindClip(clips, "punch") ?? FindClip(clips, "swipe") ?? idle;
+        AnimationClip swipeR = FindClip(clips, "hook") ?? FindClip(clips, "attack (1)") ?? swipeL;
+        AnimationClip overhead = FindClip(clips, "overhead", "axe") ?? swipeR;
+        AnimationClip stomp = FindClip(clips, "jump", "stomp") ?? overhead;
+        AnimationClip breath = FindClip(clips, "spell", "breath", "casting") ?? roar;
+        AnimationClip hurl = FindClip(clips, "frisbee", "throw", "hurl") ?? swipeL;
+        AnimationClip clap = FindClip(clips, "clap", "sky") ?? breath;
+
+        if (File.Exists(AnimatorPath))
+            AssetDatabase.DeleteAsset(AnimatorPath);
+
+        AnimatorController controller = AnimatorController.CreateAnimatorControllerAtPath(AnimatorPath);
+        controller.AddParameter(DrucladAnimCatalog.SpeedParam, AnimatorControllerParameterType.Float);
+        controller.AddParameter(DrucladAnimCatalog.DeadBool, AnimatorControllerParameterType.Bool);
+        controller.AddParameter(DrucladAnimCatalog.HurtTrigger, AnimatorControllerParameterType.Trigger);
+        controller.AddParameter(DrucladAnimCatalog.DieTrigger, AnimatorControllerParameterType.Trigger);
+        controller.AddParameter(DrucladAnimCatalog.RoarTrigger, AnimatorControllerParameterType.Trigger);
+
+        for (int i = 0; i < DrucladAnimCatalog.Attacks.Length; i++)
+            controller.AddParameter(DrucladAnimCatalog.Attacks[i].TriggerName, AnimatorControllerParameterType.Trigger);
+
+        AnimatorStateMachine sm = controller.layers[0].stateMachine;
+
+        BlendTree loco;
+        AnimatorState locoState = controller.CreateBlendTreeInController(DrucladAnimCatalog.LocomotionState, out loco, 0);
+        loco.blendType = BlendTreeType.Simple1D;
+        loco.blendParameter = DrucladAnimCatalog.SpeedParam;
+        loco.useAutomaticThresholds = false;
+        loco.AddChild(idle, 0f);
+        loco.AddChild(walk, 2.2f);
+        loco.AddChild(run, 5.2f);
+        sm.defaultState = locoState;
+
+        AnimatorState roarState = AddState(sm, "Roar", roar, new Vector3(420f, -160f, 0f));
+        AnimatorState hurtState = AddState(sm, "Hurt", hit, new Vector3(620f, -40f, 0f));
+        AnimatorState dieState = AddState(sm, DrucladAnimCatalog.DieState, die, new Vector3(620f, -160f, 0f));
+
+        AddTriggerAny(sm, DrucladAnimCatalog.RoarTrigger, roarState, locoState, 0.92f);
+        AddTriggerAny(sm, DrucladAnimCatalog.HurtTrigger, hurtState, locoState, 0.55f);
+        AddTriggerAny(sm, DrucladAnimCatalog.DieTrigger, dieState, null, 0.98f, exitOnly: true);
+
+        AddAttackState(sm, locoState, "AshSwipeL", swipeL, DrucladAnimCatalog.AttackId.AshSwipeL);
+        AddAttackState(sm, locoState, "AshSwipeR", swipeR, DrucladAnimCatalog.AttackId.AshSwipeR);
+        AddAttackState(sm, locoState, "MagmaStomp", stomp, DrucladAnimCatalog.AttackId.MagmaStomp);
+        AddAttackState(sm, locoState, "CinderBolt", hurl, DrucladAnimCatalog.AttackId.CinderBolt);
+        AddAttackState(sm, locoState, "InfernoBreath", breath, DrucladAnimCatalog.AttackId.InfernoBreath);
+        AddAttackState(sm, locoState, "TwinBolts", hurl, DrucladAnimCatalog.AttackId.TwinBolts);
+        AddAttackState(sm, locoState, "EruptionStep", stomp, DrucladAnimCatalog.AttackId.EruptionStep);
+        AddAttackState(sm, locoState, "MeteorRain", clap, DrucladAnimCatalog.AttackId.MeteorRain);
+        AddAttackState(sm, locoState, "WorldbreakerSlam", overhead, DrucladAnimCatalog.AttackId.WorldbreakerSlam);
+        AddAttackState(sm, locoState, "BreathSwipeString", breath, DrucladAnimCatalog.AttackId.BreathSwipeString);
+
+        EditorUtility.SetDirty(controller);
+        AssetDatabase.SaveAssets();
+        log.AppendLine($"  Built {AnimatorPath} with {clips.Count} clips.");
+        return controller;
+    }
