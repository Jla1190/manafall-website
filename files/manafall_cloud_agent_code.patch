diff --git a/Assets/Scripts/Creatures/Druclad/DrucladBrain.cs b/Assets/Scripts/Creatures/Druclad/DrucladBrain.cs
new file mode 100644
index 000000000..b478e027d
--- /dev/null
+++ b/Assets/Scripts/Creatures/Druclad/DrucladBrain.cs
@@ -0,0 +1,263 @@
+using UnityEngine;
+
+/// <summary>
+/// Phased combat brain for Druclad: close-in / reposition / hold / attack / channel / rain.
+/// Weights by phase, distance band, and breath-cone occupancy.
+/// </summary>
+public sealed class DrucladBrain
+{
+    public enum Intent : byte
+    {
+        Hold = 0,
+        CloseIn = 1,
+        Reposition = 2,
+        Attack = 3,
+        ChannelBreath = 4,
+        CallRain = 5,
+        Flee = 6,
+        Awaken = 7,
+        Dead = 8,
+    }
+
+    public struct TickInput
+    {
+        public Vector3 selfPosition;
+        public Vector3 selfForward;
+        public float now;
+        public float deltaTime;
+        public Vector3? targetPosition;
+        public float targetDistance;
+        public bool hasTarget;
+        public bool isDead;
+        public bool isMoveLocked;
+        public bool canAttack;
+        public bool playerOnVoid;
+        public bool awakening;
+        public byte phase;
+        public bool playerInBreathCone;
+        public bool playerBehind;
+        public float softEnrage01;
+        public System.Func<DrucladAnimCatalog.AttackId, bool> isAttackReady;
+    }
+
+    public struct TickOutput
+    {
+        public Intent intent;
+        public Vector3 desiredFacing;
+        public Vector3 desiredMove;
+        public float desiredSpeed;
+        public DrucladAnimCatalog.AttackId attackId;
+        public bool triggerAttack;
+    }
+
+    private readonly float meleeRange;
+    private readonly float midRange;
+    private readonly float farRange;
+    private readonly float flankBias;
+    private int strafeSign = 1;
+    private float nextStrafeFlip;
+    private DrucladAnimCatalog.AttackId lastAttack = DrucladAnimCatalog.AttackId.None;
+    private float lastRainAt = -999f;
+
+    public DrucladBrain(float meleeRange, float midRange, float farRange, float flankBias)
+    {
+        this.meleeRange = Mathf.Max(1.5f, meleeRange);
+        this.midRange = Mathf.Max(this.meleeRange + 0.5f, midRange);
+        this.farRange = Mathf.Max(this.midRange + 1f, farRange);
+        this.flankBias = Mathf.Clamp01(flankBias);
+    }
+
+    public void Initialize(float now)
+    {
+        strafeSign = Random.value > 0.5f ? 1 : -1;
+        nextStrafeFlip = now + Random.Range(1.2f, 2.4f);
+        lastAttack = DrucladAnimCatalog.AttackId.None;
+        lastRainAt = -999f;
+    }
+
+    public void NotifyAttackCommitted(DrucladAnimCatalog.AttackId id, float now)
+    {
+        lastAttack = id;
+        if (id == DrucladAnimCatalog.AttackId.MeteorRain)
+            lastRainAt = now;
+    }
+
+    public TickOutput Tick(in TickInput input)
+    {
+        TickOutput output = default;
+        output.desiredFacing = input.selfForward.sqrMagnitude > 0.001f
+            ? Flatten(input.selfForward).normalized
+            : Vector3.forward;
+        output.desiredMove = Vector3.zero;
+        output.desiredSpeed = 0f;
+        output.attackId = DrucladAnimCatalog.AttackId.None;
+
+        if (input.isDead)
+        {
+            output.intent = Intent.Dead;
+            return output;
+        }
+
+        if (input.awakening)
+        {
+            output.intent = Intent.Awaken;
+            return output;
+        }
+
+        if (!input.playerOnVoid)
+        {
+            output.intent = Intent.Flee;
+            return output;
+        }
+
+        if (!input.hasTarget || !input.targetPosition.HasValue)
+        {
+            output.intent = Intent.Hold;
+            return output;
+        }
+
+        Vector3 toTarget = Flatten(input.targetPosition.Value - input.selfPosition);
+        if (toTarget.sqrMagnitude < 0.001f)
+            toTarget = output.desiredFacing;
+        Vector3 direct = toTarget.normalized;
+        Vector3 right = Vector3.Cross(Vector3.up, direct).normalized;
+        output.desiredFacing = direct;
+
+        if (input.isMoveLocked)
+        {
+            output.intent = Intent.Hold;
+            return output;
+        }
+
+        if (input.now >= nextStrafeFlip)
+        {
+            strafeSign *= -1;
+            nextStrafeFlip = input.now + Random.Range(1.1f, 2.6f);
+        }
+
+        float dist = input.targetDistance;
+        bool melee = dist <= meleeRange;
+        bool mid = dist > meleeRange && dist <= midRange;
+        bool far = dist > midRange;
+
+        if (input.canAttack)
+        {
+            DrucladAnimCatalog.AttackId pick = ChooseAttack(in input, melee, mid, far);
+            if (pick != DrucladAnimCatalog.AttackId.None)
+            {
+                output.triggerAttack = true;
+                output.attackId = pick;
+                if (pick == DrucladAnimCatalog.AttackId.InfernoBreath
+                    || pick == DrucladAnimCatalog.AttackId.BreathSwipeString)
+                {
+                    output.intent = Intent.ChannelBreath;
+                }
+                else if (pick == DrucladAnimCatalog.AttackId.MeteorRain)
+                {
+                    output.intent = Intent.CallRain;
+                }
+                else
+                {
+                    output.intent = Intent.Attack;
+                }
+
+                return output;
+            }
+        }
+
+        if (melee)
+        {
+            // Slight back-step / circle so breath and stomp stay readable.
+            output.intent = Intent.Reposition;
+            Vector3 circle = (-direct * 0.35f + right * (strafeSign * flankBias)).normalized;
+            output.desiredMove = circle;
+            output.desiredSpeed = 0.55f;
+            return output;
+        }
+
+        if (mid)
+        {
+            output.intent = Intent.Reposition;
+            Vector3 circle = (direct * (1f - flankBias * 0.55f) + right * (strafeSign * flankBias)).normalized;
+            output.desiredMove = circle;
+            output.desiredSpeed = 0.85f;
+            return output;
+        }
+
+        output.intent = Intent.CloseIn;
+        output.desiredMove = direct;
+        output.desiredSpeed = Mathf.Lerp(0.75f, 1f, Mathf.InverseLerp(midRange, farRange, dist));
+        return output;
+    }
+
+    private DrucladAnimCatalog.AttackId ChooseAttack(in TickInput input, bool melee, bool mid, bool far)
+    {
+        byte phase = (byte)Mathf.Clamp(input.phase, 1, 3);
+        float enrage = Mathf.Clamp01(input.softEnrage01);
+        bool Ready(DrucladAnimCatalog.AttackId id)
+        {
+            if (input.isAttackReady != null && !input.isAttackReady(id))
+                return false;
+            if (!DrucladAnimCatalog.TryGet(id, out DrucladAnimCatalog.AttackDef def))
+                return false;
+            return def.MinPhase <= phase;
+        }
+
+        // Never back-to-back rain.
+        float rainGap = Mathf.Lerp(11f, 7.5f, enrage);
+        bool rainOk = input.now - lastRainAt >= rainGap;
+
+        if (phase >= 3 && rainOk && (far || mid) && Ready(DrucladAnimCatalog.AttackId.MeteorRain)
+            && lastAttack != DrucladAnimCatalog.AttackId.MeteorRain
+            && Random.value < 0.38f + enrage * 0.2f)
+            return DrucladAnimCatalog.AttackId.MeteorRain;
+
+        if (phase >= 3 && melee && Ready(DrucladAnimCatalog.AttackId.WorldbreakerSlam)
+            && Random.value < 0.28f)
+            return DrucladAnimCatalog.AttackId.WorldbreakerSlam;
+
+        if (phase >= 3 && mid && Ready(DrucladAnimCatalog.AttackId.BreathSwipeString)
+            && Random.value < 0.32f)
+            return DrucladAnimCatalog.AttackId.BreathSwipeString;
+
+        if (phase >= 2 && (mid || input.playerInBreathCone) && Ready(DrucladAnimCatalog.AttackId.InfernoBreath)
+            && Random.value < (input.playerInBreathCone ? 0.55f : 0.28f))
+            return DrucladAnimCatalog.AttackId.InfernoBreath;
+
+        if (phase >= 2 && mid && Ready(DrucladAnimCatalog.AttackId.EruptionStep)
+            && Random.value < 0.30f)
+            return DrucladAnimCatalog.AttackId.EruptionStep;
+
+        if (phase >= 2 && (mid || far) && Ready(DrucladAnimCatalog.AttackId.TwinBolts)
+            && Random.value < 0.34f + enrage * 0.15f)
+            return DrucladAnimCatalog.AttackId.TwinBolts;
+
+        if (melee && Ready(DrucladAnimCatalog.AttackId.MagmaStomp) && Random.value < 0.36f)
+            return DrucladAnimCatalog.AttackId.MagmaStomp;
+
+        if ((mid || far) && Ready(DrucladAnimCatalog.AttackId.CinderBolt) && Random.value < 0.42f)
+            return DrucladAnimCatalog.AttackId.CinderBolt;
+
+        if (melee || mid)
+        {
+            bool left = Random.value > 0.5f;
+            DrucladAnimCatalog.AttackId swipe = left
+                ? DrucladAnimCatalog.AttackId.AshSwipeL
+                : DrucladAnimCatalog.AttackId.AshSwipeR;
+            if (Ready(swipe))
+                return swipe;
+            swipe = left
+                ? DrucladAnimCatalog.AttackId.AshSwipeR
+                : DrucladAnimCatalog.AttackId.AshSwipeL;
+            if (Ready(swipe))
+                return swipe;
+        }
+
+        if (Ready(DrucladAnimCatalog.AttackId.CinderBolt))
+            return DrucladAnimCatalog.AttackId.CinderBolt;
+
+        return DrucladAnimCatalog.AttackId.None;
+    }
+
+    private static Vector3 Flatten(Vector3 v) => new Vector3(v.x, 0f, v.z);
+}
