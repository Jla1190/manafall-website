+using InventoryFramework;
+using UnityEngine;
+
+/// <summary>Small lingering magma patch (volcano-pool style, boss-scaled down).</summary>
+[DisallowMultipleComponent]
+public sealed class DrucladMagmaPuddle : MonoBehaviour
+{
+    private float radius;
+    private float damagePerTick;
+    private float tickInterval;
+    private float burnDuration;
+    private float dieAt;
+    private float nextTickAt;
+    private readonly Collider[] buffer = new Collider[12];
+
+    public static DrucladMagmaPuddle Spawn(
+        Vector3 groundPoint,
+        float radius,
+        float lifetime,
+        float damagePerTick,
+        float tickInterval = 0.35f,
+        float burnDuration = 1.8f)
+    {
+        var go = new GameObject("DrucladMagmaPuddle");
+        go.transform.position = groundPoint + Vector3.up * 0.03f;
+        var puddle = go.AddComponent<DrucladMagmaPuddle>();
+        puddle.radius = Mathf.Max(0.6f, radius);
+        puddle.damagePerTick = Mathf.Max(1f, damagePerTick);
+        puddle.tickInterval = Mathf.Max(0.12f, tickInterval);
+        puddle.burnDuration = Mathf.Max(0.4f, burnDuration);
+        puddle.dieAt = Time.time + Mathf.Max(0.4f, lifetime);
+        puddle.nextTickAt = Time.time;
+
+        SpellFocusVefectsBridge.PlaySmolderingGroundRing(
+            groundPoint,
+            Vector3.up,
+            radius: puddle.radius,
+            duration: lifetime,
+            patchScale: Mathf.Clamp(puddle.radius * 0.55f, 0.55f, 1.6f));
+
+        Object.Destroy(go, lifetime + 0.35f);
+        return puddle;
+    }
+
+    private void Update()
+    {
+        if (Time.time >= dieAt)
+        {
+            Destroy(gameObject);
+            return;
+        }
+
+        if (Time.time < nextTickAt)
+            return;
+
+        nextTickAt = Time.time + tickInterval;
+        int count = Physics.OverlapSphereNonAlloc(
+            transform.position,
+            radius,
+            buffer,
+            ~0,
+            QueryTriggerInteraction.Collide);
+
+        for (int i = 0; i < count; i++)
+        {
+            Collider col = buffer[i];
+            if (col == null || PlayerInteractionSphere.ShouldIgnoreEnemyCombatHit(col))
+                continue;
+
+            PlayerHealth player = col.GetComponentInParent<PlayerHealth>();
+            if (player == null || player.currentHealth <= 0.5f)
+                continue;
+
+            Vector3 knock = Vector3.up * 0.6f;
+            player.TakeDamage(damagePerTick, transform.position, knock);
+            SpellEffectCatalog.ApplyToPlayer(player, SpellEffectId.Burning, burnDuration);
+        }
+    }
+}
