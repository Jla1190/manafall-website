+using Mirror;
+using UnityEngine;
+
+/// <summary>
+/// Void-island only Druclad spawner. Awakens at most once per world seed while alive;
+/// permanent death is stored in <see cref="DrucladWorldFlags"/>.
+/// </summary>
+[DisallowMultipleComponent]
+public sealed class DrucladWorldSpawner : MonoBehaviour
+{
+    public const string PrefabResourcesName = "Druclad";
+    public const string PrefabAssetPath = "Assets/GameObjects/Prefabs/Networked/Druclad.prefab";
+
+    [SerializeField] private GameObject drucladPrefab;
+    [SerializeField] private float voidOccupancyThreshold = 0.22f;
+    [SerializeField] private float dwellSecondsBeforeAwaken = 6f;
+    [SerializeField] private float pollInterval = 0.75f;
+    [SerializeField] private float spawnHeightProbe = 80f;
+
+    private WorldGenerator world;
+    private float dwellAccum;
+    private float nextPollAt;
+    private bool spawnedThisSession;
+    private DrucladController liveInstance;
+
+    private void Awake()
+    {
+        world = GetComponent<WorldGenerator>() ?? FindFirstObjectByType<WorldGenerator>();
+    }
+
+    private void OnEnable()
+    {
+        dwellAccum = 0f;
+        nextPollAt = 0f;
+    }
+
+    private void Update()
+    {
+        if (!CanDriveSpawn())
+            return;
+
+        if (Time.time < nextPollAt)
+            return;
+        nextPollAt = Time.time + pollInterval;
+
+        if (spawnedThisSession && liveInstance != null && !liveInstance.IsDead)
+            return;
+
+        if (liveInstance != null && liveInstance.IsDead)
+            liveInstance = null;
+
+        int seed = world != null ? world.TerrainSeed : OfflineSoloSession.LockedWorldSeed;
+        if (!DrucladWorldFlags.CanSpawn(seed))
+            return;
+
+        if (!TryFindVoidPlayer(out Transform player, out Vector3 voidPoint))
+        {
+            dwellAccum = 0f;
+            return;
+        }
+
+        dwellAccum += pollInterval;
+        if (dwellAccum < dwellSecondsBeforeAwaken)
+            return;
+
+        TrySpawnAt(voidPoint, seed);
+    }
+
+    private bool CanDriveSpawn()
+    {
+        if (NetworkServer.active)
+            return true;
+        if (!NetworkServer.active && !NetworkClient.active)
+            return true;
+        return false;
+    }
+
+    private bool TryFindVoidPlayer(out Transform player, out Vector3 voidPoint)
+    {
+        player = null;
+        voidPoint = Vector3.zero;
+        PlayerHealth[] players = FindObjectsByType<PlayerHealth>(FindObjectsSortMode.None);
+        for (int i = 0; i < players.Length; i++)
+        {
+            PlayerHealth hp = players[i];
+            if (hp == null || hp.currentHealth <= 0.5f)
+                continue;
+
+            Vector3 p = hp.transform.position;
+            if (!IsOnVoid(p))
+                continue;
+
+            player = hp.transform;
+            voidPoint = p;
+            return true;
+        }
+
+        return false;
+    }
+
+    private bool IsOnVoid(Vector3 worldPos)
+    {
+        BiomeSettings settings = world != null ? world.BiomeSettings : null;
+        int seed = world != null ? world.TerrainSeed : 0;
+        float void01 = BiomeClimateSampler.SampleVoidDomain01(
+            Mathf.RoundToInt(worldPos.x),
+            Mathf.RoundToInt(worldPos.z),
+            seed,
+            settings);
+        return void01 >= voidOccupancyThreshold;
+    }
+
+    private void TrySpawnAt(Vector3 nearPlayer, int seed)
+    {
+        GameObject prefab = ResolvePrefab();
+        if (prefab == null)
+        {
+            Debug.LogWarning("[DrucladWorldSpawner] Prefab missing — run Manafall/Creatures/Setup Druclad.");
+            return;
+        }
+
+        BiomeClimateSampler.ResolveVoidLayout(
+            world != null ? world.BiomeSettings : null,
+            out Vector2 centerXZ,
+            out float radius);
+
+        Vector3 spawn = new Vector3(centerXZ.x, nearPlayer.y + 4f, centerXZ.y);
+        // Prefer a point on the void pad a short offset from the player, still near center.
+        Vector3 towardCenter = new Vector3(centerXZ.x - nearPlayer.x, 0f, centerXZ.y - nearPlayer.z);
+        if (towardCenter.sqrMagnitude > 1f)
+            spawn = nearPlayer + towardCenter.normalized * Mathf.Min(14f, towardCenter.magnitude * 0.45f);
+        spawn.y = nearPlayer.y + 6f;
+
+        if (Physics.Raycast(spawn + Vector3.up * spawnHeightProbe * 0.25f, Vector3.down, out RaycastHit hit, spawnHeightProbe))
+            spawn = hit.point;
+
+        GameObject instance = Instantiate(prefab, spawn, Quaternion.identity);
+        instance.name = "Druclad";
+        liveInstance = instance.GetComponent<DrucladController>();
+        spawnedThisSession = true;
+        DrucladWorldFlags.MarkAwakened(seed);
+
+        if (NetworkServer.active)
+        {
+            NetworkIdentity identity = instance.GetComponent<NetworkIdentity>();
+            if (identity != null)
+                NetworkServer.Spawn(instance);
+        }
+
+        Debug.Log($"[DrucladWorldSpawner] Awakened Druclad at {spawn} seed={seed} radius={radius:F0}");
+    }
+
+    private GameObject ResolvePrefab()
+    {
+        if (drucladPrefab != null)
+            return drucladPrefab;
+
+        GameObject fromResources = Resources.Load<GameObject>(PrefabResourcesName);
+        if (fromResources != null)
+        {
+            drucladPrefab = fromResources;
+            return fromResources;
+        }
+
+#if UNITY_EDITOR
+        drucladPrefab = UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(PrefabAssetPath);
+#endif
+        return drucladPrefab;
+    }
+
+    /// <summary>Editor / debug: force an awaken check immediately.</summary>
+    public void TrySpawnNow()
+    {
+        dwellAccum = dwellSecondsBeforeAwaken;
+        nextPollAt = 0f;
+    }
+}
