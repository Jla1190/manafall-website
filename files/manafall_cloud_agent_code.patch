+    private static bool TrySampleVoidFloatingIsland(
+        WorldGenerator world,
+        Chunk sampler,
+        Vector2Int chunkCoord,
+        int chunkSize,
+        int seed,
+        int candidateIndex,
+        FoliageSettings settings,
+        float padding,
+        float usable,
+        List<Vector3> treePositions,
+        List<Vector3> rockPositions,
+        List<FoliageSlot> results,
+        out FoliageSlot slot)
+    {
+        slot = default;
+        var rng = new System.Random(HashChunkSlot(seed, chunkCoord.x, chunkCoord.y, candidateIndex, 7753));
+        float scaleMin = Mathf.Min(settings.voidFloatingIslandScaleMin, settings.voidFloatingIslandScaleMax);
+        float scaleMax = Mathf.Max(settings.voidFloatingIslandScaleMin, settings.voidFloatingIslandScaleMax);
+        float hover = Mathf.Max(4f, settings.voidFloatingIslandHoverMeters);
+
+        for (int attempt = 0; attempt < 16; attempt++)
+        {
+            float localX = padding + (float)rng.NextDouble() * usable;
+            float localZ = padding + (float)rng.NextDouble() * usable;
+            int wx = Mathf.RoundToInt(chunkCoord.x * chunkSize + localX);
+            int wz = Mathf.RoundToInt(chunkCoord.y * chunkSize + localZ);
+            if (WorldTerrainHeightModifiers.SuppressesFoliageAt(wx, wz))
