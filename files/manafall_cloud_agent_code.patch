+using UnityEngine;
+
+/// <summary>
+/// Applies biome gravity to every active Rigidbody the same way (not player-only).
+/// Unity still integrates <see cref="Physics.gravity"/>; this adds the residual so net
+/// acceleration equals <see cref="BiomeGravity.GetAcceleration"/>.
+/// </summary>
+[DefaultExecutionOrder(-40)]
+[DisallowMultipleComponent]
+public sealed class BiomeGravityWorldDriver : MonoBehaviour
+{
+    public static BiomeGravityWorldDriver Instance { get; private set; }
+
+    [SerializeField] private float refreshIntervalSeconds = 0.35f;
+    [SerializeField] private int maxBodiesPerRefresh = 256;
+
+    private readonly System.Collections.Generic.List<Rigidbody> bodies =
+        new System.Collections.Generic.List<Rigidbody>(256);
+    private float nextRefreshAt;
+    private int refreshCursor;
+
+    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.SubsystemRegistration)]
+    private static void ResetStatics() => Instance = null;
+
+    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
+    private static void EnsureExists()
+    {
+        if (Instance != null)
+            return;
+
+        var go = new GameObject("BiomeGravityWorldDriver");
+        DontDestroyOnLoad(go);
+        go.AddComponent<BiomeGravityWorldDriver>();
+    }
+
+    private void Awake()
+    {
+        if (Instance != null && Instance != this)
+        {
+            Destroy(this);
+            return;
+        }
+
+        Instance = this;
+    }
+
+    private void OnDestroy()
+    {
+        if (Instance == this)
+            Instance = null;
+    }
+
+    private void FixedUpdate()
+    {
+        if (Time.unscaledTime >= nextRefreshAt)
+        {
+            nextRefreshAt = Time.unscaledTime + Mathf.Max(0.15f, refreshIntervalSeconds);
+            RefreshBodyCache();
+        }
+
+        for (int i = bodies.Count - 1; i >= 0; i--)
+        {
+            Rigidbody rb = bodies[i];
+            if (rb == null)
+            {
+                bodies.RemoveAt(i);
+                continue;
+            }
+
+            if (!rb.gameObject.activeInHierarchy || !rb.useGravity || rb.isKinematic)
+                continue;
+
+            float mul = BiomeGravity.SampleMultiplier(rb.worldCenterOfMass);
+            if (Mathf.Abs(mul - 1f) < 0.001f)
+                continue;
+
+            // Unity already applied Physics.gravity; add residual so net = g * mul.
+            rb.AddForce(Physics.gravity * (mul - 1f), ForceMode.Acceleration);
+        }
+    }
+
+    private void RefreshBodyCache()
+    {
+        Rigidbody[] found = FindObjectsByType<Rigidbody>(FindObjectsInactive.Exclude, FindObjectsSortMode.None);
+        if (found == null || found.Length == 0)
+        {
+            bodies.Clear();
+            refreshCursor = 0;
+            return;
+        }
+
+        int cap = Mathf.Max(32, maxBodiesPerRefresh);
+        if (found.Length <= cap)
+        {
+            bodies.Clear();
+            for (int i = 0; i < found.Length; i++)
+            {
+                Rigidbody rb = found[i];
+                if (rb != null && rb.useGravity && !rb.isKinematic)
+                    bodies.Add(rb);
+            }
+
+            refreshCursor = 0;
+            return;
+        }
+
+        // Rotate through the world so large sessions stay bounded.
+        bodies.Clear();
+        int start = refreshCursor % found.Length;
+        for (int n = 0; n < cap; n++)
+        {
+            Rigidbody rb = found[(start + n) % found.Length];
+            if (rb != null && rb.useGravity && !rb.isKinematic)
+                bodies.Add(rb);
+        }
+
+        refreshCursor = (start + cap) % found.Length;
+    }
+}
