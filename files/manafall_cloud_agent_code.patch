diff --git a/Assets/Scripts/Disease/DiseaseInfectionService.cs b/Assets/Scripts/Disease/DiseaseInfectionService.cs
new file mode 100644
index 000000000..99ab633cd
--- /dev/null
+++ b/Assets/Scripts/Disease/DiseaseInfectionService.cs
@@ -0,0 +1,166 @@
+using UnityEngine;
+
+/// <summary>Server/offline rolls for contracting mundane diseases.</summary>
+public static class DiseaseInfectionService
+{
+    private static readonly Collider[] UndeadProbe = new Collider[12];
+
+    /// <summary>
+    /// Tiny chance after a creature hit deals damage. Swamp and disease weights raise specific odds.
+    /// </summary>
+    public static bool ServerTryInfectFromCreatureHit(GameObject player, Vector3 hitOriginWorld)
+    {
+        PlayerDiseaseRuntime runtime = PlayerDiseaseRuntime.EnsureOn(player);
+        if (runtime == null)
+            return false;
+        if (runtime.ActiveCount >= DiseaseCatalog.MaxConcurrent)
+            return false;
+
+        BiomeType biome = SampleBiome(player);
+        bool inSwamp = biome == BiomeType.Swamp;
+        bool cold = DiseaseCatalog.IsColdBiome(biome);
+        bool undeadNear = ProbeUndeadNear(hitOriginWorld);
+
+        // Gate: most hits do nothing.
+        if (Random.value > DiseaseCatalog.BaseCombatHitChance * (inSwamp ? 2.5f : 1f))
+            return false;
+
+        DiseaseId picked = PickCombatDisease(inSwamp, cold, undeadNear);
+        if (picked == DiseaseId.None)
+            return false;
+
+        return runtime.ServerTryInfect(picked);
+    }
+
+    /// <summary>Slow ambient contraction while standing in swamp (and wet for Frogitch).</summary>
+    public static void ServerTryAmbientTick(GameObject player)
+    {
+        PlayerDiseaseRuntime runtime = PlayerDiseaseRuntime.EnsureOn(player);
+        if (runtime == null)
+            return;
+        if (runtime.ActiveCount >= DiseaseCatalog.MaxConcurrent)
+            return;
+
+        BiomeType biome = SampleBiome(player);
+        if (biome != BiomeType.Swamp)
+            return;
+
+        PlayerWetnessSystem wet = player.GetComponent<PlayerWetnessSystem>()
+            ?? player.GetComponentInChildren<PlayerWetnessSystem>(true);
+        bool wetOk = wet != null && wet.IsWet;
+
+        // ~once per ambient driver interval; keep chance low.
+        float roll = Random.value;
+        DiseaseId picked = DiseaseId.None;
+        if (roll < 0.012f)
+            picked = DiseaseId.MarshCough;
+        else if (roll < 0.022f && wetOk)
+            picked = DiseaseId.Frogitch;
+        else if (roll < 0.030f)
+            picked = DiseaseId.Mirefoot;
+        else if (roll < 0.034f)
+            picked = DiseaseId.SwampRot;
+        else if (roll < 0.036f)
+            picked = DiseaseId.HollowLung;
+
+        if (picked == DiseaseId.None || runtime.Has(picked))
+            return;
+
+        runtime.ServerTryInfect(picked);
+    }
+
+    /// <summary>Raw mushroom threshold reached → Rawcap Gut.</summary>
+    public static bool ServerTryInfectRawcapGut(GameObject player)
+    {
+        PlayerDiseaseRuntime runtime = PlayerDiseaseRuntime.EnsureOn(player);
+        if (runtime == null)
+            return false;
+        return runtime.ServerTryInfect(DiseaseId.RawcapGut);
+    }
+
+    private static DiseaseId PickCombatDisease(bool inSwamp, bool cold, bool undeadNear)
+    {
+        // Weighted pick among combat-capable diseases.
+        float total = 0f;
+        float wMarsh = Weight(DiseaseId.MarshCough, inSwamp, cold, undeadNear);
+        float wFrog = Weight(DiseaseId.Frogitch, inSwamp, cold, undeadNear);
+        float wWound = Weight(DiseaseId.WoundFever, inSwamp, cold, undeadNear);
+        float wMire = Weight(DiseaseId.Mirefoot, inSwamp, cold, undeadNear);
+        float wBlack = Weight(DiseaseId.BlackwaterBelly, inSwamp, cold, undeadNear);
+        float wLeech = Weight(DiseaseId.Leechblood, inSwamp, cold, undeadNear);
+        float wBone = Weight(DiseaseId.BoneChillAgue, inSwamp, cold, undeadNear);
+        float wRot = Weight(DiseaseId.SwampRot, inSwamp, cold, undeadNear);
+        float wPox = Weight(DiseaseId.RedscalePox, inSwamp, cold, undeadNear);
+        float wGrave = Weight(DiseaseId.GraveDamp, inSwamp, cold, undeadNear);
+        float wLung = Weight(DiseaseId.HollowLung, inSwamp, cold, undeadNear);
+
+        total = wMarsh + wFrog + wWound + wMire + wBlack + wLeech + wBone + wRot + wPox + wGrave + wLung;
+        if (total <= 0.0001f)
+            return DiseaseId.None;
+
+        float r = Random.value * total;
+        if ((r -= wMarsh) < 0f) return DiseaseId.MarshCough;
+        if ((r -= wFrog) < 0f) return DiseaseId.Frogitch;
+        if ((r -= wWound) < 0f) return DiseaseId.WoundFever;
+        if ((r -= wMire) < 0f) return DiseaseId.Mirefoot;
+        if ((r -= wBlack) < 0f) return DiseaseId.BlackwaterBelly;
+        if ((r -= wLeech) < 0f) return DiseaseId.Leechblood;
+        if ((r -= wBone) < 0f) return DiseaseId.BoneChillAgue;
+        if ((r -= wRot) < 0f) return DiseaseId.SwampRot;
+        if ((r -= wPox) < 0f) return DiseaseId.RedscalePox;
+        if ((r -= wGrave) < 0f) return DiseaseId.GraveDamp;
+        if ((r -= wLung) < 0f) return DiseaseId.HollowLung;
+        return DiseaseId.WoundFever;
+    }
+
+    private static float Weight(DiseaseId id, bool inSwamp, bool cold, bool undeadNear)
+    {
+        if (!DiseaseCatalog.TryGet(id, out DiseaseCatalog.Definition def))
+            return 0f;
+        if (def.CombatWeight <= 0f)
+            return 0f;
+
+        float w = def.CombatWeight;
+        if (inSwamp)
+            w *= def.SwampMultiplier;
+        else if (def.SwampMultiplier >= 6f)
+            w *= 0.25f; // swamp-favoring diseases rare elsewhere
+
+        if (def.PrefersColdBiome)
+            w *= cold ? 4f : 0.15f;
+        if (def.PrefersUndead)
+            w *= undeadNear ? 5f : 0.2f;
+
+        return w;
+    }
+
+    private static BiomeType SampleBiome(GameObject player)
+    {
+        if (player == null)
+            return BiomeType.Grassland;
+
+        WorldGenerator world = Object.FindFirstObjectByType<WorldGenerator>();
+        if (world == null)
+            return BiomeType.Grassland;
+
+        WorldGenerator.ClimateSample sample = world.SampleClimateAtWorldPosition(player.transform.position);
+        return sample.valid ? sample.biome : BiomeType.Grassland;
+    }
+
+    private static bool ProbeUndeadNear(Vector3 origin)
+    {
+        int hits = Physics.OverlapSphereNonAlloc(origin, 3.5f, UndeadProbe, ~0, QueryTriggerInteraction.Ignore);
+        for (int i = 0; i < hits; i++)
+        {
+            Collider c = UndeadProbe[i];
+            if (c == null)
+                continue;
+            if (c.GetComponentInParent<SkeletonController>() != null)
+                return true;
+            if (c.GetComponentInParent<ZombieEnemyController>() != null)
+                return true;
+        }
+
+        return false;
+    }
+}
