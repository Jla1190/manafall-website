@@ -0,0 +1,1082 @@
+using System.Collections;
+using System.Collections.Generic;
+using InventoryFramework;
+using Manafall.Creatures;
+using Mirror;
+using UnityEngine;
+
+/// <summary>
+/// Server-authoritative void-island fire boss. Mixamo Humanoid motor + phased attack kit
+/// with animation-synced hit frames (TrollController patterns + KillChallenger-style timings).
+/// </summary>
+[DisallowMultipleComponent]
+[RequireComponent(typeof(CharacterController))]
+[RequireComponent(typeof(NetworkIdentity))]
+[RequireComponent(typeof(Health))]
+[RequireComponent(typeof(DrucladFirePresentation))]
+[DefaultExecutionOrder(-100)]
+public sealed class DrucladController : NetworkBehaviour
+{
+    private const string PlayerTag = "Player";
+
+    public enum EncounterPhase : byte
+    {
+        Dormant = 0,
+        Awaken = 1,
+        Phase1 = 2,
+        Phase2 = 3,
+        Phase3 = 4,
+        Fleeing = 5,
+        Dead = 6,
+    }
+
+    [Header("References")]
+    [SerializeField] private CharacterController characterController;
+    [SerializeField] private Health health;
+    [SerializeField] private Animator animator;
+    [SerializeField] private RuntimeAnimatorController defaultRuntimeAnimatorController;
+    [SerializeField] private Transform breathMuzzle;
+    [SerializeField] private Transform castHand;
+    [SerializeField] private DrucladFireBreathVolume breathVolume;
+    [SerializeField] private DrucladFirePresentation firePresentation;
+    [SerializeField] private AudioSource bodyAudio;
+    [SerializeField] private GameObject lootBagPrefab;
+    [SerializeField] private DrucladLootTable deathLootTable;
+
+    [Header("Motor")]
+    [SerializeField] private float gravity = -24f;
+    [SerializeField] private float walkSpeed = 3.6f;
+    [SerializeField] private float chaseSpeed = 5.8f;
+    [SerializeField] private float phase2SpeedMul = 1.12f;
+    [SerializeField] private float phase3SpeedMul = 1.22f;
+    [SerializeField] private float turnSpeed = 6.2f;
+    [SerializeField] private float attackTurnSpeed = 12f;
+
+    [Header("Combat ranges")]
+    [SerializeField] private float meleeRange = 5.4f;
+    [SerializeField] private float midRange = 12f;
+    [SerializeField] private float farRange = 28f;
+    [SerializeField] private float acquireRange = 64f;
+    [SerializeField] private float loseTargetRange = 78f;
+    [SerializeField] private float attackAngleDegrees = 78f;
+    [SerializeField] private LayerMask meleeHitMask = ~0;
+
+    [Header("Damage")]
+    [SerializeField] private float swipeDamage = 38f;
+    [SerializeField] private float stompDamage = 52f;
+    [SerializeField] private float stompRadius = 6.2f;
+    [SerializeField] private float boltDamage = 28f;
+    [SerializeField] private float twinBoltDamage = 22f;
+    [SerializeField] private float breathDamageMul = 1f;
+    [SerializeField] private float worldbreakerDamage = 78f;
+    [SerializeField] private float worldbreakerRadius = 11f;
+    [SerializeField] private float meteorDamage = 46f;
+    [SerializeField] private float softEnrageAfterSeconds = 150f;
+
+    [Header("Encounter")]
+    [SerializeField] private float awakenImmuneSeconds = 1.65f;
+    [SerializeField] private float fleeGraceSeconds = 4.5f;
+    [SerializeField] private float voidOccupancyThreshold = 0.18f;
+    [SerializeField] private float maxHealthBoss = 4200f;
+
+    [Header("Animation")]
+    [SerializeField] private string speedParam = DrucladAnimCatalog.SpeedParam;
+    [SerializeField] private string deadBool = DrucladAnimCatalog.DeadBool;
+
+    [SyncVar(hook = nameof(OnDeadChanged))]
+    private bool isDead;
+
+    [SyncVar]
+    private float syncedLocomotionSpeed;
+
+    [SyncVar]
+    private byte syncedPhase;
+
+    [SyncVar(hook = nameof(OnHealthRatioChanged))]
+    private float syncedHealthRatio = 1f;
+
+    public bool IsDead => isDead;
+    public EncounterPhase CurrentPhase => (EncounterPhase)syncedPhase;
+    public byte CombatPhaseByte
+    {
+        get
+        {
+            return CurrentPhase switch
+            {
+                EncounterPhase.Phase1 => 1,
+                EncounterPhase.Phase2 => 2,
+                EncounterPhase.Phase3 => 3,
+                EncounterPhase.Awaken => 1,
+                _ => 0,
+            };
+        }
+    }
+
+    private Transform chaseTarget;
+    private float verticalVelocity;
+    private float moveLockUntil;
+    private float immuneUntil;
+    private float nextRetargetTime;
+    private float encounterStartedAt = -1f;
+    private float leftVoidSince = -1f;
+    private int activeAttackToken;
+    private Coroutine attackRoutine;
+    private Coroutine deathRoutine;
+    private DrucladBrain brain;
+    private WorldGenerator cachedWorld;
+    private NetworkAnimator networkAnimator;
+    private readonly Dictionary<DrucladAnimCatalog.AttackId, float> attackReadyAt =
+        new Dictionary<DrucladAnimCatalog.AttackId, float>(16);
+    private readonly Collider[] meleeBuffer = new Collider[20];
+    private readonly int[] triggerHashes = new int[32];
+    private readonly bool[] triggerPresent = new bool[32];
+    private int speedHash;
+    private int deadHash;
+    private int hurtHash;
+    private int dieHash;
+    private int roarHash;
+    private bool hasSpeed;
+    private bool hasDead;
+    private bool hasHurt;
+    private bool hasDie;
+    private bool hasRoar;
+    private bool offlineAiArmed;
+    private bool awakenPlayed;
+    private bool phase2Roared;
+    private bool phase3Roared;
+    private static bool NetworkSessionActive => NetworkServer.active || NetworkClient.active;
+    private bool HasAiAuthority => isServer || offlineAiArmed || !NetworkSessionActive;
+
+    private void Awake()
+    {
+        characterController ??= GetComponent<CharacterController>();
+        health ??= GetComponent<Health>();
+        animator ??= GetComponentInChildren<Animator>(true);
+        networkAnimator = GetComponent<NetworkAnimator>();
+        bodyAudio ??= GetComponent<AudioSource>() ?? GetComponentInChildren<AudioSource>(true);
+        if (breathVolume == null)
+            breathVolume = GetComponent<DrucladFireBreathVolume>()
+                ?? gameObject.AddComponent<DrucladFireBreathVolume>();
+        if (firePresentation == null)
+            firePresentation = GetComponent<DrucladFirePresentation>()
+                ?? gameObject.AddComponent<DrucladFirePresentation>();
+        BootstrapAnimator();
+        EnsureCharacterController();
+        BindFirePresentation();
+    }
+
+    private void OnEnable()
+    {
+        BindHealth();
+        BootstrapAnimator();
+        BindFirePresentation();
+        PushHealthRatioToClients(force: true);
+    }
+
+    private void OnDisable()
+    {
+        UnbindHealth();
+        breathVolume?.StopChannel();
+    }
+
+    public override void OnStartServer()
+    {
+        base.OnStartServer();
+        offlineAiArmed = false;
+        ServerBoot();
+    }
+
+    public override void OnStartClient()
+    {
+        base.OnStartClient();
+        BootstrapAnimator();
+        BindFirePresentation();
+        firePresentation?.SetHealthRatio(syncedHealthRatio);
+        if (!NetworkServer.active && !NetworkClient.active)
+            offlineAiArmed = true;
+    }
+
+    private void Start()
+    {
+        if (!NetworkSessionActive)
+        {
+            offlineAiArmed = true;
+            ServerBoot();
+        }
+    }
+
+    private void ServerBoot()
+    {
+        if (health != null)
+        {
+            health.DestroyOnDeath = false;
+            if (health.MaxHealth < maxHealthBoss * 0.5f)
+                health.ConfigureMaxHealth(maxHealthBoss, healToFull: true);
+        }
+
+        brain ??= new DrucladBrain(meleeRange, midRange, farRange, flankBias: 0.62f);
+        brain.Initialize(Time.time);
+        breathVolume?.Bind(this, ResolveBreathMuzzleTransform());
+        BindFirePresentation();
+        PushHealthRatioToClients(force: true);
+        syncedPhase = (byte)EncounterPhase.Awaken;
+        immuneUntil = Time.time + awakenImmuneSeconds;
+        encounterStartedAt = Time.time;
+        awakenPlayed = false;
+        phase2Roared = false;
+        phase3Roared = false;
+        attackReadyAt.Clear();
+    }
+
+    private void BindFirePresentation()
+    {
+        if (firePresentation == null)
+            return;
+
+        Transform anchor = transform;
+        if (animator != null)
+        {
+            Transform hips = animator.GetBoneTransform(HumanBodyBones.Hips)
+                ?? animator.GetBoneTransform(HumanBodyBones.Spine);
+            if (hips != null)
+                anchor = hips;
+        }
+
+        firePresentation.Bind(anchor, bodyAudio);
+        firePresentation.SetHealthRatio(syncedHealthRatio);
+    }
+
+    private void Update()
+    {
+        if (!HasAiAuthority || isDead)
+            return;
+
+        float dt = Time.deltaTime;
+        ApplyGravity(dt);
+        TickEncounter(dt);
+        if (Time.frameCount % 15 == 0)
+            PushHealthRatioToClients();
+        if (isDead || CurrentPhase == EncounterPhase.Fleeing || CurrentPhase == EncounterPhase.Dormant)
+            return;
+
+        TickCombat(dt);
+    }
+
+    private void TickEncounter(float dt)
+    {
+        bool onVoid = IsPlayerOnVoid(out Transform nearest);
+        if (nearest != null && (chaseTarget == null || !IsLivingPlayerTarget(chaseTarget)))
+            chaseTarget = nearest;
+
+        if (CurrentPhase == EncounterPhase.Awaken)
+        {
+            if (!awakenPlayed)
+            {
+                awakenPlayed = true;
+                SetAnimTrigger(DrucladAnimCatalog.RoarTrigger, roarHash, hasRoar);
+                firePresentation?.TriggerRoarFlare();
+                DrucladFireFx.PlayAwakenCrack(GetGroundPoint());
+                moveLockUntil = Mathf.Max(moveLockUntil, immuneUntil);
+            }
+
+            if (Time.time >= immuneUntil)
+                syncedPhase = (byte)EncounterPhase.Phase1;
+            return;
+        }
+
+        if (!onVoid)
+        {
+            if (leftVoidSince < 0f)
+                leftVoidSince = Time.time;
+            if (Time.time - leftVoidSince >= fleeGraceSeconds)
+            {
+                BeginFleeDespawn();
+                return;
+            }
+        }
+        else
+        {
+            leftVoidSince = -1f;
+        }
+
+        RefreshPhaseFromHealth();
+    }
+
+    private void RefreshPhaseFromHealth()
+    {
+        if (health == null || CurrentPhase < EncounterPhase.Phase1 || CurrentPhase > EncounterPhase.Phase3)
+            return;
+
+        float ratio = health.MaxHealth > 0.01f ? health.CurrentHealth / health.MaxHealth : 1f;
+        if (ratio <= 0.33f && CurrentPhase != EncounterPhase.Phase3)
+        {
+            syncedPhase = (byte)EncounterPhase.Phase3;
+            if (!phase3Roared)
+            {
+                phase3Roared = true;
+                SetAnimTrigger(DrucladAnimCatalog.RoarTrigger, roarHash, hasRoar);
+                firePresentation?.TriggerPhaseEnrageFlare();
+                moveLockUntil = Time.time + 1.1f;
+            }
+        }
+        else if (ratio <= 0.66f && CurrentPhase == EncounterPhase.Phase1)
+        {
+            syncedPhase = (byte)EncounterPhase.Phase2;
+            if (!phase2Roared)
+            {
+                phase2Roared = true;
+                SetAnimTrigger(DrucladAnimCatalog.RoarTrigger, roarHash, hasRoar);
+                firePresentation?.TriggerPhaseEnrageFlare();
+                moveLockUntil = Time.time + 0.95f;
+            }
+        }
+    }
+
+    private void TickCombat(float dt)
+    {
+        if (Time.time >= nextRetargetTime)
+        {
+            nextRetargetTime = Time.time + 0.35f;
+            TryAcquireTarget();
+        }
+
+        bool hasTarget = IsLivingPlayerTarget(chaseTarget);
+        float dist = hasTarget ? PlanarDistance(transform.position, chaseTarget.position) : 999f;
+        if (hasTarget && dist > loseTargetRange)
+        {
+            chaseTarget = null;
+            hasTarget = false;
+        }
+
+        float softEnrage = 0f;
+        if (encounterStartedAt > 0f && softEnrageAfterSeconds > 1f)
+            softEnrage = Mathf.Clamp01((Time.time - encounterStartedAt) / softEnrageAfterSeconds);
+
+        DrucladBrain.TickInput input = new DrucladBrain.TickInput
+        {
+            selfPosition = transform.position,
+            selfForward = transform.forward,
+            now = Time.time,
+            deltaTime = dt,
+            targetPosition = hasTarget ? chaseTarget.position : (Vector3?)null,
+            targetDistance = dist,
+            hasTarget = hasTarget,
+            isDead = isDead,
+            isMoveLocked = Time.time < moveLockUntil,
+            canAttack = Time.time >= moveLockUntil && CurrentPhase >= EncounterPhase.Phase1,
+            playerOnVoid = IsPointOnVoid(transform.position),
+            awakening = CurrentPhase == EncounterPhase.Awaken,
+            phase = CombatPhaseByte,
+            playerInBreathCone = hasTarget && breathVolume != null
+                && breathVolume.IsPointInCone(chaseTarget.position + Vector3.up),
+            playerBehind = hasTarget && Vector3.Dot(Flatten(chaseTarget.position - transform.position), Flatten(transform.forward)) < -0.15f,
+            softEnrage01 = softEnrage,
+            isAttackReady = IsAttackReady,
+        };
+
+        DrucladBrain.TickOutput output = brain.Tick(in input);
+
+        Vector3 desiredFacing = Flatten(output.desiredFacing);
+        if (desiredFacing.sqrMagnitude > 0.0001f)
+        {
+            float turnRate = Time.time < moveLockUntil ? attackTurnSpeed : turnSpeed;
+            transform.rotation = Quaternion.Slerp(
+                transform.rotation,
+                Quaternion.LookRotation(desiredFacing.normalized, Vector3.up),
+                turnRate * dt);
+        }
+
+        if (output.triggerAttack && hasTarget && output.attackId != DrucladAnimCatalog.AttackId.None)
+        {
+            BeginAttack(output.attackId);
+            syncedLocomotionSpeed = 0f;
+            return;
+        }
+
+        if (Time.time < moveLockUntil || output.intent == DrucladBrain.Intent.Hold)
+        {
+            syncedLocomotionSpeed = 0f;
+            ApplyAnimatorLocomotion(0f);
+            return;
+        }
+
+        Vector3 desiredMove = Flatten(output.desiredMove);
+        float moveIntent = Mathf.Clamp01(output.desiredSpeed);
+        if (desiredMove.sqrMagnitude < 0.0001f || moveIntent <= 0.01f)
+        {
+            syncedLocomotionSpeed = 0f;
+            ApplyAnimatorLocomotion(0f);
+            return;
+        }
+
+        float speedMul = CurrentPhase switch
+        {
+            EncounterPhase.Phase2 => phase2SpeedMul,
+            EncounterPhase.Phase3 => phase3SpeedMul,
+            _ => 1f,
+        };
+        float baseSpeed = hasTarget && dist > meleeRange * 0.9f ? chaseSpeed : walkSpeed;
+        float speed = Mathf.Lerp(walkSpeed * 0.55f, baseSpeed, moveIntent) * speedMul;
+        syncedLocomotionSpeed = speed;
+        MovePlanar(desiredMove.normalized * speed, dt);
+        ApplyAnimatorLocomotion(speed);
+    }
+
+    private bool IsAttackReady(DrucladAnimCatalog.AttackId id)
+    {
+        if (!DrucladAnimCatalog.TryGet(id, out _))
+            return false;
+        if (!attackReadyAt.TryGetValue(id, out float ready))
+            return true;
+        float soft = encounterStartedAt > 0f
+            ? Mathf.Clamp01((Time.time - encounterStartedAt) / Mathf.Max(1f, softEnrageAfterSeconds))
+            : 0f;
+        // Soft enrage shrinks remaining wait on bolts.
+        if (id is DrucladAnimCatalog.AttackId.CinderBolt or DrucladAnimCatalog.AttackId.TwinBolts)
+            ready -= soft * 1.2f;
+        return Time.time >= ready;
+    }
+
+    private void BeginAttack(DrucladAnimCatalog.AttackId id)
+    {
+        if (!DrucladAnimCatalog.TryGet(id, out DrucladAnimCatalog.AttackDef def))
+            return;
+
+        activeAttackToken++;
+        if (attackRoutine != null)
+            StopCoroutine(attackRoutine);
+        brain?.NotifyAttackCommitted(id, Time.time);
+        float cd = def.Cooldown;
+        if (encounterStartedAt > 0f)
+        {
+            float soft = Mathf.Clamp01((Time.time - encounterStartedAt) / Mathf.Max(1f, softEnrageAfterSeconds));
+            if (id is DrucladAnimCatalog.AttackId.CinderBolt or DrucladAnimCatalog.AttackId.TwinBolts)
+                cd *= Mathf.Lerp(1f, 0.62f, soft);
+            if (id == DrucladAnimCatalog.AttackId.MeteorRain)
+                cd *= Mathf.Lerp(1f, 0.72f, soft);
+        }
+
+        attackReadyAt[id] = Time.time + cd;
+        firePresentation?.TriggerAttackFlare();
+        attackRoutine = StartCoroutine(ServerAttackRoutine(id, def, activeAttackToken));
+    }
+
+    private IEnumerator ServerAttackRoutine(
+        DrucladAnimCatalog.AttackId id,
+        DrucladAnimCatalog.AttackDef def,
+        int token)
+    {
+        moveLockUntil = Time.time + def.LockSeconds;
+        SetAnimTrigger(def.TriggerName, ResolveTriggerHash(def.TriggerName), true);
+
+        float hitDelay = def.HitDelaySeconds;
+        if (hitDelay > 0.02f)
+            yield return new WaitForSeconds(hitDelay);
+
+        if (token != activeAttackToken || isDead)
+            yield break;
+
+        ServerApplyAttackHit(id);
+
+        if (id == DrucladAnimCatalog.AttackId.InfernoBreath)
+        {
+            firePresentation?.TriggerAttackFlare();
+            breathVolume?.BeginChannel(1.85f, breathDamageMul);
+            yield return new WaitForSeconds(1.85f);
+            breathVolume?.StopChannel();
+        }
+        else if (id == DrucladAnimCatalog.AttackId.BreathSwipeString)
+        {
+            firePresentation?.TriggerAttackFlare();
+            breathVolume?.BeginChannel(0.85f, breathDamageMul * 0.85f);
+            yield return new WaitForSeconds(0.85f);
+            breathVolume?.StopChannel();
+            if (token == activeAttackToken && !isDead)
+            {
+                firePresentation?.TriggerAttackFlare();
+                ServerApplyAttackHit(DrucladAnimCatalog.AttackId.AshSwipeR);
+            }
+        }
+
+        attackRoutine = null;
+    }
+
+    private void ServerApplyAttackHit(DrucladAnimCatalog.AttackId id)
+    {
+        Vector3 origin = transform.position + Vector3.up * (characterController != null ? characterController.height * 0.42f : 2.4f);
+        Vector3 fwd = Flatten(transform.forward);
+        if (fwd.sqrMagnitude < 0.001f)
+            fwd = Vector3.forward;
+
+        switch (id)
+        {
+            case DrucladAnimCatalog.AttackId.AshSwipeL:
+            case DrucladAnimCatalog.AttackId.AshSwipeR:
+                ApplyMeleeCone(origin, fwd, meleeRange, swipeDamage, 8f, 2.5f, applyBurn: true);
+                RpcPlayTelegraph(0, origin + fwd * 1.2f);
+                break;
+
+            case DrucladAnimCatalog.AttackId.MagmaStomp:
+            {
+                Vector3 ground = GetGroundPoint();
+                ApplyShockwave(ground, stompRadius, stompDamage, 16f, 8f);
+                DrucladFireFx.PlayGroundSlam(ground, 1.55f);
+                RpcPlayTelegraph(1, ground);
+                break;
+            }
+
+            case DrucladAnimCatalog.AttackId.CinderBolt:
+                SpawnBolt(spreadYaw: 0f, twinBoltDamage: false);
+                break;
+
+            case DrucladAnimCatalog.AttackId.TwinBolts:
+                SpawnBolt(spreadYaw: -9f, twinBoltDamage: true);
+                SpawnBolt(spreadYaw: 9f, twinBoltDamage: true);
+                break;
+
+            case DrucladAnimCatalog.AttackId.EruptionStep:
+            {
+                if (chaseTarget != null)
+                {
+                    Vector3 to = Flatten(chaseTarget.position - transform.position);
+                    if (to.sqrMagnitude > 0.01f)
+                        MovePlanar(to.normalized * Mathf.Min(6.5f, to.magnitude * 0.55f), 0.2f);
+                }
+
+                Vector3 stomp = GetGroundPoint();
+                ApplyShockwave(stomp, stompRadius * 0.85f, stompDamage * 0.75f, 12f, 5f);
+                DrucladFireFx.PlayGroundSlam(stomp, 1.35f);
+                StartCoroutine(DelayedPuddle(stomp, 0.55f));
+                break;
+            }
+
+            case DrucladAnimCatalog.AttackId.MeteorRain:
+            {
+                Vector3 focus = chaseTarget != null ? chaseTarget.position : transform.position + transform.forward * 8f;
+                DrucladMeteorRainDirector.Play(
+                    this,
+                    focus,
+                    GetGroundPoint(),
+                    meteorCount: Random.Range(4, 7),
+                    ringRadius: 7.5f,
+                    safeRadiusNearBoss: 3.4f,
+                    damage: meteorDamage,
+                    firstDelay: 0.45f,
+                    stagger: 0.28f);
+                RpcPlayTelegraph(2, focus);
+                break;
+            }
+
+            case DrucladAnimCatalog.AttackId.WorldbreakerSlam:
+            {
+                Vector3 ground = GetGroundPoint();
+                ApplyShockwave(ground, worldbreakerRadius, worldbreakerDamage, 28f, 18f);
+                DrucladFireFx.PlayGroundSlam(ground, 2.2f);
+                RpcPlayTelegraph(1, ground);
+                break;
+            }
+        }
+    }
+
+    private IEnumerator DelayedPuddle(Vector3 point, float delay)
+    {
+        yield return new WaitForSeconds(delay);
+        if (isDead)
+            yield break;
+        DrucladMagmaPuddle.Spawn(point, radius: 2.4f, lifetime: 4.2f, damagePerTick: 11f);
+    }
+
+    private void SpawnBolt(float spreadYaw, bool twinBoltDamage)
+    {
+        Vector3 origin = ResolveCastOrigin();
+        Vector3 aim = chaseTarget != null
+            ? (chaseTarget.position + Vector3.up * 1.1f - origin)
+            : transform.forward;
+        if (aim.sqrMagnitude < 0.01f)
+            aim = transform.forward;
+        aim = Quaternion.Euler(0f, spreadYaw, 0f) * aim.normalized;
+
+        float dmg = twinBoltDamage ? this.twinBoltDamage : boltDamage;
+        uint netId = netIdentity != null ? netIdentity.netId : 0u;
+        DrucladFireBoltProjectile.Spawn(
+            origin,
+            aim,
+            chaseTarget,
+            speed: 22f,
+            damage: dmg,
+            lifeSeconds: 3.2f,
+            homing: 0.55f,
+            knockPlanar: 7f,
+            knockVertical: 2.5f,
+            ownerNetId: netId,
+            authoritative: true);
+
+        if (isServer)
+            RpcSpawnBoltVisual(origin, aim, twinBoltDamage);
+    }
+
+    [ClientRpc]
+    private void RpcSpawnBoltVisual(Vector3 origin, Vector3 direction, bool twin)
+    {
+        if (isServer)
+            return;
+        DrucladFireBoltProjectile.Spawn(
+            origin,
+            direction,
+            null,
+            speed: 22f,
+            damage: 0f,
+            lifeSeconds: 3.2f,
+            homing: 0f,
+            knockPlanar: 0f,
+            knockVertical: 0f,
+            ownerNetId: 0u,
+            authoritative: false);
+    }
+
+    [ClientRpc]
+    private void RpcPlayTelegraph(byte kind, Vector3 point)
+    {
+        switch (kind)
+        {
+            case 0:
+                DrucladFireFx.PlayCastBurst(point, transform.forward, 0.7f);
+                break;
+            case 1:
+                DrucladFireFx.PlayGroundSlam(point, 1.2f);
+                break;
+            case 2:
+                SpellFocusVefectsBridge.PlaySmolderingGroundRing(point, Vector3.up, 2.2f, 0.8f, 1f);
+                break;
+        }
+    }
+
+    private void ApplyMeleeCone(
+        Vector3 origin,
+        Vector3 forward,
+        float range,
+        float damage,
+        float knockPlanar,
+        float knockVertical,
+        bool applyBurn)
+    {
+        int count = Physics.OverlapSphereNonAlloc(
+            origin + forward * (range * 0.45f),
+            range * 0.55f,
+            meleeBuffer,
+            meleeHitMask,
+            QueryTriggerInteraction.Collide);
+
+        var hitPlayers = new HashSet<int>();
+        for (int i = 0; i < count; i++)
+        {
+            Collider col = meleeBuffer[i];
+            if (col == null || PlayerInteractionSphere.ShouldIgnoreEnemyCombatHit(col))
+                continue;
+
+            PlayerHealth player = col.GetComponentInParent<PlayerHealth>();
+            if (player == null || player.currentHealth <= 0.5f)
+                continue;
+
+            if (!hitPlayers.Add(player.GetInstanceID()))
+                continue;
+
+            Vector3 toPlayer = Flatten(col.transform.position - origin);
+            if (toPlayer.sqrMagnitude < 0.01f)
+                toPlayer = forward;
+            toPlayer.Normalize();
+            if (Vector3.Angle(forward, toPlayer) > attackAngleDegrees * 0.5f)
+                continue;
+
+            Vector3 knock = toPlayer * knockPlanar + Vector3.up * knockVertical;
+            player.TakeDamage(damage, origin, knock);
+            if (applyBurn)
+                SpellEffectCatalog.ApplyToPlayer(player, SpellEffectId.Burning, 2.8f);
+        }
+    }
+
+    private void ApplyShockwave(Vector3 center, float radius, float damage, float knockPlanar, float knockLift)
+    {
+        int count = Physics.OverlapSphereNonAlloc(center, radius, meleeBuffer, meleeHitMask, QueryTriggerInteraction.Collide);
+        var hitPlayers = new HashSet<int>();
+        for (int i = 0; i < count; i++)
+        {
+            Collider col = meleeBuffer[i];
+            if (col == null || PlayerInteractionSphere.ShouldIgnoreEnemyCombatHit(col))
+                continue;
+
+            PlayerHealth player = col.GetComponentInParent<PlayerHealth>();
+            if (player == null || player.currentHealth <= 0.5f)
+                continue;
+            if (!hitPlayers.Add(player.GetInstanceID()))
+                continue;
+
+            Vector3 away = Flatten(player.transform.position - center);
+            if (away.sqrMagnitude < 0.01f)
+                away = transform.forward;
+            away.Normalize();
+            player.TakeDamage(damage, center, away * knockPlanar + Vector3.up * knockLift);
+            SpellEffectCatalog.ApplyToPlayer(player, SpellEffectId.Burning, 2.4f);
+        }
+    }
+
+    private void TryAcquireTarget()
+    {
+        if (IsLivingPlayerTarget(chaseTarget))
+            return;
+
+        PlayerHealth[] players = FindObjectsByType<PlayerHealth>(FindObjectsSortMode.None);
+        Transform best = null;
+        float bestDist = acquireRange;
+        for (int i = 0; i < players.Length; i++)
+        {
+            PlayerHealth p = players[i];
+            if (p == null || p.currentHealth <= 0.5f)
+                continue;
+            if (!IsPointOnVoid(p.transform.position))
+                continue;
+            float d = PlanarDistance(transform.position, p.transform.position);
+            if (d < bestDist)
+            {
+                bestDist = d;
+                best = p.transform;
+            }
+        }
+
+        chaseTarget = best;
+    }
+
+    private bool IsPlayerOnVoid(out Transform nearest)
+    {
+        nearest = null;
+        float best = float.MaxValue;
+        PlayerHealth[] players = FindObjectsByType<PlayerHealth>(FindObjectsSortMode.None);
+        for (int i = 0; i < players.Length; i++)
+        {
+            PlayerHealth p = players[i];
+            if (p == null || p.currentHealth <= 0.5f)
+                continue;
+            if (!IsPointOnVoid(p.transform.position))
+                continue;
+            float d = PlanarDistance(transform.position, p.transform.position);
+            if (d < best)
+            {
+                best = d;
+                nearest = p.transform;
+            }
+        }
+
+        return nearest != null || IsPointOnVoid(transform.position);
+    }
+
+    private bool IsPointOnVoid(Vector3 world)
+    {
+        cachedWorld ??= FindFirstObjectByType<WorldGenerator>();
+        BiomeSettings settings = cachedWorld != null ? cachedWorld.BiomeSettings : null;
+        int seed = cachedWorld != null ? cachedWorld.TerrainSeed : 0;
+        float void01 = BiomeClimateSampler.SampleVoidDomain01(
+            Mathf.RoundToInt(world.x),
+            Mathf.RoundToInt(world.z),
+            seed,
+            settings);
+        return void01 >= voidOccupancyThreshold;
+    }
+
+    private void BeginFleeDespawn()
+    {
+        if (CurrentPhase == EncounterPhase.Fleeing || isDead)
+            return;
+
+        syncedPhase = (byte)EncounterPhase.Fleeing;
+        breathVolume?.StopChannel();
+        DrucladWorldFlags.MarkAliveFled();
+        if (isServer && netIdentity != null)
+        {
+            NetworkServer.Destroy(gameObject);
+        }
+        else
+        {
+            Destroy(gameObject);
+        }
+    }
+
+    private void BindHealth()
+    {
+        if (health == null)
+            return;
+        health.onDeath.RemoveListener(HandleDeath);
+        health.onDeath.AddListener(HandleDeath);
+        health.DamagedFromWorld -= OnDamagedFromWorld;
+        health.DamagedFromWorld += OnDamagedFromWorld;
+    }
+
+    private void UnbindHealth()
+    {
+        if (health == null)
+            return;
+        health.onDeath.RemoveListener(HandleDeath);
+        health.DamagedFromWorld -= OnDamagedFromWorld;
+    }
+
+    private void OnDamagedFromWorld(float amount, Vector3? source, bool concealAttackerIdentity)
+    {
+        if (isDead)
+            return;
+
+        // Short immune window during awaken roar.
+        if (Time.time < immuneUntil)
+        {
+            if (health != null && amount > 0f)
+                health.Heal(amount);
+            return;
+        }
+
+        PushHealthRatioToClients();
+        firePresentation?.TriggerHurtFlare();
+
+        // Phase 1 only: brief hit react. Later phases ignore stun.
+        if (CurrentPhase == EncounterPhase.Phase1 && amount > 8f && Time.time >= moveLockUntil)
+        {
+            SetAnimTrigger(DrucladAnimCatalog.HurtTrigger, hurtHash, hasHurt);
+            moveLockUntil = Time.time + 0.28f;
+        }
+    }
+
+    private void HandleDeath()
+    {
+        if (isDead)
+            return;
+        isDead = true;
+        syncedPhase = (byte)EncounterPhase.Dead;
+        syncedHealthRatio = 0f;
+        breathVolume?.StopChannel();
+        firePresentation?.BeginDeathSmolder();
+        if (HasAiAuthority)
+            ServerBeginDeath();
+    }
+
+    private void ServerBeginDeath()
+    {
+        DrucladWorldFlags.MarkDead();
+        SetAnimTrigger(DrucladAnimCatalog.DieTrigger, dieHash, hasDie);
+        if (hasDead)
+            animator.SetBool(deadHash, true);
+        if (deathRoutine != null)
+            StopCoroutine(deathRoutine);
+        deathRoutine = StartCoroutine(DeathRoutine());
+    }
+
+    private void PushHealthRatioToClients(bool force = false)
+    {
+        if (health == null || health.MaxHealth <= 0.01f)
+            return;
+
+        float ratio = Mathf.Clamp01(health.CurrentHealth / health.MaxHealth);
+        if (!force && Mathf.Abs(ratio - syncedHealthRatio) < 0.02f)
+            return;
+
+        syncedHealthRatio = ratio;
+        firePresentation?.SetHealthRatio(ratio);
+    }
+
+    private void OnHealthRatioChanged(float _, float newV)
+    {
+        firePresentation?.SetHealthRatio(newV);
+    }
+
+    private IEnumerator DeathRoutine()
+    {
+        if (deathLootTable != null)
+            deathLootTable.TrySpawnDrops(transform, lootBagPrefab);
+
+        yield return new WaitForSeconds(4.2f);
+        if (isServer && netIdentity != null)
+            NetworkServer.Destroy(gameObject);
+        else
+            Destroy(gameObject);
+    }
+
+    private void OnDeadChanged(bool _, bool nowDead)
+    {
+        if (!nowDead || animator == null)
+            return;
+        if (hasDead)
+            animator.SetBool(deadHash, true);
+        SetAnimTrigger(DrucladAnimCatalog.DieTrigger, dieHash, hasDie);
+    }
+
+    private void BootstrapAnimator()
+    {
+        networkAnimator ??= GetComponent<NetworkAnimator>();
+        animator ??= GetComponentInChildren<Animator>(true);
+        if (animator == null)
+            return;
+
+        if (animator.runtimeAnimatorController == null && defaultRuntimeAnimatorController != null)
+            animator.runtimeAnimatorController = defaultRuntimeAnimatorController;
+
+        animator.cullingMode = AnimatorCullingMode.AlwaysAnimate;
+        animator.updateMode = AnimatorUpdateMode.Normal;
+        animator.keepAnimatorStateOnDisable = true;
+        if (networkAnimator != null && networkAnimator.animator == null)
+            networkAnimator.animator = animator;
+
+        hasSpeed = ManafallAnimatorUtility.HasParameter(animator, speedParam, AnimatorControllerParameterType.Float);
+        hasDead = ManafallAnimatorUtility.HasParameter(animator, deadBool, AnimatorControllerParameterType.Bool);
+        hasHurt = ManafallAnimatorUtility.HasParameter(animator, DrucladAnimCatalog.HurtTrigger, AnimatorControllerParameterType.Trigger);
+        hasDie = ManafallAnimatorUtility.HasParameter(animator, DrucladAnimCatalog.DieTrigger, AnimatorControllerParameterType.Trigger);
+        hasRoar = ManafallAnimatorUtility.HasParameter(animator, DrucladAnimCatalog.RoarTrigger, AnimatorControllerParameterType.Trigger);
+        if (hasSpeed) speedHash = Animator.StringToHash(speedParam);
+        if (hasDead) deadHash = Animator.StringToHash(deadBool);
+        if (hasHurt) hurtHash = Animator.StringToHash(DrucladAnimCatalog.HurtTrigger);
+        if (hasDie) dieHash = Animator.StringToHash(DrucladAnimCatalog.DieTrigger);
+        if (hasRoar) roarHash = Animator.StringToHash(DrucladAnimCatalog.RoarTrigger);
+
+        for (int i = 0; i < DrucladAnimCatalog.Attacks.Length; i++)
+        {
+            string trigger = DrucladAnimCatalog.Attacks[i].TriggerName;
+            triggerHashes[i] = Animator.StringToHash(trigger);
+            triggerPresent[i] = ManafallAnimatorUtility.HasParameter(
+                animator, trigger, AnimatorControllerParameterType.Trigger);
+        }
+    }
+
+    private int ResolveTriggerHash(string triggerName)
+    {
+        for (int i = 0; i < DrucladAnimCatalog.Attacks.Length; i++)
+        {
+            if (DrucladAnimCatalog.Attacks[i].TriggerName == triggerName)
+                return triggerHashes[i];
+        }
+
+        return Animator.StringToHash(triggerName);
+    }
+
+    private void SetAnimTrigger(string triggerName, int hash, bool present)
+    {
+        if (animator == null || string.IsNullOrEmpty(triggerName))
+            return;
+
+        bool ok = present;
+        if (!ok)
+            ok = ManafallAnimatorUtility.HasParameter(animator, triggerName, AnimatorControllerParameterType.Trigger);
+        if (!ok)
+            return;
+
+        if (networkAnimator != null && NetworkServer.active)
+            networkAnimator.SetTrigger(triggerName);
+        else
+            animator.SetTrigger(hash != 0 ? hash : Animator.StringToHash(triggerName));
+    }
+
+    private void ApplyAnimatorLocomotion(float speed)
+    {
+        if (!hasSpeed || animator == null)
+            return;
+        animator.SetFloat(speedHash, speed);
+    }
+
+    private void EnsureCharacterController()
+    {
+        if (characterController == null)
+            return;
+        characterController.height = Mathf.Max(characterController.height, 3.6f);
+        characterController.radius = Mathf.Max(characterController.radius, 0.95f);
+        characterController.center = new Vector3(0f, characterController.height * 0.5f, 0f);
+        characterController.slopeLimit = 50f;
+        characterController.stepOffset = 0.6f;
+    }
+
+    private void ApplyGravity(float dt)
+    {
+        if (characterController == null || !characterController.enabled)
+            return;
+
+        if (characterController.isGrounded && verticalVelocity < 0f)
+            verticalVelocity = -2f;
+        else
+            verticalVelocity += gravity * dt;
+
+        characterController.Move(Vector3.up * (verticalVelocity * dt));
+    }
+
+    private void MovePlanar(Vector3 planar, float dt)
+    {
+        if (characterController == null || !characterController.enabled)
+        {
+            transform.position += planar * dt;
+            return;
+        }
+
+        Vector3 motion = planar;
+        if (characterController.isGrounded && verticalVelocity < 0f)
+            verticalVelocity = -2f;
+        else
+            verticalVelocity += gravity * dt;
+        motion.y = verticalVelocity;
+        characterController.Move(motion * dt);
+    }
+
+    private Transform ResolveBreathMuzzleTransform()
+    {
+        if (breathMuzzle != null)
+            return breathMuzzle;
+        if (animator != null)
+        {
+            Transform head = animator.GetBoneTransform(HumanBodyBones.Head);
+            if (head != null)
+                return head;
+        }
+
+        return transform;
+    }
+
+    private Vector3 ResolveCastOrigin()
+    {
+        if (castHand != null)
+            return castHand.position;
+        if (animator != null)
+        {
+            Transform hand = animator.GetBoneTransform(HumanBodyBones.RightHand)
+                ?? animator.GetBoneTransform(HumanBodyBones.LeftHand);
+            if (hand != null)
+                return hand.position;
+        }
+
+        return transform.position + Vector3.up * 2.2f + transform.forward * 0.9f;
+    }
+
+    private Vector3 GetGroundPoint()
+    {
+        Vector3 p = transform.position;
+        if (Physics.Raycast(p + Vector3.up * 1.5f, Vector3.down, out RaycastHit hit, 6f))
+            return hit.point;
+        return p;
+    }
+
+    private static bool IsLivingPlayerTarget(Transform t)
+    {
+        if (t == null)
+            return false;
+        PlayerHealth hp = t.GetComponent<PlayerHealth>() ?? t.GetComponentInParent<PlayerHealth>();
+        return hp != null && hp.currentHealth > 0.5f;
+    }
+
+    private static float PlanarDistance(Vector3 a, Vector3 b)
+    {
+        float dx = a.x - b.x;
+        float dz = a.z - b.z;
+        return Mathf.Sqrt(dx * dx + dz * dz);
+    }
+
+    private static Vector3 Flatten(Vector3 v) => new Vector3(v.x, 0f, v.z);
+
+#if UNITY_EDITOR
+    private void OnValidate()
+    {
+        characterController ??= GetComponent<CharacterController>();
+        health ??= GetComponent<Health>();
+        animator ??= GetComponentInChildren<Animator>(true);
+    }
+#endif
+}
