+                    break;
+                }
+            }
+
+            if (!clearOfIslands)
+                continue;
+
+            slot = new FoliageSlot
+            {
+                Type = FoliageSlotType.FloatingIsland,
+                WorldPosition = pos,
+                Rotation = Quaternion.Euler(0f, RandomRange(rng, 0f, 360f), 0f),
+                Scale = scale,
+                Biome = BiomeType.Void,
+                PrefabVariant = 0,
+            };
+            return true;
+        }
+
+        return false;
+    }
