@@ -0,0 +1,33 @@
+# Druclad → Mixamo / Unity
+
+## What you have now
+
+| File | Role |
+|------|------|
+| `Meshy_AI_Horned_Abyssal_Demon_…_texture.fbx` | Original Meshy mesh (no bones) |
+| **`Druclad_MixamoRigged.fbx`** | Blender-built Mixamo-named armature + automatic skin weights |
+| `rig_druclad_mixamo.py` | Script used to generate the rigged FBX |
+
+## Use in Mixamo
+
+1. Upload **`Druclad_MixamoRigged.fbx`** to [Mixamo](https://www.mixamo.com/).
+2. Because Mixamo bone names are already present, you should skip marker placement and go straight to animations.
+3. Download clips as **FBX for Unity** (with skin).
+
+If Mixamo still complains about proportions (horns / non-human shape), use Meshy Auto Rig → Skeleton Template **Mixamo** instead — that AI placement is usually better than a bbox biped.
+
+## Use in Unity
+
+1. Import `Druclad_MixamoRigged.fbx` (keep the PNG textures in the same folder / assign materials).
+2. Rig tab → Animation Type **Humanoid** → Apply.
+3. Open Configure Avatar and verify Hips / spine / limbs look sane; fix any red bones.
+4. Drop Mixamo animation FBXs in and set Avatar Definition → **Copy From Other Avatar** → Druclad’s Avatar.
+
+## Re-run the Blender rig
+
+```text
+blender --background --python Assets/ThirdParty/DownloadedAssets/Druclad/rig_druclad_mixamo.py -- ^
+  <input.fbx> <output.fbx>
+```
+
+This is a **heuristic biped** (hips/spine/limbs/hands from mesh bounds + automatic weights). It is good enough for Mixamo mapping and first-pass Unity Humanoid; tweak bone placement in Blender if elbows/knees look wrong.
diff --git a/Assets/ThirdParty/DownloadedAssets/Druclad/rig_druclad_mixamo.py b/Assets/ThirdParty/DownloadedAssets/Druclad/rig_druclad_mixamo.py
new file mode 100644
index 000000000..2dc6104ac
--- /dev/null
+++ b/Assets/ThirdParty/DownloadedAssets/Druclad/rig_druclad_mixamo.py
@@ -0,0 +1,228 @@
+"""
+Headless Blender: build a Mixamo-named biped armature on the Druclad mesh
+and bind with automatic weights, then export FBX for Mixamo / Unity Humanoid.
+
+Usage:
+  blender --background --python rig_druclad_mixamo.py -- <input.fbx> <output.fbx>
+"""
+from __future__ import annotations
+
+import math
+import sys
+from pathlib import Path
+
+import bpy
+from mathutils import Vector
+
+
+def argv_after_double_dash():
+    if "--" in sys.argv:
+        return sys.argv[sys.argv.index("--") + 1 :]
+    return []
+
+
+def clear_scene():
+    bpy.ops.object.select_all(action="SELECT")
+    bpy.ops.object.delete(use_global=False)
+    for block in (bpy.data.meshes, bpy.data.armatures, bpy.data.materials, bpy.data.images):
+        for b in list(block):
+            block.remove(b)
+
+
+def import_mesh(path: Path):
+    ext = path.suffix.lower()
+    if ext == ".fbx":
+        bpy.ops.import_scene.fbx(filepath=str(path), automatic_bone_orientation=False)
+    elif ext == ".obj":
+        bpy.ops.wm.obj_import(filepath=str(path))
+    else:
+        raise RuntimeError(f"Unsupported import: {path}")
+
+    meshes = [o for o in bpy.context.scene.objects if o.type == "MESH"]
+    if not meshes:
+        raise RuntimeError("No mesh found after import")
+
+    # Merge multi-part Meshy exports into one skinned body.
+    bpy.ops.object.select_all(action="DESELECT")
+    for o in meshes:
+        o.select_set(True)
+    bpy.context.view_layer.objects.active = meshes[0]
+    if len(meshes) > 1:
+        bpy.ops.object.join()
+
+    body = bpy.context.view_layer.objects.active
+    bpy.ops.object.transform_apply(location=True, rotation=True, scale=True)
+    return body
+
+
+def mesh_bounds(obj):
+    corners = [obj.matrix_world @ Vector(c) for c in obj.bound_box]
+    xs = [c.x for c in corners]
+    ys = [c.y for c in corners]
+    zs = [c.z for c in corners]
+    mn = Vector((min(xs), min(ys), min(zs)))
+    mx = Vector((max(xs), max(ys), max(zs)))
+    return mn, mx, mx - mn
+
+
+def add_bone(arm, name, head, tail, parent=None, connect=False):
+    bone = arm.edit_bones.new(name)
+    bone.head = Vector(head)
+    bone.tail = Vector(tail)
+    if parent is not None:
+        bone.parent = parent
+        bone.use_connect = connect
+    return bone
+
+
+def build_mixamo_armature(body):
+    mn, mx, size = mesh_bounds(body)
+    # Assume Y-up FBX from Meshy: height along Z or Y. Pick the tallest axis as up.
+    if size.z >= size.y and size.z >= size.x:
+        up = "Z"
+        height = size.z
+        foot_y = mn.y + size.y * 0.5
+        center_x = (mn.x + mx.x) * 0.5
+        ground = mn.z
+        top = mx.z
+        depth_back = mn.y + size.y * 0.42
+        depth_front = mn.y + size.y * 0.58
+
+        def P(x, h01, d01=0.5):
+            # h01: 0 ground .. 1 top; d01: 0 back .. 1 front along Y
+            return (
+                center_x + (x - 0.5) * size.x,
+                mn.y + size.y * d01,
+                ground + height * h01,
+            )
+    else:
+        # Y-up style
+        height = size.y
+        center_x = (mn.x + mx.x) * 0.5
+        ground = mn.y
+        top = mx.y
+
+        def P(x, h01, d01=0.5):
+            return (
+                center_x + (x - 0.5) * size.x,
+                ground + height * h01,
+                mn.z + size.z * d01,
+            )
+
+    bpy.ops.object.armature_add(enter_editmode=True, location=(0, 0, 0))
+    arm_obj = bpy.context.object
+    arm_obj.name = "Armature"
+    arm = arm_obj.data
+    arm.name = "Armature"
+    # Remove default bone
+    for b in list(arm.edit_bones):
+        arm.edit_bones.remove(b)
+
+    # Mixamo bone names (no mixamorig: prefix — Mixamo accepts both; Unity Humanoid likes these).
+    hips = add_bone(arm, "mixamorig:Hips", P(0.5, 0.48), P(0.5, 0.54))
+    spine = add_bone(arm, "mixamorig:Spine", P(0.5, 0.54), P(0.5, 0.62), hips, True)
+    spine1 = add_bone(arm, "mixamorig:Spine1", P(0.5, 0.62), P(0.5, 0.70), spine, True)
+    spine2 = add_bone(arm, "mixamorig:Spine2", P(0.5, 0.70), P(0.5, 0.78), spine1, True)
+    neck = add_bone(arm, "mixamorig:Neck", P(0.5, 0.78), P(0.5, 0.88), spine2, True)
+    head = add_bone(arm, "mixamorig:Head", P(0.5, 0.88), P(0.5, 0.98), neck, True)
+
+    # Legs
+    lup = add_bone(arm, "mixamorig:LeftUpLeg", P(0.62, 0.48), P(0.64, 0.27), hips, False)
+    llow = add_bone(arm, "mixamorig:LeftLeg", P(0.64, 0.27), P(0.64, 0.08), lup, True)
+    lfoot = add_bone(arm, "mixamorig:LeftFoot", P(0.64, 0.08), P(0.64, 0.02, 0.72), llow, True)
+    add_bone(arm, "mixamorig:LeftToeBase", P(0.64, 0.02, 0.72), P(0.64, 0.01, 0.88), lfoot, True)
+
+    rup = add_bone(arm, "mixamorig:RightUpLeg", P(0.38, 0.48), P(0.36, 0.27), hips, False)
+    rlow = add_bone(arm, "mixamorig:RightLeg", P(0.36, 0.27), P(0.36, 0.08), rup, True)
+    rfoot = add_bone(arm, "mixamorig:RightFoot", P(0.36, 0.08), P(0.36, 0.02, 0.72), rlow, True)
+    add_bone(arm, "mixamorig:RightToeBase", P(0.36, 0.02, 0.72), P(0.36, 0.01, 0.88), rfoot, True)
+
+    # Arms — shoulders out from chest
+    lsh = add_bone(arm, "mixamorig:LeftShoulder", P(0.55, 0.76), P(0.68, 0.76), spine2, False)
+    larm = add_bone(arm, "mixamorig:LeftArm", P(0.68, 0.76), P(0.82, 0.62), lsh, True)
+    lfore = add_bone(arm, "mixamorig:LeftForeArm", P(0.82, 0.62), P(0.90, 0.48), larm, True)
+    lhand = add_bone(arm, "mixamorig:LeftHand", P(0.90, 0.48), P(0.94, 0.44), lfore, True)
+
+    rsh = add_bone(arm, "mixamorig:RightShoulder", P(0.45, 0.76), P(0.32, 0.76), spine2, False)
+    rarm = add_bone(arm, "mixamorig:RightArm", P(0.32, 0.76), P(0.18, 0.62), rsh, True)
+    rfore = add_bone(arm, "mixamorig:RightForeArm", P(0.18, 0.62), P(0.10, 0.48), rarm, True)
+    rhand = add_bone(arm, "mixamorig:RightHand", P(0.10, 0.48), P(0.06, 0.44), rfore, True)
+
+    # Minimal fingers so Mixamo / Humanoid see hands
+    for side, hand, sign in (("Left", lhand, 1.0), ("Right", rhand, -1.0)):
+        hx, hy, hz = hand.tail
+        for i, finger in enumerate(("Thumb", "Index", "Middle", "Ring", "Pinky")):
+            off = (i - 2) * 0.012 * size.x
+            tip_x = hx + sign * 0.03 * size.x
+            tip_y = hy + off
+            tip_z = hz - 0.01 * height
+            mid = add_bone(
+                arm,
+                f"mixamorig:{side}Hand{finger}1",
+                hand.tail,
+                (hx + sign * 0.015 * size.x, hy + off * 0.5, hz - 0.005 * height),
+                hand,
+                False,
+            )
+            add_bone(
+                arm,
+                f"mixamorig:{side}Hand{finger}2",
+                mid.tail,
+                (tip_x, tip_y, tip_z),
+                mid,
+                True,
+            )
+
+    bpy.ops.object.mode_set(mode="OBJECT")
+    return arm_obj
+
+
+def bind_automatic_weights(body, arm_obj):
+    bpy.ops.object.select_all(action="DESELECT")
+    body.select_set(True)
+    arm_obj.select_set(True)
+    bpy.context.view_layer.objects.active = arm_obj
+    bpy.ops.object.parent_set(type="ARMATURE_AUTO")
+
+
+def export_fbx(path: Path):
+    bpy.ops.object.select_all(action="SELECT")
+    bpy.ops.export_scene.fbx(
+        filepath=str(path),
+        use_selection=False,
+        object_types={"ARMATURE", "MESH"},
+        add_leaf_bones=False,
+        bake_anim=False,
+        armature_nodetype="NULL",
+        primary_bone_axis="Y",
+        secondary_bone_axis="X",
+        axis_forward="-Z",
+        axis_up="Y",
+        apply_scale_options="FBX_SCALE_ALL",
+        path_mode="COPY",
+        embed_textures=True,
+    )
+
+
+def main():
+    args = argv_after_double_dash()
+    if len(args) < 2:
+        raise SystemExit("Need: -- <input.fbx> <output.fbx>")
+
+    src = Path(args[0])
+    dst = Path(args[1])
+    if not src.is_file():
+        raise SystemExit(f"Missing input: {src}")
+
+    clear_scene()
+    body = import_mesh(src)
+    print(f"[DrucladRig] mesh={body.name} verts={len(body.data.vertices)}")
+    arm = build_mixamo_armature(body)
+    bind_automatic_weights(body, arm)
+    dst.parent.mkdir(parents=True, exist_ok=True)
+    export_fbx(dst)
+    print(f"[DrucladRig] wrote {dst}")
+
+
+if __name__ == "__main__":
+    main()
