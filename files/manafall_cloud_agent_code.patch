+    private static Transform EnsureBodyFireChild(Transform root)
+    {
+        Transform existing = root.Find(DrucladFirePresentation.EmbeddedChildName)
+            ?? root.Find("HellhoundBodyFire");
+        if (existing != null)
+        {
+            if (existing.GetComponent<DrucladBodyFireVfx>() == null
+                && existing.GetComponent<HellhoundBodyFireVfx>() == null)
+            {
+                existing.gameObject.AddComponent<DrucladBodyFireVfx>();
+            }
+
+            return existing;
+        }
+
+        GameObject prefab = AssetDatabase.LoadAssetAtPath<GameObject>(BodyFirePrefabPath);
+        if (prefab != null)
+        {
+            GameObject embedded = (GameObject)PrefabUtility.InstantiatePrefab(prefab, root);
+            embedded.name = DrucladFirePresentation.EmbeddedChildName;
+            embedded.transform.localPosition = new Vector3(0f, 1.15f, 0.1f);
+            embedded.transform.localRotation = Quaternion.identity;
+            embedded.transform.localScale = Vector3.one * 1.85f;
+            if (embedded.GetComponent<DrucladBodyFireVfx>() == null)
+                embedded.AddComponent<DrucladBodyFireVfx>();
+            return embedded.transform;
+        }
+
+        var fallback = new GameObject(DrucladFirePresentation.EmbeddedChildName);
+        fallback.transform.SetParent(root, false);
+        fallback.transform.localPosition = new Vector3(0f, 1.15f, 0.1f);
+        fallback.transform.localScale = Vector3.one * 1.85f;
+        var lightGo = new GameObject("BodyGlow");
+        lightGo.transform.SetParent(fallback.transform, false);
+        Light glow = lightGo.AddComponent<Light>();
+        glow.type = LightType.Point;
+        glow.shadows = LightShadows.None;
+        glow.range = 8f;
+        glow.intensity = 3.2f;
+        glow.color = new Color(1.4f, 0.68f, 0.16f, 1f);
+        fallback.AddComponent<DrucladBodyFireVfx>();
+        return fallback.transform;
+    }
+
+    private static CapsuleCollider EnsureHurtboxChild(Transform root)
+    {
+        Transform hurtboxTransform = root.Find("Hurtbox");
+        if (hurtboxTransform == null)
+        {
+            var hurtboxGo = new GameObject("Hurtbox");
+            hurtboxTransform = hurtboxGo.transform;
+            hurtboxTransform.SetParent(root, false);
+        }
+
+        CapsuleCollider hurtbox = hurtboxTransform.GetComponent<CapsuleCollider>();
+        if (hurtbox == null)
+            hurtbox = hurtboxTransform.gameObject.AddComponent<CapsuleCollider>();
+
+        // Boss-scale capsule (taller/heavier than Troll). CreatureMeleeHurtbox.Awake
+        // forces non-trigger so player melee/spells can resolve Health.
+        hurtbox.isTrigger = false;
+        hurtbox.direction = 1;
+        hurtbox.height = 5.6f;
+        hurtbox.radius = 1.35f;
+        hurtbox.center = new Vector3(0f, 2.8f, 0.2f);
+
+        if (hurtboxTransform.GetComponent<CreatureMeleeHurtbox>() == null)
+            hurtboxTransform.gameObject.AddComponent<CreatureMeleeHurtbox>();
+
+        return hurtbox;
+    }
