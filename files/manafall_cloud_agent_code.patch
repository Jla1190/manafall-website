+    private static void ResolveVoidLayout(BiomeSettings settings, out Vector2 centerXZ, out float radiusMeters, out float strength)
+    {
+        if (settings == null)
+            settings = DefaultSettings;
+
+        EnsureVoidSettingsDefaults(settings);
+        strength = Mathf.Clamp01(settings.voidDomainStrength);
+        radiusMeters = Mathf.Clamp(settings.voidDomainRadiusMeters, 40f, 280f);
+        float gap = ResolveVoidGap(settings);
+        float bearingDeg = settings.voidIslandBearingDegrees;
+        if (bearingDeg <= 0.001f)
+            bearingDeg = 270f;
+        float bearing = bearingDeg * Mathf.Deg2Rad;
+        float centerDist = Mathf.Max(1f, s_islandRadius) + gap + radiusMeters;
+        centerXZ = s_islandCenter + new Vector2(Mathf.Cos(bearing), Mathf.Sin(bearing)) * centerDist;
+    }
+
+    private static float ResolveVoidGap(BiomeSettings settings)
+    {
+        if (settings == null || settings.voidIslandGapMeters <= 0.001f)
+            return 140f;
+        return Mathf.Clamp(settings.voidIslandGapMeters, 80f, 400f);
+    }
