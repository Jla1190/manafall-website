diff --git a/Assets/Scripts/Inventory/TierLootRoll.cs b/Assets/Scripts/Inventory/TierLootRoll.cs
new file mode 100644
index 000000000..bbdc534c4
--- /dev/null
+++ b/Assets/Scripts/Inventory/TierLootRoll.cs
@@ -0,0 +1,128 @@
+using System.Collections.Generic;
+using UnityEngine;
+
+namespace InventoryFramework
+{
+    /// <summary>Shared weighted picks where every candidate's chance comes from item tier.</summary>
+    public static class TierLootRoll
+    {
+        public struct Candidate
+        {
+            public Item item;
+            public float weight;
+            public int minAmount;
+            public int maxAmount;
+        }
+
+        public static float Weight(Item item, float creatureQuality01 = 0f, float relativeMul = 1f) =>
+            ItemLootRarity.ResolveLootWeight(item, creatureQuality01, relativeMul);
+
+        public static bool TryAdd(
+            List<Candidate> dest,
+            HashSet<int> pickedIds,
+            Item item,
+            int minAmount,
+            int maxAmount,
+            float creatureQuality01 = 0f,
+            float relativeMul = 1f)
+        {
+            if (dest == null || item == null || item.id <= 0)
+                return false;
+            if (pickedIds != null && pickedIds.Contains(item.id))
+                return false;
+
+            float weight = Weight(item, creatureQuality01, relativeMul);
+            if (weight <= 0.001f)
+                return false;
+
+            int lo = Mathf.Max(1, Mathf.Min(minAmount, maxAmount));
+            int hi = Mathf.Max(lo, Mathf.Max(minAmount, maxAmount));
+            dest.Add(new Candidate
+            {
+                item = item,
+                weight = weight,
+                minAmount = lo,
+                maxAmount = hi,
+            });
+            return true;
+        }
+
+        public static int PickIndex(List<Candidate> candidates)
+        {
+            if (candidates == null || candidates.Count == 0)
+                return -1;
+
+            float total = 0f;
+            for (int i = 0; i < candidates.Count; i++)
+                total += candidates[i].weight;
+
+            if (total <= 0f)
+                return -1;
+
+            float roll = Random.Range(0f, total);
+            float cumulative = 0f;
+            for (int i = 0; i < candidates.Count; i++)
+            {
+                cumulative += candidates[i].weight;
+                if (roll <= cumulative)
+                    return i;
+            }
+
+            return candidates.Count - 1;
+        }
+
+        public static int PickIndex(List<(Item item, float weight)> candidates)
+        {
+            if (candidates == null || candidates.Count == 0)
+                return -1;
+
+            float total = 0f;
+            for (int i = 0; i < candidates.Count; i++)
+                total += candidates[i].weight;
+
+            if (total <= 0f)
+                return -1;
+
+            float roll = Random.Range(0f, total);
+            float cumulative = 0f;
+            for (int i = 0; i < candidates.Count; i++)
+            {
+                cumulative += candidates[i].weight;
+                if (roll <= cumulative)
+                    return i;
+            }
+
+            return candidates.Count - 1;
+        }
+
+        /// <summary>Weighted pick where each entry's chance is its item's MarketItemRarity tier rate.</summary>
+        public static int PickIndexByItemTier<T>(IReadOnlyList<T> candidates, System.Func<T, Item> itemOf)
+        {
+            if (candidates == null || candidates.Count == 0 || itemOf == null)
+                return -1;
+
+            float total = 0f;
+            for (int i = 0; i < candidates.Count; i++)
+                total += Weight(itemOf(candidates[i]));
+
+            if (total <= 0.001f)
+                return -1;
+
+            float roll = Random.Range(0f, total);
+            float cumulative = 0f;
+            int last = -1;
+            for (int i = 0; i < candidates.Count; i++)
+            {
+                float w = Weight(itemOf(candidates[i]));
+                if (w <= 0.001f)
+                    continue;
+                last = i;
+                cumulative += w;
+                if (roll <= cumulative)
+                    return i;
+            }
+
+            return last;
+        }
+    }
+}
