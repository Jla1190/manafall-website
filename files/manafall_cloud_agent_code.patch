+
+    /// <summary>
+    /// Death disables body colliders. Base NetworkChest range then always fails and the loot
+    /// UI either never stays open or distance-closes every frame — use the body point instead.
+    /// </summary>
+    public override bool IsPlayerInInteractRange(Vector3 playerPosition)
+    {
+        if (!IsCorpseLootable())
+            return false;
+
+        return IsBodyInLootRange(playerPosition, InteractRange);
+    }
+
+    public override bool IsPlayerInRange(Vector3 playerPosition, float range)
+    {
+        if (!IsCorpseLootable())
+            return false;
+
+        return IsBodyInLootRange(playerPosition, range);
+    }
+
+    public override bool ServerIsPlayerInRange(Vector3 playerPosition) =>
+        IsCorpseLootable() && IsPlayerInInteractRange(playerPosition);
+
+    private bool IsBodyInLootRange(Vector3 playerPosition, float range)
+    {
+        range = Mathf.Clamp(Mathf.Max(0.5f, range), 0.5f, 8f);
+        Vector3 body = ResolveBodyLootWorldPosition();
+        Vector3 delta = playerPosition - body;
+        float planar = new Vector2(delta.x, delta.z).magnitude;
+        if (planar > range)
+            return false;
+
+        return Mathf.Abs(delta.y) <= range + 1.5f;
+    }
 }
