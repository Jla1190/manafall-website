+    private static DrucladLootTable EnsureLootTable(
+        StringBuilder log,
+        Item emberAsh,
+        Item cinderScale,
+        Item hornShard,
+        Item fireHeart)
+    {
+        DrucladLootTable table = AssetDatabase.LoadAssetAtPath<DrucladLootTable>(LootTablePath);
+        if (table == null)
+        {
+            table = ScriptableObject.CreateInstance<DrucladLootTable>();
+            AssetDatabase.CreateAsset(table, LootTablePath);
+            log.AppendLine($"  Created {LootTablePath}");
+        }
+
+        // weightMul 0 → MarketItemRarity tier alone sets the roll rate.
+        table.minBossRolls = 2;
+        table.maxBossRolls = 4;
+        table.includeGenericTier = true;
+        table.itemDatabase = AssetDatabase.LoadAssetAtPath<ItemDatabase>(ItemDatabasePath);
+        table.minGenericRolls = 1;
+        table.maxGenericRolls = 2;
+        table.maxGenericTier = MarketItemRarity.Tier.Rare;
+        table.genericMinAmount = 1;
+        table.genericMaxAmount = 2;
+        table.dropSpacing = 0.65f;
+        table.bossPool = new[]
+        {
+            new DrucladLootTable.Entry { item = emberAsh, weightMul = 0f, minAmount = 2, maxAmount = 5 },
+            new DrucladLootTable.Entry { item = cinderScale, weightMul = 0f, minAmount = 1, maxAmount = 3 },
+            new DrucladLootTable.Entry { item = hornShard, weightMul = 0f, minAmount = 1, maxAmount = 1 },
+            new DrucladLootTable.Entry { item = fireHeart, weightMul = 0f, minAmount = 1, maxAmount = 1 },
+        };
+        EditorUtility.SetDirty(table);
+        log.AppendLine("  Wired Druclad loot pool (tier-weighted Common→Epic).");
+        return table;
+    }
