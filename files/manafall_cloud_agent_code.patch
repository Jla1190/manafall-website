+using System.Collections;
+using InventoryFramework;
+using UnityEngine;
+
+/// <summary>
+/// Spawns 4–6 delayed fire meteors in a ring around the player with a brief safe doughnut near Druclad.
+/// </summary>
+public sealed class DrucladMeteorRainDirector : MonoBehaviour
+{
+    private readonly Collider[] hitBuffer = new Collider[16];
+
+    public static void Play(
+        DrucladController owner,
+        Vector3 playerFocus,
+        Vector3 bossFeet,
+        int meteorCount,
+        float ringRadius,
+        float safeRadiusNearBoss,
+        float damage,
+        float firstDelay,
+        float stagger)
+    {
+        if (owner == null)
+            return;
+
+        var host = owner.gameObject.AddComponent<DrucladMeteorRainDirector>();
+        host.StartCoroutine(host.Run(
+            owner,
+            playerFocus,
+            bossFeet,
+            Mathf.Clamp(meteorCount, 3, 8),
+            Mathf.Max(3f, ringRadius),
+            Mathf.Max(1.2f, safeRadiusNearBoss),
+            Mathf.Max(8f, damage),
+            Mathf.Max(0.15f, firstDelay),
+            Mathf.Max(0.08f, stagger)));
+    }
+
+    private IEnumerator Run(
+        DrucladController owner,
+        Vector3 playerFocus,
+        Vector3 bossFeet,
+        int count,
+        float ringRadius,
+        float safeRadius,
+        float damage,
+        float firstDelay,
+        float stagger)
+    {
+        float yaw0 = Random.Range(0f, 360f);
+        for (int i = 0; i < count; i++)
+        {
+            float yaw = yaw0 + (360f / count) * i + Random.Range(-12f, 12f);
+            Vector3 offset = Quaternion.Euler(0f, yaw, 0f) * Vector3.forward * ringRadius;
+            Vector3 impact = playerFocus + offset;
+            impact.y = playerFocus.y;
+
+            // Keep a short safe doughnut around the boss so melee is not pure death.
+            Vector3 flatFromBoss = impact - bossFeet;
+            flatFromBoss.y = 0f;
+            if (flatFromBoss.sqrMagnitude < safeRadius * safeRadius)
+                impact = bossFeet + flatFromBoss.normalized * (safeRadius + 0.75f);
+
+            if (Physics.Raycast(impact + Vector3.up * 8f, Vector3.down, out RaycastHit ground, 24f))
+                impact = ground.point;
+
+            float delay = firstDelay + stagger * i;
+            StartCoroutine(DropOne(owner, impact, damage, delay));
+        }
+
+        yield return new WaitForSeconds(firstDelay + stagger * count + 1.2f);
+        Destroy(this);
+    }
+
+    private IEnumerator DropOne(DrucladController owner, Vector3 impact, float damage, float delay)
+    {
+        yield return new WaitForSeconds(delay);
+
+        Vector3 entry = impact + Vector3.up * 28f + Random.insideUnitSphere * 2.5f;
+        entry.y = impact.y + 26f;
+
+        // Telegraph ring
+        SpellFocusVefectsBridge.PlaySmolderingGroundRing(
+            impact,
+            Vector3.up,
+            radius: 1.8f,
+            duration: 0.55f,
+            patchScale: 0.85f);
+
+        float travel = 0.55f;
+        float t = 0f;
+        var head = new GameObject("DrucladMeteorHead");
+        head.transform.position = entry;
+        DrucladFireFx.AttachBoltVisual(head.transform, 1.35f);
+
+        while (t < travel)
+        {
+            t += Time.deltaTime;
+            float u = Mathf.Clamp01(t / travel);
+            float eased = Mathf.Pow(u, 1.25f);
+            head.transform.position = Vector3.LerpUnclamped(entry, impact, eased);
+            yield return null;
+        }
+
+        Destroy(head);
+        DrucladFireFx.PlayMeteorImpact(impact, 1.4f);
+
+        if (owner == null || owner.IsDead)
+            yield break;
+
+        int n = Physics.OverlapSphereNonAlloc(impact, 2.6f, hitBuffer, ~0, QueryTriggerInteraction.Collide);
+        for (int i = 0; i < n; i++)
+        {
+            Collider col = hitBuffer[i];
+            if (col == null || PlayerInteractionSphere.ShouldIgnoreEnemyCombatHit(col))
+                continue;
+
+            PlayerHealth player = col.GetComponentInParent<PlayerHealth>();
+            if (player != null && player.currentHealth > 0.5f)
+            {
+                Vector3 away = player.transform.position - impact;
+                away.y = 0f;
+                if (away.sqrMagnitude < 0.01f)
+                    away = Vector3.forward;
+                away.Normalize();
+                player.TakeDamage(damage, impact, away * 14f + Vector3.up * 6f);
+                SpellEffectCatalog.ApplyToPlayer(player, SpellEffectId.Burning, 3.2f);
+                continue;
+            }
+
+            Health creature = CreatureMeleeHurtbox.ResolveHealth(col);
+            if (creature != null && !creature.IsDead && creature.gameObject != owner.gameObject)
+                creature.TakeDamage(damage * 0.65f, impact);
+        }
+
+        DrucladMagmaPuddle.Spawn(impact, radius: 1.7f, lifetime: 2.8f, damagePerTick: damage * 0.18f);
+    }
+}
