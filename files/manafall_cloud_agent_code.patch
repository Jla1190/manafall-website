+            float uniform = RandomRange(rng, scaleMin, scaleMax);
+            Vector3 scale = Vector3.one * uniform;
+            Vector3 pos = new Vector3(wx, groundY + hover, wz);
+            if (!PassesSeparation(pos, treePositions, 18f))
+                continue;
+            if (!PassesSeparation(pos, rockPositions, 12f))
+                continue;
+
+            bool clearOfIslands = true;
+            for (int i = 0; i < results.Count; i++)
+            {
+                if (results[i].Type != FoliageSlotType.FloatingIsland)
+                    continue;
+                if ((results[i].WorldPosition - pos).sqrMagnitude < 40f * 40f)
+                {
