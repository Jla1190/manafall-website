+    private static void RecreatePrefab(
+        StringBuilder log,
+        RuntimeAnimatorController animator,
+        DrucladLootTable lootTable)
+    {
+        GameObject modelPrefab = AssetDatabase.LoadAssetAtPath<GameObject>(ModelPath);
+        if (modelPrefab == null)
+        {
+            log.AppendLine($"  ERROR: model missing at {ModelPath}");
+            return;
+        }
+
+        GameObject existing = AssetDatabase.LoadAssetAtPath<GameObject>(PrefabPath);
+        if (existing != null)
+        {
+            WireExistingPrefab(existing, animator, lootTable, log);
+            AssignNetworkAssetId(existing, NetworkAssetId, log);
+            MirrorResourcesCopy(log);
+            return;
+        }
+
+        GameObject instance = (GameObject)PrefabUtility.InstantiatePrefab(modelPrefab);
+        if (instance == null)
+        {
+            log.AppendLine("  ERROR: failed to instantiate Druclad model.");
+            return;
+        }
+
+        try
+        {
+            instance.name = "Druclad";
+            instance.transform.SetPositionAndRotation(Vector3.zero, Quaternion.identity);
+            instance.transform.localScale = Vector3.one * ModelScale;
+            WireRootComponents(instance, animator, lootTable, log);
+            GameObject saved = PrefabUtility.SaveAsPrefabAsset(instance, PrefabPath);
+            if (saved != null)
+            {
+                AssignNetworkAssetId(saved, NetworkAssetId, log);
+                log.AppendLine($"  Created {PrefabPath}");
+                MirrorResourcesCopy(log);
+            }
+        }
+        finally
+        {
+            Object.DestroyImmediate(instance);
+        }
+    }
