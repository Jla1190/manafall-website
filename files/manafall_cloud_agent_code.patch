diff --git a/Assets/Scripts/Creatures/Druclad/DrucladFireBreathVolume.cs b/Assets/Scripts/Creatures/Druclad/DrucladFireBreathVolume.cs
new file mode 100644
index 000000000..6d10f1663
--- /dev/null
+++ b/Assets/Scripts/Creatures/Druclad/DrucladFireBreathVolume.cs
@@ -0,0 +1,146 @@
+using System.Collections.Generic;
+using InventoryFramework;
+using UnityEngine;
+
+/// <summary>Server-side sustained inferno breath cone with tick damage + brief scorch patches.</summary>
+[DisallowMultipleComponent]
+public sealed class DrucladFireBreathVolume : MonoBehaviour
+{
+    [SerializeField] private float coneLength = 14f;
+    [SerializeField] private float coneHalfAngleDegrees = 28f;
+    [SerializeField] private float tickInterval = 0.22f;
+    [SerializeField] private float damagePerTick = 9f;
+    [SerializeField] private float burnDuration = 2.4f;
+    [SerializeField] private float scorchPatchLifetime = 1.6f;
+    [SerializeField] private LayerMask hitMask = ~0;
+
+    private readonly Collider[] overlap = new Collider[24];
+    private readonly Dictionary<int, float> nextTick = new Dictionary<int, float>(8);
+    private Transform muzzle;
+    private bool channeling;
+    private float channelUntil;
+    private DrucladController owner;
+
+    public bool IsChanneling => channeling && Time.time < channelUntil;
+    public float ConeLength => coneLength;
+    public float ConeHalfAngleDegrees => coneHalfAngleDegrees;
+
+    public void Bind(DrucladController controller, Transform breathMuzzle)
+    {
+        owner = controller;
+        muzzle = breathMuzzle != null ? breathMuzzle : transform;
+    }
+
+    public void BeginChannel(float durationSeconds, float damageMul = 1f)
+    {
+        channeling = true;
+        channelUntil = Time.time + Mathf.Max(0.35f, durationSeconds);
+        damagePerTick = Mathf.Max(4f, 9f * Mathf.Max(0.5f, damageMul));
+        nextTick.Clear();
+        DrucladFireFx.PlayCastBurst(ResolveOrigin(), ResolveForward(), 1.25f);
+    }
+
+    public void StopChannel()
+    {
+        channeling = false;
+        channelUntil = 0f;
+        nextTick.Clear();
+    }
+
+    public bool IsPointInCone(Vector3 worldPoint)
+    {
+        Vector3 origin = ResolveOrigin();
+        Vector3 fwd = ResolveForward();
+        Vector3 to = worldPoint - origin;
+        float dist = to.magnitude;
+        if (dist < 0.2f)
+            return true;
+        if (dist > coneLength)
+            return false;
+        return Vector3.Angle(fwd, to) <= coneHalfAngleDegrees;
+    }
+
+    private void LateUpdate()
+    {
+        if (!channeling)
+            return;
+
+        if (Time.time >= channelUntil)
+        {
+            StopChannel();
+            return;
+        }
+
+        Vector3 origin = ResolveOrigin();
+        Vector3 fwd = ResolveForward();
+        transform.SetPositionAndRotation(origin, Quaternion.LookRotation(fwd, Vector3.up));
+
+        int count = Physics.OverlapSphereNonAlloc(
+            origin + fwd * (coneLength * 0.45f),
+            coneLength * 0.55f,
+            overlap,
+            hitMask,
+            QueryTriggerInteraction.Collide);
+
+        float now = Time.time;
+        for (int i = 0; i < count; i++)
+        {
+            Collider col = overlap[i];
+            if (col == null || PlayerInteractionSphere.ShouldIgnoreEnemyCombatHit(col))
+                continue;
+
+            PlayerHealth player = col.GetComponentInParent<PlayerHealth>();
+            if (player == null || player.currentHealth <= 0.5f)
+                continue;
+
+            if (!IsPointInCone(player.transform.position + Vector3.up * 0.9f))
+                continue;
+
+            int id = player.GetInstanceID();
+            if (nextTick.TryGetValue(id, out float ready) && now < ready)
+                continue;
+
+            nextTick[id] = now + tickInterval;
+            Vector3 knock = Flatten(player.transform.position - origin).normalized * 2.4f + Vector3.up * 0.8f;
+            player.TakeDamage(damagePerTick, origin, knock);
+            SpellEffectCatalog.ApplyToPlayer(player, SpellEffectId.Burning, burnDuration);
+
+            Vector3 foot = player.transform.position;
+            if (Physics.Raycast(foot + Vector3.up * 1.2f, Vector3.down, out RaycastHit hit, 3f, hitMask))
+                foot = hit.point;
+            DrucladMagmaPuddle.Spawn(foot, radius: 1.1f, lifetime: scorchPatchLifetime, damagePerTick: damagePerTick * 0.45f);
+        }
+    }
+
+    private Vector3 ResolveOrigin()
+    {
+        if (muzzle != null)
+            return muzzle.position;
+        if (owner != null)
+            return owner.transform.position + Vector3.up * 2.4f + owner.transform.forward * 0.8f;
+        return transform.position;
+    }
+
+    private Vector3 ResolveForward()
+    {
+        if (muzzle != null && muzzle.forward.sqrMagnitude > 0.01f)
+        {
+            Vector3 f = muzzle.forward;
+            f.y = 0f;
+            if (f.sqrMagnitude > 0.01f)
+                return f.normalized;
+        }
+
+        if (owner != null)
+        {
+            Vector3 f = owner.transform.forward;
+            f.y = 0f;
+            if (f.sqrMagnitude > 0.01f)
+                return f.normalized;
+        }
+
+        return Vector3.forward;
+    }
+
+    private static Vector3 Flatten(Vector3 v) => new Vector3(v.x, 0f, v.z);
+}
