+using InventoryFramework;
+using UnityEngine;
+
+/// <summary>Lightweight homing-ish firebolt used by Druclad cinder / twin bolts.</summary>
+[DisallowMultipleComponent]
+public sealed class DrucladFireBoltProjectile : MonoBehaviour
+{
+    private Vector3 velocity;
+    private Transform homingTarget;
+    private float homingStrength;
+    private float damage;
+    private float lifeUntil;
+    private float knockPlanar;
+    private float knockVertical;
+    private bool authoritative;
+    private bool consumed;
+    private readonly Collider[] hits = new Collider[8];
+
+    public static DrucladFireBoltProjectile Spawn(
+        Vector3 origin,
+        Vector3 direction,
+        Transform target,
+        float speed,
+        float damage,
+        float lifeSeconds,
+        float homing,
+        float knockPlanar,
+        float knockVertical,
+        uint ownerNetId,
+        bool authoritative)
+    {
+        var go = new GameObject("DrucladFireBolt");
+        go.transform.SetPositionAndRotation(
+            origin,
+            Quaternion.LookRotation(direction.sqrMagnitude > 0.01f ? direction.normalized : Vector3.forward));
+
+        var bolt = go.AddComponent<DrucladFireBoltProjectile>();
+        bolt.velocity = direction.normalized * Mathf.Max(4f, speed);
+        bolt.homingTarget = target;
+        bolt.homingStrength = Mathf.Clamp01(homing);
+        bolt.damage = Mathf.Max(1f, damage);
+        bolt.lifeUntil = Time.time + Mathf.Clamp(lifeSeconds, 0.4f, 6f);
+        bolt.knockPlanar = knockPlanar;
+        bolt.knockVertical = knockVertical;
+        bolt.authoritative = authoritative;
+        _ = ownerNetId;
+
+        var sphere = go.AddComponent<SphereCollider>();
+        sphere.isTrigger = true;
+        sphere.radius = 0.28f;
+
+        var rb = go.AddComponent<Rigidbody>();
+        rb.isKinematic = true;
+        rb.useGravity = false;
+
+        DrucladFireFx.AttachBoltVisual(go.transform, 0.9f);
+        DrucladFireFx.PlayCastBurst(origin, direction, 0.75f);
+        Object.Destroy(go, Mathf.Clamp(lifeSeconds, 0.5f, 6.5f) + 0.25f);
+        return bolt;
+    }
+
+    private void Update()
+    {
+        if (consumed)
+            return;
+
+        if (Time.time >= lifeUntil)
+        {
+            Destroy(gameObject);
+            return;
+        }
+
+        if (homingTarget != null && homingStrength > 0.01f)
+        {
+            Vector3 to = homingTarget.position + Vector3.up * 1.1f - transform.position;
+            if (to.sqrMagnitude > 0.01f)
+            {
+                Vector3 desired = to.normalized * velocity.magnitude;
+                velocity = Vector3.Lerp(velocity, desired, homingStrength * Time.deltaTime * 4.5f);
+            }
+        }
+
+        Vector3 next = transform.position + velocity * Time.deltaTime;
+        if (velocity.sqrMagnitude > 0.01f)
+            transform.rotation = Quaternion.LookRotation(velocity.normalized, Vector3.up);
+        transform.position = next;
+
+        if (!authoritative)
+            return;
+
+        int count = Physics.OverlapSphereNonAlloc(transform.position, 0.4f, hits, ~0, QueryTriggerInteraction.Collide);
+        for (int i = 0; i < count; i++)
+        {
+            Collider col = hits[i];
+            if (col == null || PlayerInteractionSphere.ShouldIgnoreEnemyCombatHit(col))
+                continue;
+
+            if (col.GetComponentInParent<DrucladController>() != null)
+                continue;
+
+            PlayerHealth player = col.GetComponentInParent<PlayerHealth>();
+            if (player != null && player.currentHealth > 0.5f)
+            {
+                ApplyHit(player);
+                return;
+            }
+
+            Health creature = CreatureMeleeHurtbox.ResolveHealth(col);
+            if (creature != null && !creature.IsDead)
+            {
+                creature.TakeDamage(damage, transform.position);
+                Explode();
+                return;
+            }
+        }
+    }
+
+    private void ApplyHit(PlayerHealth player)
+    {
+        Vector3 away = player.transform.position - transform.position;
+        away.y = 0f;
+        if (away.sqrMagnitude < 0.01f)
+            away = transform.forward;
+        away.Normalize();
+        Vector3 knock = away * knockPlanar + Vector3.up * knockVertical;
+        player.TakeDamage(damage, transform.position, knock);
+        SpellEffectCatalog.ApplyToPlayer(player, SpellEffectId.Burning, 2.2f);
+        Explode();
+    }
+
+    private void Explode()
+    {
+        if (consumed)
+            return;
+        consumed = true;
+        DrucladFireFx.PlayImpact(transform.position, -transform.forward, 0.95f);
+        Destroy(gameObject);
+    }
+}
