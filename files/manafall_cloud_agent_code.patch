+    float f2 = MF_CausticFilament(ph2 * 0.1591549, 10.0);
+    float f3 = MF_CausticFilament(ph3 * 0.1591549, 9.5);
+    float f4 = MF_CausticFilament(ph4 * 0.1591549, 12.0) * 0.5;
+    float f5 = MF_CausticFilament(ph5 * 0.1591549, 12.0) * 0.5;
