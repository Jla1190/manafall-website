@@ -0,0 +1,46 @@
+using Mirror;
+using UnityEngine;
+
+/// <summary>
+/// Slow server/offline tick that rolls swamp-weighted ambient disease contraction.
+/// </summary>
+[DisallowMultipleComponent]
+public sealed class DiseaseAmbientDriver : MonoBehaviour
+{
+    private const float IntervalSeconds = 18f;
+
+    private float nextTickAt;
+
+    public static DiseaseAmbientDriver EnsureOn(GameObject player)
+    {
+        if (player == null)
+            return null;
+
+        DiseaseAmbientDriver existing = player.GetComponent<DiseaseAmbientDriver>()
+            ?? player.GetComponentInChildren<DiseaseAmbientDriver>(true);
+        return existing != null ? existing : player.AddComponent<DiseaseAmbientDriver>();
+    }
+
+    private void OnEnable()
+    {
+        nextTickAt = Time.time + Random.Range(4f, IntervalSeconds);
+    }
+
+    private void Update()
+    {
+        if (!HasAuthority())
+            return;
+
+        if (Time.time < nextTickAt)
+            return;
+
+        nextTickAt = Time.time + IntervalSeconds;
+        DiseaseInfectionService.ServerTryAmbientTick(gameObject);
+    }
+
+    private bool HasAuthority()
+    {
+        return NetworkServer.active
+            || (!NetworkClient.active && OfflinePlayMode.IsActive(true));
+    }
+}
