@@ -0,0 +1,39 @@
+using UnityEngine;
+
+/// <summary>
+/// Spatial gravity from the void biome. Core void is ~1/3 normal; borders blend gradually.
+/// Character motors call <see cref="Scale"/>; Rigidbodies are corrected by
+/// <see cref="BiomeGravityWorldDriver"/>.
+/// </summary>
+public static class BiomeGravity
+{
+    private static readonly BiomeSettings FallbackSettings = new BiomeSettings();
+
+    public static float SampleMultiplier(Vector3 worldPosition)
+    {
+        WorldGenerator world = ManafallWorldBinding.FindWorldGenerator();
+        BiomeSettings settings = world != null ? world.BiomeSettings : FallbackSettings;
+        int seed = world != null ? world.TerrainSeed : 0;
+        return BiomeClimateSampler.SampleGravityMultiplier(worldPosition.x, worldPosition.z, seed, settings);
+    }
+
+    public static float SampleMultiplier(float worldX, float worldZ)
+    {
+        WorldGenerator world = ManafallWorldBinding.FindWorldGenerator();
+        BiomeSettings settings = world != null ? world.BiomeSettings : FallbackSettings;
+        int seed = world != null ? world.TerrainSeed : 0;
+        return BiomeClimateSampler.SampleGravityMultiplier(worldX, worldZ, seed, settings);
+    }
+
+    /// <summary>Scales a character-motor gravity accel (usually negative) by the local biome field.</summary>
+    public static float Scale(float gravityAccel, Vector3 worldPosition)
+    {
+        return gravityAccel * SampleMultiplier(worldPosition);
+    }
+
+    /// <summary>World gravity acceleration at a point (same direction as <see cref="Physics.gravity"/>).</summary>
+    public static Vector3 GetAcceleration(Vector3 worldPosition)
+    {
+        return Physics.gravity * SampleMultiplier(worldPosition);
+    }
+}
