+using InventoryFramework;
+using UnityEngine;
+
+/// <summary>Thin wrappers over SpellFocus / volcano / troll slam FX for Druclad combat beats.</summary>
+public static class DrucladFireFx
+{
+    private static readonly SpellFocusVfxProfile DefaultProfile = new SpellFocusVfxProfile(
+        scale: 1.15f,
+        diameter: 0.55f,
+        trailTime: 0.35f,
+        trailStartWidth: 0.28f,
+        trailEndWidth: 0.04f,
+        castIntensity: 1.1f,
+        impactIntensity: 1.2f,
+        orbPulseSpeed: 1.4f);
+
+    public static void PlayCastBurst(Vector3 origin, Vector3 direction, float scale = 1.1f)
+    {
+        Vector3 fwd = direction.sqrMagnitude > 0.01f ? direction.normalized : Vector3.forward;
+        SpellFocusVefectsBridge.PlayFireCast(origin, Quaternion.LookRotation(fwd), scale);
+        SpellFocusFireVfx.TryPlayCast(
+            origin,
+            fwd,
+            EnchantAspect.FireballFocus,
+            DefaultProfile,
+            powerLevel: 28);
+    }
+
+    public static void PlayImpact(Vector3 point, Vector3 normal, float scale = 1.2f)
+    {
+        Vector3 up = normal.sqrMagnitude > 0.01f ? normal.normalized : Vector3.up;
+        Quaternion rot = Quaternion.LookRotation(Vector3.Cross(up, Vector3.right).normalized, up);
+        SpellFocusVefectsBridge.PlayFireImpact(point, rot, scale);
+        SpellFocusFireVfx.TryPlayImpact(
+            point,
+            up,
+            EnchantAspect.FireballFocus,
+            DefaultProfile,
+            powerLevel: 30);
+    }
+
+    public static void PlayGroundSlam(Vector3 groundPoint, float strength = 1.6f)
+    {
+        TrollGroundSlamFx.Play(groundPoint, strength);
+        PlayImpact(groundPoint + Vector3.up * 0.05f, Vector3.up, 0.85f + strength * 0.25f);
+        SpellFocusVefectsBridge.PlaySmolderingGroundRing(
+            groundPoint,
+            Vector3.up,
+            radius: 1.4f + strength * 0.55f,
+            duration: 2.4f,
+            patchScale: 0.9f + strength * 0.2f);
+    }
+
+    public static void PlayMeteorImpact(Vector3 point, float scale = 1.35f)
+    {
+        PlayImpact(point, Vector3.up, scale);
+        SpellFocusFireVfx.TryPlayPierceImpact(point, Vector3.up, DefaultProfile, powerLevel: 34);
+        SpellFocusVefectsBridge.PlaySmolderingGroundRing(
+            point,
+            Vector3.up,
+            radius: 2.1f * scale,
+            duration: 3.2f,
+            patchScale: 1.15f * scale);
+    }
+
+    public static void PlayAwakenCrack(Vector3 groundPoint)
+    {
+        PlayGroundSlam(groundPoint, 1.85f);
+        SpellFocusVefectsBridge.PlayFireCast(
+            groundPoint + Vector3.up * 0.4f,
+            Quaternion.LookRotation(Vector3.up),
+            1.45f);
+    }
+
+    public static void AttachBoltVisual(Transform root, float scale = 0.85f)
+    {
+        if (root == null)
+            return;
+        SpellFocusVefectsBridge.AttachFireBolt(root, scale, EnchantAspect.FireballFocus, powerLevel: 26);
+    }
+}
