@@ -0,0 +1,103 @@
+using System.Collections.Generic;
+using UnityEngine;
+#if UNITY_EDITOR
+using UnityEditor;
+#endif
+
+/// <summary>
+/// Resolves the Meshy Floating Meadow Cliff model for the void biome.
+/// Andrews floating island remains a last-resort editor fallback only.
+/// </summary>
+public static class VoidFloatingIslandWorldSpawner
+{
+    public const string MeshyFolderName = "Meshy_AI_Floating_Meadow_Cliff_1019132410_texture_fbx";
+    public const string MeshyFbxAssetPath =
+        "Assets/ThirdParty/DownloadedAssets/Meshy_AI_Floating_Meadow_Cliff_1019132410_texture_fbx/"
+        + "Meshy_AI_Floating_Meadow_Cliff_1019132410_texture_fbx/"
+        + "Meshy_AI_Floating_Meadow_Cliff_1019132410_texture.fbx";
+    public const string MeshyFbxFlatAssetPath =
+        "Assets/ThirdParty/DownloadedAssets/Meshy_AI_Floating_Meadow_Cliff_1019132410_texture_fbx/"
+        + "Meshy_AI_Floating_Meadow_Cliff_1019132410_texture.fbx";
+    public const string MeshyMaterialAssetPath =
+        "Assets/ThirdParty/DownloadedAssets/Meshy_AI_Floating_Meadow_Cliff_1019132410_texture_fbx/"
+        + "Meshy_AI_Floating_Meadow_Cliff_1019132410_texture_fbx/Materials/"
+        + "Meshy_AI_Floating_Meadow_Cliff_1019132410_texture.mat";
+    public const string AndrewsIslandAssetPath =
+        "Assets/ThirdParty/DownloadedAssets/andrews-floating-island-unity-v2/source/"
+        + "Andrews_Floating_Island_Unity/Andrews_Island_Unity_2.obj";
+
+    private static GameObject s_cachedFallback;
+    private static bool s_resolved;
+
+    public static GameObject ResolvePrefabFallback()
+    {
+        if (s_resolved)
+            return s_cachedFallback;
+
+        s_resolved = true;
+        s_cachedFallback = TryLoadMeshyOrAndrews();
+        return s_cachedFallback;
+    }
+
+    public static void InvalidateCache()
+    {
+        s_resolved = false;
+        s_cachedFallback = null;
+    }
+
+#if UNITY_EDITOR
+    [InitializeOnLoadMethod]
+    private static void EditorReset() => InvalidateCache();
+#endif
+
+    private static GameObject TryLoadMeshyOrAndrews()
+    {
+#if UNITY_EDITOR
+        GameObject meshy = AssetDatabase.LoadAssetAtPath<GameObject>(MeshyFbxAssetPath);
+        if (meshy == null)
+            meshy = AssetDatabase.LoadAssetAtPath<GameObject>(MeshyFbxFlatAssetPath);
+        if (meshy != null)
+            return meshy;
+
+        GameObject andrews = AssetDatabase.LoadAssetAtPath<GameObject>(AndrewsIslandAssetPath);
+        if (andrews != null)
+            return andrews;
+#endif
+
+        // Runtime Resources path (optional copy of the prefab).
+        GameObject fromResources = Resources.Load<GameObject>("VoidFloatingIsland");
+        if (fromResources != null)
+            return fromResources;
+
+        return null;
+    }
+
+    /// <summary>
+    /// Editor helper: assign the Meshy (or Andrews) model onto FoliageSettings.
+    /// </summary>
+    public static bool TryAssignToFoliageSettings(FoliageSettings settings)
+    {
+        if (settings == null)
+            return false;
+
+        GameObject prefab = ResolvePrefabFallback();
+        if (prefab == null)
+            return false;
+
+        settings.voidFloatingIslandPrefab = prefab;
+#if UNITY_EDITOR
+        Material mat = AssetDatabase.LoadAssetAtPath<Material>(MeshyMaterialAssetPath);
+        if (mat != null)
+            settings.voidFloatingIslandMaterial = mat;
+#endif
+        return true;
+    }
+
+    public static IEnumerable<string> ExpectedAssetPaths()
+    {
+        yield return MeshyFbxAssetPath;
+        yield return MeshyFbxFlatAssetPath;
+        yield return MeshyMaterialAssetPath;
+        yield return AndrewsIslandAssetPath;
+    }
+}
