+/// <summary>Unique mechanical symptom applied while a disease is active.</summary>
+public enum DiseaseSymptomKind : byte
+{
+    None = 0,
+    /// <summary>Pale HP bar + slow DoT (Rawcap Gut).</summary>
+    PaleDot = 1,
+    /// <summary>Stamina regen cut (Marsh Cough).</summary>
+    StaminaRegenCut = 2,
+    /// <summary>Scratch DoT while wet (Frogitch).</summary>
+    WetScratchDot = 3,
+    /// <summary>Periodic fever DoT (Wound Fever).</summary>
+    FeverDot = 4,
+    /// <summary>Move speed reduction (Mirefoot).</summary>
+    MoveSlow = 5,
+    /// <summary>Hunger drains faster (Blackwater Belly).</summary>
+    HungerDrain = 6,
+    /// <summary>Incoming heals reduced (Leechblood).</summary>
+    HealTakenCut = 7,
+    /// <summary>Extra cold vulnerability (Bone Chill Ague).</summary>
+    ColdVulnerability = 8,
+    /// <summary>Strong DoT + soft max HP cut (Swamp Rot).</summary>
+    RotDotMaxHp = 9,
+    /// <summary>Incoming damage increased (Redscale Pox).</summary>
+    DamageTakenUp = 10,
+    /// <summary>Periodic stamina spike drain (Grave Damp).</summary>
+    StaminaSpikeDrain = 11,
+    /// <summary>Sprint stamina cost spike (Hollow Lung).</summary>
+    SprintCostSpike = 12,
+}
